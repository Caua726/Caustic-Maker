use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;
// Only for os.current(), which folds to a literal at compile time — the path
// helpers below have to know whether a drive letter roots a path.
use "../../std/os.cst" as os;

// === Shared heap ===
// One bins allocator for the whole maker. Previously each of main/parser/
// executor span up its own 1 MiB pool; a single shared pool is simpler and
// lighter. All alloc/free across the maker route through galloc/gfree.
let is mem.bins.Bins as _heap with mut;
let is i32 as _heap_ready with mut = 0;

fn _heap_init() as void {
    if (_heap_ready == 0) {
        _heap = mem.bins.bins_new(1048576);
        _heap_ready = 1;
    }
}

fn galloc(size as i64) as *u8 {
    _heap_init();
    return mem.bins.bins_alloc(&_heap, size);
}

fn gfree(ptr as *u8) as void {
    if (_heap_ready == 1) { mem.bins.bins_free(&_heap, ptr); }
}

// === Large blocks (growable tables) ===
// bins caps a single allocation at 64 KiB, so anything whose size follows the
// Causticfile (the target/script tables, a whole source buffer) cannot live
// there — a project with a few hundred targets would get a null back. Those
// come straight from the page allocator, which is what makes the tables
// unbounded: no MAX_TARGETS, no MAX_SCRIPTS, no MAX_CMDS.

fn big_alloc(size as i64) as *u8 {
    let is *u8 as p = mem.core.mmap_anon(size);
    if (cast(i64, p) == 0) {
        eprint("error: out of memory (");
        eprint(u64_to_str(size));
        eprint(" bytes)\n");
        io.exit(1);
    }
    return p;
}

fn big_free(ptr as *u8, size as i64) as void {
    if (cast(i64, ptr) != 0 && size > 0) { mem.core.munmap(ptr, size); }
}

// Reallocate a table: fresh mapping, copy the live prefix, release the old one.
// Callers must not hold interior pointers across this (the parser only grows
// a table before it hands out an element pointer).
fn big_grow(old as *u8, old_size as i64, new_size as i64) as *u8 {
    let is *u8 as nb = big_alloc(new_size);
    if (cast(i64, old) != 0 && old_size > 0) {
        mem.memcpy(nb, old, old_size);
        big_free(old, old_size);
    }
    return nb;
}

// === String helpers ===

fn strlen(s as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

fn print(s as *u8) as void {
    io._write_fd(io.STDOUT, s, strlen(s));
}

fn eprint(s as *u8) as void {
    io._write_fd(io.STDERR, s, strlen(s));
}

fn write_nl(fd as i64) as void {
    io._write_fd(fd, "\n", 1);
}

fn write_quote(fd as i64) as void {
    io._write_fd(fd, "\"", 1);
}

// Compare a (length-bounded) string against a null-terminated literal.
fn streq_lit(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] != 0) { return 0; }
    return 1;
}

// Compare a token (a, a_len) against a null-terminated literal b.
fn streq(a as *u8, a_len as i32, b as *u8) as i32 {
    let is i64 as b_len = strlen(b);
    if (cast(i64, a_len) != b_len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < b_len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Compare two explicit (ptr, len) strings.
fn streq_n(a as *u8, a_len as i64, b as *u8, b_len as i32) as i32 {
    if (a_len != cast(i64, b_len)) { return 0; }
    let is i64 as i with mut = 0;
    while (i < a_len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// copy n bytes from src into a new null-terminated string
fn str_dup(src as *u8, n as i32) as *u8 {
    let is *u8 as buf = galloc(cast(i64, n) + 1);
    mem.memcpy(buf, src, cast(i64, n));
    buf[n] = 0;
    return buf;
}

// concat two null-terminated strings
fn str_cat(a as *u8, b as *u8) as *u8 {
    let is i64 as a_len = strlen(a);
    let is i64 as b_len = strlen(b);
    let is *u8 as buf = galloc(a_len + b_len + 1);
    mem.memcpy(buf, a, a_len);
    mem.memcpy(cast(*u8, cast(i64, buf) + a_len), b, b_len);
    buf[a_len + b_len] = 0;
    return buf;
}

fn str_cat4(a as *u8, b as *u8, c as *u8, d as *u8) as *u8 {
    return str_cat(str_cat3(a, b, c), d);
}

fn str_cat3(a as *u8, b as *u8, c as *u8) as *u8 {
    let is i64 as a_len = strlen(a);
    let is i64 as b_len = strlen(b);
    let is i64 as c_len = strlen(c);
    let is i64 as total = a_len + b_len + c_len;
    let is *u8 as buf = galloc(total + 1);
    mem.memcpy(buf, a, a_len);
    mem.memcpy(cast(*u8, cast(i64, buf) + a_len), b, b_len);
    mem.memcpy(cast(*u8, cast(i64, buf) + a_len + b_len), c, c_len);
    buf[total] = 0;
    return buf;
}

// Index of the first occurrence of `needle` in `s`, or -1.
fn str_find(s as *u8, needle as *u8) as i64 {
    let is i64 as sl = strlen(s);
    let is i64 as nl = strlen(needle);
    if (nl == 0) { return 0; }
    if (nl > sl) { return 0 - 1; }
    let is i64 as i with mut = 0;
    while (i <= sl - nl) {
        let is i64 as j with mut = 0;
        while (j < nl && s[i + j] == needle[j]) { j = j + 1; }
        if (j == nl) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn contains(s as *u8, needle as *u8) as i32 {
    if (str_find(s, needle) >= 0) { return 1; }
    return 0;
}

// Extract the whole whitespace-delimited token that starts with `prefix`
// (e.g. "--target=" -> "--target=windows-x86_64"). Null if absent. Used to
// forward a flag the user put in `flags` to the separate assemble/link steps.
fn extract_flag(flags as *u8, prefix as *u8) as *u8 {
    let is i64 as at = str_find(flags, prefix);
    if (at < 0) { return cast(*u8, 0); }
    let is i64 as end with mut = at;
    let is i64 as fl = strlen(flags);
    while (end < fl && flags[end] != 32 && flags[end] != 9) { end = end + 1; }
    return str_dup(cast(*u8, cast(i64, flags) + at), cast(i32, end - at));
}

// Wrap (ptr,len) in POSIX-sh single quotes, escaping embedded quotes the only
// way sh allows: '\''. Used for the `env` prologue so a declared value with
// spaces or $ in it reaches the child verbatim.
fn sh_quote_n(s as *u8, n as i32) as *u8 {
    let is i64 as len = cast(i64, n);
    let is i64 as quotes with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) {
        if (s[i] == 39) { quotes = quotes + 1; }
        i = i + 1;
    }
    // ' + body (each ' becomes 4 chars) + ' + NUL
    let is *u8 as out = galloc(len + quotes * 3 + 3);
    let is i64 as o with mut = 0;
    out[o] = cast(u8, 39); o = o + 1;
    i = 0;
    while (i < len) {
        if (s[i] == 39) {
            out[o] = cast(u8, 39); o = o + 1;      // close
            out[o] = cast(u8, 92); o = o + 1;      // backslash
            out[o] = cast(u8, 39); o = o + 1;      // literal '
            out[o] = cast(u8, 39); o = o + 1;      // reopen
        } else {
            out[o] = s[i]; o = o + 1;
        }
        i = i + 1;
    }
    out[o] = cast(u8, 39); o = o + 1;
    out[o] = cast(u8, 0);
    return out;
}

fn sh_quote(s as *u8) as *u8 {
    return sh_quote_n(s, cast(i32, strlen(s)));
}

fn ends_with(s as *u8, suffix as *u8) as i32 {
    let is i64 as sl = strlen(s);
    let is i64 as fl = strlen(suffix);
    if (fl > sl) { return 0; }
    let is i64 as i with mut = 0;
    while (i < fl) {
        if (s[sl - fl + i] != suffix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn starts_with(s as *u8, prefix as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Lexicographic compare: <0, 0, >0. Used to order glob matches so the object
// list handed to the linker is deterministic.
fn str_cmp(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, a[i]) - cast(i32, b[i]);
}

// === Paths ===

// Everything before the last '/' ("a/b/c.cst" -> "a/b"), or "" when the path
// has no directory part. Accepts '\' too, so a Windows-style path works.
fn path_dirname(path as *u8) as *u8 {
    let is i64 as len = strlen(path);
    let is i64 as cut with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < len) {
        if (path[i] == 47 || path[i] == 92) { cut = i; }
        i = i + 1;
    }
    if (cut < 0) { return str_dup("", 0); }
    return str_dup(path, cast(i32, cut));
}

// Is this path absolute? Split in two so both answers are reachable — and
// therefore testable — from either host, with one OS-aware dispatcher on top.
//
// It matters that these disagree: on Linux `C:\x` is an ordinary relative file
// name and prefixing it with the cwd is correct; on Windows the same string is
// rooted and prefixing it produces a path that cannot exist.

fn path_is_absolute_posix(p as *u8) as i32 {
    if (p[0] == 47) { return 1; }                       // '/'
    return 0;
}

fn path_is_absolute_win(p as *u8) as i32 {
    if (p[0] == 47 || p[0] == 92) { return 1; }         // '/' or '\' — root of the current drive
    // A drive-qualified path is absolute only with a separator after the colon:
    // "C:\x" and "C:/x" are, bare "C:" and drive-relative "C:x" are not.
    if (p[0] == 0 || p[1] != 58) { return 0; }          // ':'
    if (p[2] != 47 && p[2] != 92) { return 0; }
    if (p[0] >= 65 && p[0] <= 90) { return 1; }         // 'A'..'Z'
    if (p[0] >= 97 && p[0] <= 122) { return 1; }        // 'a'..'z'
    return 0;
}

fn path_is_absolute(p as *u8) as i32 {
    if (os.current() == os.OS_WINDOWS) { return path_is_absolute_win(p); }
    return path_is_absolute_posix(p);
}

// Join two path fragments with a single '/'. An empty or absolute `b` wins.
fn path_join(a as *u8, b as *u8) as *u8 {
    if (strlen(a) == 0) { return str_cat("", b); }
    if (strlen(b) == 0) { return str_cat("", a); }
    if (path_is_absolute(b) == 1) { return str_cat("", b); }
    if (ends_with(a, "/") == 1 || ends_with(a, "\\") == 1) { return str_cat(a, b); }
    return str_cat3(a, "/", b);
}

// === Hashing ===

fn hash_str(s as *u8) as i64 {
    return djb2(s, strlen(s));
}

// Fold two hashes into one. Used to key a cached object on more than its
// content (path + flags + compiler), so distinct build inputs never collide.
fn hash_mix(a as i64, b as i64) as i64 {
    let is i64 as h with mut = a ^ (b + cast(i64, 2654435769));
    h = h ^ (h >> 29);
    h = h * 5;
    return h & cast(i64, 4611686018427387903);
}

// === File helpers ===

fn read_file(path as *u8) as *u8 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as size = io._lseek(fd, 0, io._SEEK_END);
    io._lseek(fd, 0, io._SEEK_SET);
    if (size <= 0) {
        io._close_fd(fd);
        return cast(*u8, 0);
    }
    // Page-allocated, not galloc: a whole-file buffer has no upper bound, and
    // bins would return null past 64 KiB. The buffer lives for the whole run
    // (token pointers alias into it), so it is never freed.
    let is *u8 as buf = big_alloc(size + 1);
    io._read_fd(fd, buf, size);
    buf[size] = 0;
    io._close_fd(fd);
    return buf;
}

fn read_file_size(path as *u8) as i64 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as size = io._lseek(fd, 0, io._SEEK_END);
    io._close_fd(fd);
    return size;
}

// Read a small (<512B) file into a freshly-allocated buffer; sets *out_len.
fn read_small_file(path as *u8, out_len as *i64) as *u8 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { *out_len = 0; return cast(*u8, 0); }
    let is *u8 as buf = galloc(512);
    let is i64 as n with mut = io._read_fd(fd, buf, 511);
    io._close_fd(fd);
    if (n < 0) { n = 0; }
    buf[n] = 0;
    *out_len = n;
    return buf;
}

fn write_small_file(path as *u8, data as *u8, data_len as i32) as void {
    let is i64 as fd = io._open_write(path);
    if (fd < 0) { return; }
    io._write_fd(fd, data, cast(i64, data_len));
    io._close_fd(fd);
}

// Write only when the contents would actually differ. Returns 1 if it wrote.
// Leaving an identical file untouched keeps its mtime, which matters because
// every generated file is an input to the up-to-date check — rewriting it byte
// for byte would invalidate the target on every single build.
//
// The comparison reads the WHOLE file. It used to go through read_small_file,
// which reads at most 511 bytes: for anything larger the lengths could never
// match, so the function rewrote every time and defeated the one thing it is
// for. Only `version_file` uses it today (43 bytes), so the damage was latent —
// but it is the same truncated-read bug that was removed from deps.cst.
fn write_if_changed(path as *u8, data as *u8, data_len as i32) as i32 {
    if (io.exists(path) == 1) {
        let is i64 as old_len = read_file_size(path);
        if (old_len == cast(i64, data_len)) {
            if (data_len == 0) { return 0; }        // both empty: nothing to do
            let is *u8 as old = read_file(path);
            if (cast(i64, old) != 0) {
                let is i32 as same = streq_n(old, old_len, data, data_len);
                big_free(old, old_len + 1);
                if (same == 1) { return 0; }
            }
        }
    }
    write_small_file(path, data, data_len);
    return 1;
}

// === Numbers ===

// Parse a decimal integer, strictly: the whole string must be digits, and there
// must be at least one. Returns 1 on success and writes *out, 0 on rejection.
//
// The lax version this replaces stopped at the first non-digit and returned
// whatever it had, so `-j abc` parsed as 0 and silently meant "auto-detect" —
// the same silent-acceptance bug as the ignored unknown flag.
fn parse_int_strict(s as *u8, out as *i64) as i32 {
    if (s[0] == 0) { return 0; }
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (s[i] != 0) {
        if (s[i] < 48 || s[i] > 57) { return 0; }
        v = v * 10 + (cast(i64, s[i]) - 48);
        i = i + 1;
    }
    *out = v;
    return 1;
}

// === Globs ===
// One wildcard-bearing component, at the end of the path: `kernel/*.s`,
// `tests/t?.cst`. Enough for the "every .s in this directory" case a
// hand-written build script expresses with a shell glob, without dragging in a
// recursive matcher nobody asked for.

fn has_glob(s as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (s[i] != 0) {
        if (s[i] == 42 || s[i] == 63) { return 1; }   // '*' '?'
        i = i + 1;
    }
    return 0;
}

// Classic iterative backtracking matcher: '*' spans any run of characters,
// '?' exactly one. Both stay inside a single path component (the caller only
// ever hands us a basename).
fn glob_match(pat as *u8, name as *u8) as i32 {
    let is i64 as pl = strlen(pat);
    let is i64 as nl = strlen(name);
    let is i64 as pi with mut = 0;
    let is i64 as ni with mut = 0;
    let is i64 as star with mut = 0 - 1;
    let is i64 as mark with mut = 0;
    while (ni < nl) {
        if (pi < pl && (pat[pi] == 63 || pat[pi] == name[ni])) {
            pi = pi + 1;
            ni = ni + 1;
        } else if (pi < pl && pat[pi] == 42) {
            star = pi;
            pi = pi + 1;
            mark = ni;
        } else if (star >= 0) {
            pi = star + 1;
            mark = mark + 1;
            ni = mark;
        } else {
            return 0;
        }
    }
    while (pi < pl && pat[pi] == 42) { pi = pi + 1; }
    if (pi == pl) { return 1; }
    return 0;
}

// Results of the last glob_expand(), consumed via glob_get(). One table reused
// per call — the callers (parser key handlers) drain it immediately.
let is *u8 as _glob_ptrs with mut;      // *i64 array of *u8
let is i32 as _glob_count with mut = 0;
let is i32 as _glob_cap with mut = 0;

fn _glob_push(p as *u8) as void {
    if (_glob_count >= _glob_cap) {
        let is i32 as newcap with mut = _glob_cap * 2;
        if (newcap < 16) { newcap = 16; }
        _glob_ptrs = big_grow(_glob_ptrs, cast(i64, _glob_cap) * 8, cast(i64, newcap) * 8);
        _glob_cap = newcap;
    }
    let is *i64 as arr = cast(*i64, _glob_ptrs);
    arr[_glob_count] = cast(i64, p);
    _glob_count = _glob_count + 1;
}

fn glob_get(idx as i32) as *u8 {
    let is *i64 as arr = cast(*i64, _glob_ptrs);
    return cast(*u8, arr[idx]);
}

// Expand `pattern` into the module table.
//
// Returns the number of matches, 0 when the pattern matched nothing, and **-1
// when the directory could not be listed at all** — a missing directory, or any
// Windows host, where std/io.list_dir has no backend and returns -1. Collapsing
// that into 0 made every Windows glob fail with "pattern matched nothing",
// which sends you looking at your own file names instead of at the missing
// capability.
//
// A pattern with no wildcard yields itself (existence is the caller's business,
// so a plain path behaves exactly as before). Matches come out sorted so the
// link order of `asm "dir/*.s"` is stable across machines.
fn glob_expand(pattern as *u8) as i32 {
    _glob_count = 0;
    if (has_glob(pattern) == 0) {
        _glob_push(str_cat("", pattern));
        return 1;
    }
    let is *u8 as dir = path_dirname(pattern);
    let is *u8 as base with mut = cast(*u8, cast(i64, pattern) + strlen(dir));
    if (base[0] == 47 || base[0] == 92) { base = cast(*u8, cast(i64, base) + 1); }
    let is *u8 as listdir with mut = dir;
    if (strlen(listdir) == 0) { listdir = "."; }

    // Grow-and-retry: a directory bigger than the buffer would otherwise be
    // silently truncated, which is exactly the class of bug the fixed tables
    // used to cause.
    let is i32 as cap with mut = 512;
    let is i32 as n with mut = 0;
    let is *u8 as ents with mut = cast(*u8, 0);
    let is i64 as ents_size with mut = 0;
    while (1 == 1) {
        ents_size = cast(i64, cap) * sizeof(io.DirEntry);
        ents = big_alloc(ents_size);
        n = io.list_dir(listdir, cast(*io.DirEntry, ents), cap);
        if (n < cap) { break; }
        big_free(ents, ents_size);
        cap = cap * 2;
    }
    if (n < 0) {
        big_free(ents, ents_size);
        return cast(i32, 0 - 1);            // could not list the directory
    }

    let is i32 as i with mut = 0;
    while (i < n) {
        let is *io.DirEntry as e = cast(*io.DirEntry, cast(i64, ents) + cast(i64, i) * sizeof(io.DirEntry));
        let is *u8 as nm = str_dup(e.name_ptr, cast(i32, e.name_len));
        if (glob_match(base, nm) == 1) { _glob_push(path_join(dir, nm)); }
        i = i + 1;
    }
    // The names were copied out above, so the entry table can go. It used to be
    // leaked on this path — only the retry branch freed it.
    big_free(ents, ents_size);

    // insertion sort by full path
    let is *i64 as arr = cast(*i64, _glob_ptrs);
    let is i32 as a with mut = 1;
    while (a < _glob_count) {
        let is i64 as key = arr[a];
        let is i32 as b with mut = a - 1;
        while (b >= 0 && str_cmp(cast(*u8, arr[b]), cast(*u8, key)) > 0) {
            arr[b + 1] = arr[b];
            b = b - 1;
        }
        arr[b + 1] = key;
        a = a + 1;
    }
    return _glob_count;
}

// djb2 content hash — used to key per-module object cache entries.
fn djb2(s as *u8, len as i64) as i64 {
    let is i64 as h with mut = 5381;
    let is i64 as i with mut = 0;
    while (i < len) {
        h = ((h << 5) + h) + cast(i64, s[i]);
        i = i + 1;
    }
    return h & cast(i64, 4611686018427387903);   // keep positive
}

// djb2 over a file's contents, streamed through a stack buffer so large
// modules (>64 KiB) don't blow the bins allocator's max-bin limit. Returns 0
// if the file can't be opened. Bit-identical to djb2(read_file(path), size).
fn hash_file(path as *u8) as i64 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as h with mut = 5381;
    let is [8192]u8 as buf;
    let is i64 as n with mut = io._read_fd(fd, cast(*u8, &buf), 8192);
    while (n > 0) {
        let is i64 as i with mut = 0;
        while (i < n) {
            h = ((h << 5) + h) + cast(i64, buf[i]);
            i = i + 1;
        }
        n = io._read_fd(fd, cast(*u8, &buf), 8192);
    }
    io._close_fd(fd);
    return h & cast(i64, 4611686018427387903);
}

// Unsigned i64 -> decimal string (heap). For cache filenames.
fn u64_to_str(n as i64) as *u8 {
    let is [24]u8 as buf;
    let is i32 as pos with mut = 23;
    let is i64 as v with mut = n;
    if (v == 0) { buf[pos] = 48; pos = pos - 1; }
    else { while (v > 0) { buf[pos] = cast(u8, 48 + cast(i32, v % 10)); v = v / 10; pos = pos - 1; } }
    let is i32 as start = pos + 1;
    let is i32 as slen = 24 - start;
    let is *u8 as out = galloc(cast(i64, slen) + 1);
    let is i32 as j with mut = 0;
    while (j < slen) { out[j] = buf[start + j]; j = j + 1; }
    out[slen] = cast(u8, 0);
    return out;
}

// Unix seconds -> "YYYY-MM-DD HH:MM:SS" (UTC). For `why`, where the whole point
// is comparing two timestamps by eye — a raw epoch count cannot be read.
//
// Civil-from-days by the usual shift-the-year-to-March trick: with March as
// month 0 the leap day lands at the end, so the month-length pattern is a plain
// arithmetic progression and no table or branch on February is needed.
fn fmt_unix_time(secs as i64) as *u8 {
    if (secs <= 0) { return str_dup("(none)", 6); }
    let is i64 as days with mut = secs / 86400;
    let is i64 as rem with mut = secs % 86400;
    if (rem < 0) { rem = rem + 86400; days = days - 1; }

    let is i64 as z = days + 719468;               // shift epoch to 0000-03-01
    let is i64 as era with mut = z / 146097;       // 400-year era
    if (z < 0) { era = (z - 146096) / 146097; }
    let is i64 as doe = z - era * 146097;                       // day of era
    let is i64 as yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let is i64 as y with mut = yoe + era * 400;
    let is i64 as doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let is i64 as mp = (5 * doy + 2) / 153;                     // March-based month
    let is i64 as d = doy - (153 * mp + 2) / 5 + 1;
    let is i64 as m with mut = mp + 3;
    if (mp >= 10) { m = mp - 9; }
    if (m <= 2) { y = y + 1; }

    let is *u8 as out = galloc(20);
    _two_digits(out, 0, y / 100);
    _two_digits(out, 2, y % 100);
    out[4] = cast(u8, 45);                                      // '-'
    _two_digits(out, 5, m);
    out[7] = cast(u8, 45);
    _two_digits(out, 8, d);
    out[10] = cast(u8, 32);                                     // ' '
    _two_digits(out, 11, rem / 3600);
    out[13] = cast(u8, 58);                                     // ':'
    _two_digits(out, 14, (rem / 60) % 60);
    out[16] = cast(u8, 58);
    _two_digits(out, 17, rem % 60);
    out[19] = cast(u8, 0);
    return out;
}

fn _two_digits(buf as *u8, at as i64, v as i64) as void {
    buf[at] = cast(u8, 48 + cast(i32, (v / 10) % 10));
    buf[at + 1] = cast(u8, 48 + cast(i32, v % 10));
}

// Mangle a source path to the compiler's module prefix: "_" + path with
// '/' '.' '\' '-' replaced by '_'. Mirrors scope.cst:get_mod_prefix so the
// maker can derive a module's entry/symbol prefix (e.g. "src/main.cst" ->
// "_src_main_cst").
fn mangle_path(path as *u8) as *u8 {
    let is i64 as len = strlen(path);
    let is *u8 as out = galloc(len + 2);
    out[0] = 95;
    let is i64 as i with mut = 0;
    while (i < len) {
        let is u8 as ch = path[i];
        if (ch == 47 || ch == 46 || ch == 92 || ch == 45) { out[i + 1] = 95; }
        else { out[i + 1] = ch; }
        i = i + 1;
    }
    out[len + 1] = cast(u8, 0);
    return out;
}
