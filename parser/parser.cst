use "../../std/io.cst" as io;
use "../core/common.cst" as c;
use "cfile_lexer.cst" as lx;

// Table growth step. Nothing in a Causticfile has a declared ceiling any more:
// the target / dep / script tables (and each script's command list) are page-
// allocated through c.big_* and double on demand, so 75 targets — or 750 —
// parse the same way. The old fixed MAX_TARGETS=32 / MAX_SCRIPTS=16 /
// MAX_CMDS=32 arrays hard-exited with "too many targets" instead, which made
// a large Causticfile unbuildable rather than slow.
let is i32 as INITIAL_CAP with imut = 16;

// Kinds of extra link input a target can declare beyond its main `src`.
let is i32 as IN_SRC with imut = 1;   // extra .cst — compiled with --module-only
let is i32 as IN_ASM with imut = 2;   // hand-written .s — assembled with caustic-as
let is i32 as IN_OBJ with imut = 3;   // prebuilt .o — linked as-is

struct Input {
    kind as i32;
    path_ptr as *u8;
    path_len as i32;
    next as *u8;
}

// A bare (ptr,len) name in a list — used for `depends`, which is repeatable.
struct Name {
    ptr as *u8;
    len as i32;
    next as *u8;
}

// One `env "K" "V"` / `env_default "K" "V"` declaration. is_default = 1 means
// "only if the inherited environment doesn't already have it".
struct EnvVar {
    key_ptr as *u8;
    key_len as i32;
    val_ptr as *u8;
    val_len as i32;
    is_default as i32;
    next as *u8;
}

struct Target {
    name_ptr as *u8;
    name_len as i32;
    src_ptr as *u8;
    src_len as i32;
    out_ptr as *u8;
    out_len as i32;
    flags_ptr as *u8;         // compiler flags
    flags_len as i32;
    ldflags_ptr as *u8;       // caustic-ld flags (--strip, --entry=, --base=, …)
    ldflags_len as i32;
    asflags_ptr as *u8;       // caustic-as flags
    asflags_len as i32;
    has_out as i32;
    deps as *u8;              // git `depend` list (*Dep)
    mode_ptr as *u8;          // CSE --mode= value (pure|compat|bundle), or null
    mode_len as i32;
    extension_ptr as *u8;     // CSE --extension= value (cse|exe|com), or null
    extension_len as i32;
    allow_unsupported as i32; // 1 → pass --allow-unsupported (build despite unsupported ops)
    inputs as *u8;            // extra link inputs, in declaration order (*Input)
    input_count as i32;
    depends as *u8;           // other targets to build first (*Name), repeatable
    env as *u8;               // per-target env declarations (*EnvVar)
    visiting as i32;          // build-time cycle marker (see exec_build)
    done as i32;              // already built in this invocation
    // Where to write the generated VERSION module, or null for "don't".
    // Opt-in: the maker used to drop a version.cst next to every target's
    // source whether or not anything imported it, overwriting whatever was
    // already there. Generating source into someone's tree is not something to
    // do by inference.
    version_file_ptr as *u8;
    version_file_len as i32;
    install_ptr as *u8;       // `install` destination, or null
    install_len as i32;
    before as *u8;            // scripts to run before building (*Name)
    after as *u8;             // scripts to run after a successful build (*Name)
    decl_off as i64;          // offset of the target name, for error messages
}

// A named set of build settings applied on top of the project defaults, chosen
// with `--profile <name>`: the release/debug split that otherwise forces either
// two Causticfiles or editing flags in place before each build.
struct Profile {
    name_ptr as *u8;
    name_len as i32;
    flags_ptr as *u8;
    flags_len as i32;
    ldflags_ptr as *u8;
    ldflags_len as i32;
    asflags_ptr as *u8;
    asflags_len as i32;
    mode_ptr as *u8;
    mode_len as i32;
    extension_ptr as *u8;
    extension_len as i32;
    out_dir_ptr as *u8;
    out_dir_len as i32;
    next as *u8;
}

struct Dep {
    name_ptr as *u8;
    name_len as i32;
    url_ptr as *u8;
    url_len as i32;
    tag_ptr as *u8;
    tag_len as i32;
    next as *u8;
}

struct ScriptCmd {
    ptr as *u8;
    len as i32;
}

struct Script {
    name_ptr as *u8;
    name_len as i32;
    cmds as *u8;
    cmd_count as i32;
    cmd_cap as i32;
    env as *u8;               // per-script env declarations (*EnvVar)
    decl_off as i64;          // offset of the script name, for error messages
}

struct Project {
    name_ptr as *u8;
    name_len as i32;
    version_ptr as *u8;
    version_len as i32;
    author_ptr as *u8;
    author_len as i32;
    license_ptr as *u8;
    license_len as i32;
    targets as *u8;
    target_count as i32;
    target_cap as i32;
    deps as *u8;
    dep_count as i32;
    dep_cap as i32;
    scripts as *u8;
    script_count as i32;
    script_cap as i32;
    env as *u8;               // project-wide env declarations (*EnvVar)
    // Project-wide compiler flags, prepended to every target's own `flags`.
    // For the common case where every target in a project shares a flag — a
    // whole tree of freestanding programs built with the same
    // `--target=caustic-x86_64`, say — repeating it per target is the kind of
    // duplication a manifest exists to remove. A target's own `flags` come
    // after these, so the narrower scope still wins on any conflict, matching
    // how `env` / `env_default` already scope.
    flags_ptr as *u8;
    flags_len as i32;
    // The rest of the per-target build settings, also inheritable. `flags`
    // alone wasn't enough: a project whose targets all emit CSE needs the same
    // `mode`/`extension` everywhere too, and one that links freestanding needs
    // the same `ldflags`.
    ldflags_ptr as *u8;
    ldflags_len as i32;
    asflags_ptr as *u8;
    asflags_len as i32;
    mode_ptr as *u8;
    mode_len as i32;
    extension_ptr as *u8;
    extension_len as i32;
    allow_unsupported as i32;
    out_dir_ptr as *u8;       // default output directory (else "build")
    out_dir_len as i32;
    toolchain_ptr as *u8;     // where caustic/caustic-as/caustic-ld live
    toolchain_len as i32;
    prefix_ptr as *u8;        // default `install` prefix
    prefix_len as i32;
    profiles as *u8;          // *Profile, declaration order
}

// System libraries (top-level `system "lib"` declarations). Read by deps.cst /
// build.cst when assembling the compile command's -l flags. Growable: the old
// [16] arrays dropped entries past the 16th without a word.
let is *u8 as _sys_lib_ptrs with mut;      // *i64 array
let is *u8 as _sys_lib_lens with mut;      // *i32 array
let is i32 as system_lib_count with mut = 0;
let is i32 as _sys_lib_cap with mut = 0;

fn _grow_system_libs() as void {
    if (system_lib_count < _sys_lib_cap) { return; }
    let is i32 as newcap with mut = _sys_lib_cap * 2;
    if (newcap < INITIAL_CAP) { newcap = INITIAL_CAP; }
    _sys_lib_ptrs = c.big_grow(_sys_lib_ptrs, cast(i64, _sys_lib_cap) * 8, cast(i64, newcap) * 8);
    _sys_lib_lens = c.big_grow(_sys_lib_lens, cast(i64, _sys_lib_cap) * 4, cast(i64, newcap) * 4);
    _sys_lib_cap = newcap;
}

fn add_system_lib(ptr as *u8, len as i32) as void {
    // Ignore a repeat. A dependency's Causticfile is re-scanned once per target
    // that names it, so `build all` over N targets sharing one dep used to hand
    // the linker `-lfoo` N times.
    let is i32 as i with mut = 0;
    while (i < system_lib_count) {
        if (c.streq_n(ptr, cast(i64, len), system_lib_ptr(i), system_lib_len(i)) == 1) { return; }
        i = i + 1;
    }
    _grow_system_libs();
    let is *i64 as ptrs = cast(*i64, _sys_lib_ptrs);
    let is *i32 as lens = cast(*i32, _sys_lib_lens);
    ptrs[system_lib_count] = cast(i64, ptr);
    lens[system_lib_count] = len;
    system_lib_count = system_lib_count + 1;
}

fn system_lib_ptr(idx as i32) as *u8 {
    let is *i64 as ptrs = cast(*i64, _sys_lib_ptrs);
    return cast(*u8, ptrs[idx]);
}

fn system_lib_len(idx as i32) as i32 {
    let is *i32 as lens = cast(*i32, _sys_lib_lens);
    return lens[idx];
}

// === Accessors (safe struct indexing into the parallel arrays) ===

fn get_target(proj as *Project, idx as i32) as *Target {
    return cast(*Target, cast(i64, proj.targets) + cast(i64, idx) * sizeof(Target));
}

// (There is no get_dep: proj.deps is a *Dep LIST, walked via .next, not a table
// indexed like targets/scripts. The indexing accessor this file used to carry
// was never called — and would have been wrong if it had been.)

fn get_script(proj as *Project, idx as i32) as *Script {
    return cast(*Script, cast(i64, proj.scripts) + cast(i64, idx) * sizeof(Script));
}

fn get_script_cmd(scr as *Script, idx as i32) as *ScriptCmd {
    return cast(*ScriptCmd, cast(i64, scr.cmds) + cast(i64, idx) * sizeof(ScriptCmd));
}

// === List helpers ===
// Append-at-tail by walking the list. The lists are a handful of entries long
// and only built at parse time, so the walk costs nothing and this avoids
// carrying a tail pointer in every owner struct. Order matters: link inputs are
// handed to caustic-ld in declaration order, env vars are applied in order.

fn _link_input(head as *u8, node as *Input) as *u8 {
    if (cast(i64, head) == 0) { return cast(*u8, node); }
    let is *Input as p with mut = cast(*Input, head);
    while (cast(i64, p.next) != 0) { p = cast(*Input, p.next); }
    p.next = cast(*u8, node);
    return head;
}

fn _link_name(head as *u8, node as *Name) as *u8 {
    if (cast(i64, head) == 0) { return cast(*u8, node); }
    let is *Name as p with mut = cast(*Name, head);
    while (cast(i64, p.next) != 0) { p = cast(*Name, p.next); }
    p.next = cast(*u8, node);
    return head;
}

fn _link_env(head as *u8, node as *EnvVar) as *u8 {
    if (cast(i64, head) == 0) { return cast(*u8, node); }
    let is *EnvVar as p with mut = cast(*EnvVar, head);
    while (cast(i64, p.next) != 0) { p = cast(*EnvVar, p.next); }
    p.next = cast(*u8, node);
    return head;
}

fn _new_input_path(kind as i32, path as *u8) as *Input {
    let is *Input as n = cast(*Input, c.galloc(sizeof(Input)));
    n.kind = kind;
    n.path_ptr = path;
    n.path_len = cast(i32, c.strlen(path));
    n.next = cast(*u8, 0);
    return n;
}

fn _new_name(tok as *lx.Token) as *Name {
    let is *Name as n = cast(*Name, c.galloc(sizeof(Name)));
    n.ptr = tok.ptr;
    n.len = tok.len;
    n.next = cast(*u8, 0);
    return n;
}

// === Include support ===
// Paths inside an included Causticfile are written relative to THAT file, so
// every path-valued key gets the includer's directory prefixed. Set while an
// include is being parsed, empty otherwise.
let is *u8 as _path_prefix with mut;

fn _prefix() as *u8 {
    if (cast(i64, _path_prefix) == 0) { return ""; }
    return _path_prefix;
}

// A path-valued token, resolved against the current include prefix, as a
// null-terminated heap string.
fn _path_of(tok as *lx.Token) as *u8 {
    let is *u8 as raw = c.str_dup(tok.ptr, tok.len);
    if (c.strlen(_prefix()) == 0) { return raw; }
    if (raw[0] == 47) { return raw; }               // absolute: leave alone
    return c.path_join(_prefix(), raw);
}

// A shell variable name has to be a name: `env "MY-VAR" "x"` would expand to
// `MY-VAR='x'; export MY-VAR;`, which /bin/sh rejects with its own error from
// inside the child — the failure looked like the command's, not the file's.
fn _check_env_key(tok as *lx.Token) as void {
    if (tok.len == 0) { lx.error_at(tok.start, "empty environment variable name"); }
    let is i32 as i with mut = 0;
    while (i < tok.len) {
        let is u8 as ch = tok.ptr[i];
        let is i32 as ok with mut = 0;
        if (ch >= 97 && ch <= 122) { ok = 1; }
        if (ch >= 65 && ch <= 90) { ok = 1; }
        if (ch == 95) { ok = 1; }
        if (i > 0 && ch >= 48 && ch <= 57) { ok = 1; }
        if (ok == 0) {
            lx.error_at_tok(tok.start, "'", tok.ptr, tok.len,
                            "' is not a usable environment variable name (letters, digits and _ only, not starting with a digit)");
        }
        i = i + 1;
    }
}

// Parse the value pair of an `env` / `env_default` declaration.
fn _new_env(is_default as i32) as *EnvVar {
    let is lx.Token as key = lx.expect_string("env name");
    _check_env_key(&key);
    let is lx.Token as val = lx.expect_string("env value");
    let is *EnvVar as e = cast(*EnvVar, c.galloc(sizeof(EnvVar)));
    e.key_ptr = key.ptr;
    e.key_len = key.len;
    e.val_ptr = val.ptr;
    e.val_len = val.len;
    e.is_default = is_default;
    e.next = cast(*u8, 0);
    return e;
}

// === Target parsing ===

fn _init_target_defaults(t as *Target, name_tok as *lx.Token) as void {
    t.name_ptr = name_tok.ptr;
    t.name_len = name_tok.len;
    t.src_ptr = cast(*u8, 0);
    t.src_len = 0;
    t.out_ptr = cast(*u8, 0);
    t.out_len = 0;
    t.flags_ptr = cast(*u8, 0);
    t.flags_len = 0;
    t.ldflags_ptr = cast(*u8, 0);
    t.ldflags_len = 0;
    t.asflags_ptr = cast(*u8, 0);
    t.asflags_len = 0;
    t.has_out = 0;
    t.deps = cast(*u8, 0);
    t.mode_ptr = cast(*u8, 0);
    t.mode_len = 0;
    t.extension_ptr = cast(*u8, 0);
    t.extension_len = 0;
    t.allow_unsupported = 0;
    t.inputs = cast(*u8, 0);
    t.input_count = 0;
    t.depends = cast(*u8, 0);
    t.env = cast(*u8, 0);
    t.visiting = 0;
    t.done = 0;
    t.version_file_ptr = cast(*u8, 0);
    t.version_file_len = 0;
    t.install_ptr = cast(*u8, 0);
    t.install_len = 0;
    t.before = cast(*u8, 0);
    t.after = cast(*u8, 0);
    t.decl_off = name_tok.start;
}

// Add one link input, expanding a wildcard into its matches. `asm "kernel/*.s"`
// is how a hand-written script says it; spelling out every file by hand is both
// noise and a thing to forget when a new one lands. Matches arrive sorted, so
// the link order stays the same on every machine.
fn _add_inputs(t as *Target, kind as i32, tok as *lx.Token) as void {
    let is *u8 as pat = _path_of(tok);
    if (c.has_glob(pat) == 0) {
        t.inputs = _link_input(t.inputs, _new_input_path(kind, pat));
        t.input_count = t.input_count + 1;
        return;
    }
    let is i32 as n = c.glob_expand(pat);
    if (n == 0) {
        lx.error_at_tok(tok.start, "no file matches '", tok.ptr, tok.len, "'");
    }
    let is i32 as i with mut = 0;
    while (i < n) {
        t.inputs = _link_input(t.inputs, _new_input_path(kind, c.glob_get(i)));
        t.input_count = t.input_count + 1;
        i = i + 1;
    }
}

// A `depend` declared at the top level: shared by every target in the project,
// instead of repeated inside each one.
fn _parse_project_depend(proj as *Project) as void {
    let is *Dep as dep = _parse_depend();
    dep.next = proj.deps;
    proj.deps = cast(*u8, dep);
    proj.dep_count = proj.dep_count + 1;
}

// Parse `depend "name" in "url" [tag "version"]` and prepend it to t.deps.
fn _parse_target_depends(t as *Target) as void {
    let is *Dep as dep = _parse_depend();
    dep.next = t.deps;
    t.deps = cast(*u8, dep);
}

// Parse one `depend "name" in "url" [tag "version"]` clause.
fn _parse_depend() as *Dep {
    let is *Dep as dep = cast(*Dep, c.galloc(sizeof(Dep)));
    let is lx.Token as dep_name = lx.expect_string("depend name");
    dep.name_ptr = dep_name.ptr;
    dep.name_len = dep_name.len;
    dep.url_ptr = cast(*u8, 0);
    dep.url_len = 0;
    dep.tag_ptr = cast(*u8, 0);
    dep.tag_len = 0;
    dep.next = cast(*u8, 0);
    // expect "in"
    let is lx.Token as in_tok = lx.next_token();
    if (in_tok.kind == lx.TK_IDENT && c.streq(in_tok.ptr, in_tok.len, "in") == 1) {
        let is lx.Token as url_tok = lx.expect_string("depend url");
        dep.url_ptr = url_tok.ptr;
        dep.url_len = url_tok.len;
    } else {
        // The token was already consumed; without pushing it back it was simply
        // dropped, so `depend "x" src "y.cst"` quietly lost the `src` key. A
        // dependency with no url can't be resolved anyway, so say so here.
        lx.lexer_pushback(&in_tok);
        lx.error_at(in_tok.start, "expected 'in \"<url>\"' after the dependency name");
    }
    // optional: tag "version"
    let is lx.Token as peek = lx.next_token();
    if (peek.kind == lx.TK_IDENT && c.streq(peek.ptr, peek.len, "tag") == 1) {
        let is lx.Token as tag_tok = lx.expect_string("depend tag");
        dep.tag_ptr = tag_tok.ptr;
        dep.tag_len = tag_tok.len;
    } else {
        // not a tag clause — push the token back for the outer loop
        lx.lexer_pushback(&peek);
    }
    return dep;
}

fn _grow_targets(proj as *Project) as void {
    if (proj.target_count < proj.target_cap) { return; }
    let is i32 as newcap with mut = proj.target_cap * 2;
    if (newcap < INITIAL_CAP) { newcap = INITIAL_CAP; }
    proj.targets = c.big_grow(proj.targets,
                              cast(i64, proj.target_cap) * sizeof(Target),
                              cast(i64, newcap) * sizeof(Target));
    proj.target_cap = newcap;
}

// Reject a second target with the same name. find_target returns the first
// match, so the later declaration was simply never built — silently, and only
// noticeable as "why didn't my change take effect".
fn _check_dup_target(proj as *Project, name_tok as *lx.Token) as void {
    let is i32 as i with mut = 0;
    while (i < proj.target_count) {
        let is *Target as t = get_target(proj, i);
        if (c.streq_n(name_tok.ptr, cast(i64, name_tok.len), t.name_ptr, t.name_len) == 1) {
            lx.err_head(name_tok.start);
            c.eprint("duplicate target '");
            io._write_fd(2, name_tok.ptr, cast(i64, name_tok.len));
            c.eprint("' (first declared at ");
            c.eprint(lx.line_of(t.decl_off));
            c.eprint(")");
            lx.err_tail();
        }
        i = i + 1;
    }
}

fn parse_target(proj as *Project) as void {
    let is lx.Token as name_tok = lx.expect_string("target name");
    _check_dup_target(proj, &name_tok);
    let is i64 as brace_off = lx.expect_lbrace();

    // Grow BEFORE taking the element pointer: big_grow moves the table, so a
    // *Target obtained earlier would dangle.
    _grow_targets(proj);
    let is i32 as idx = proj.target_count;
    let is *Target as t = get_target(proj, idx);
    _init_target_defaults(t, &name_tok);
    proj.target_count = idx + 1;

    let is lx.Token as tok with mut;
    tok = lx.next_token();
    while (tok.kind != lx.TK_RBRACE && tok.kind != lx.TK_EOF) {
        if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "src") == 1) {
            let is lx.Token as val = lx.expect_string("src");
            let is *u8 as p = _path_of(&val);
            t.src_ptr = p;
            t.src_len = cast(i32, c.strlen(p));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "out") == 1) {
            let is lx.Token as val = lx.expect_string("out");
            let is *u8 as p = _path_of(&val);
            t.out_ptr = p;
            t.out_len = cast(i32, c.strlen(p));
            t.has_out = 1;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "version_file") == 1) {
            // Opt-in generated VERSION module (see the field's comment).
            let is lx.Token as val = lx.expect_string("version_file");
            let is *u8 as p = _path_of(&val);
            t.version_file_ptr = p;
            t.version_file_len = cast(i32, c.strlen(p));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "install") == 1) {
            let is lx.Token as val = lx.expect_string("install");
            t.install_ptr = c.str_dup(val.ptr, val.len);
            t.install_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "before") == 1) {
            // Script to run before this target builds; repeatable, in order.
            let is lx.Token as val = lx.expect_string("before");
            t.before = _link_name(t.before, _new_name(&val));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "after") == 1) {
            // Script to run after a SUCCESSFUL build; repeatable, in order.
            let is lx.Token as val = lx.expect_string("after");
            t.after = _link_name(t.after, _new_name(&val));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "flags") == 1) {
            let is lx.Token as val = lx.expect_string("flags");
            t.flags_ptr = val.ptr;
            t.flags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "ldflags") == 1) {
            // Flags for the LINK step. caustic-ld accepts several the compiler
            // rejects outright (--strip, --map, --keep-empty), so a target that
            // needs them has to go through the staged pipeline.
            let is lx.Token as val = lx.expect_string("ldflags");
            t.ldflags_ptr = val.ptr;
            t.ldflags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "asflags") == 1) {
            let is lx.Token as val = lx.expect_string("asflags");
            t.asflags_ptr = val.ptr;
            t.asflags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "source") == 1) {
            // Extra Caustic module, compiled --module-only and linked in.
            let is lx.Token as val = lx.expect_string("source");
            _add_inputs(t, IN_SRC, &val);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "asm") == 1) {
            // Hand-written assembly, run through caustic-as (-> <path>.o).
            let is lx.Token as val = lx.expect_string("asm");
            _add_inputs(t, IN_ASM, &val);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "obj") == 1) {
            // Already-built object, linked as-is.
            let is lx.Token as val = lx.expect_string("obj");
            _add_inputs(t, IN_OBJ, &val);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "mode") == 1) {
            // CSE output mode (only used with --target=caustic-x86_64)
            let is lx.Token as val = lx.expect_string("mode");
            t.mode_ptr = val.ptr;
            t.mode_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "extension") == 1) {
            // CSE output filename extension hint
            let is lx.Token as val = lx.expect_string("extension");
            t.extension_ptr = val.ptr;
            t.extension_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "allow_unsupported") == 1) {
            // Build even if the program uses ops a target doesn't implement.
            let is lx.Token as _val = lx.expect_string("allow_unsupported");
            t.allow_unsupported = 1;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "env") == 1) {
            t.env = _link_env(t.env, _new_env(0));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "env_default") == 1) {
            t.env = _link_env(t.env, _new_env(1));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "depends") == 1) {
            // Repeatable: every named target is built (in order) first.
            let is lx.Token as val = lx.expect_string("depends");
            t.depends = _link_name(t.depends, _new_name(&val));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "depend") == 1) {
            _parse_target_depends(t);
        } else if (tok.kind == lx.TK_IDENT) {
            // A block keyword inside a target means the '}' is missing, not that
            // someone invented a key — say the useful thing.
            if (c.streq(tok.ptr, tok.len, "target") == 1
                || c.streq(tok.ptr, tok.len, "script") == 1
                || c.streq(tok.ptr, tok.len, "profile") == 1) {
                lx.err_head(brace_off);
                c.eprint("unclosed '{' for target '");
                io._write_fd(2, t.name_ptr, cast(i64, t.name_len));
                c.eprint("' — '");
                io._write_fd(2, tok.ptr, cast(i64, tok.len));
                c.eprint("' at ");
                c.eprint(lx.line_of(tok.start));
                c.eprint(" starts a new block");
                lx.err_tail();
            }
            lx.err_head(tok.start);
            c.eprint("unknown target key '");
            io._write_fd(2, tok.ptr, cast(i64, tok.len));
            c.eprint("' in target '");
            io._write_fd(2, t.name_ptr, cast(i64, t.name_len));
            c.eprint("'");
            lx.err_tail();
        } else {
            lx.error_at(tok.start, "expected a target key or '}'");
        }
        tok = lx.next_token();
    }
    // A '}' that never came used to end the loop silently at EOF: the rest of
    // the file became this target's body and every later target vanished
    // without a word — the same failure mode the '#'-comment bug had.
    if (tok.kind == lx.TK_EOF) {
        lx.err_head(brace_off);
        c.eprint("unclosed '{' for target '");
        io._write_fd(2, t.name_ptr, cast(i64, t.name_len));
        c.eprint("' — no matching '}' before end of file");
        lx.err_tail();
    }
}

fn _grow_scripts(proj as *Project) as void {
    if (proj.script_count < proj.script_cap) { return; }
    let is i32 as newcap with mut = proj.script_cap * 2;
    if (newcap < INITIAL_CAP) { newcap = INITIAL_CAP; }
    proj.scripts = c.big_grow(proj.scripts,
                              cast(i64, proj.script_cap) * sizeof(Script),
                              cast(i64, newcap) * sizeof(Script));
    proj.script_cap = newcap;
}

fn _grow_cmds(s as *Script) as void {
    if (s.cmd_count < s.cmd_cap) { return; }
    let is i32 as newcap with mut = s.cmd_cap * 2;
    if (newcap < INITIAL_CAP) { newcap = INITIAL_CAP; }
    s.cmds = c.big_grow(s.cmds,
                        cast(i64, s.cmd_cap) * sizeof(ScriptCmd),
                        cast(i64, newcap) * sizeof(ScriptCmd));
    s.cmd_cap = newcap;
}

fn _check_dup_script(proj as *Project, name_tok as *lx.Token) as void {
    let is i32 as i with mut = 0;
    while (i < proj.script_count) {
        let is *Script as s = get_script(proj, i);
        if (c.streq_n(name_tok.ptr, cast(i64, name_tok.len), s.name_ptr, s.name_len) == 1) {
            lx.err_head(name_tok.start);
            c.eprint("duplicate script '");
            io._write_fd(2, name_tok.ptr, cast(i64, name_tok.len));
            c.eprint("' (first declared at ");
            c.eprint(lx.line_of(s.decl_off));
            c.eprint(")");
            lx.err_tail();
        }
        i = i + 1;
    }
}

fn parse_script(proj as *Project) as void {
    let is lx.Token as name_tok = lx.expect_string("script name");
    _check_dup_script(proj, &name_tok);
    let is i64 as brace_off = lx.expect_lbrace();

    _grow_scripts(proj);
    let is i32 as idx = proj.script_count;
    let is *Script as s = get_script(proj, idx);
    s.name_ptr = name_tok.ptr;
    s.name_len = name_tok.len;
    s.cmds = cast(*u8, 0);
    s.cmd_count = 0;
    s.cmd_cap = 0;
    s.env = cast(*u8, 0);
    s.decl_off = name_tok.start;
    proj.script_count = idx + 1;

    let is lx.Token as tok with mut;
    tok = lx.next_token();
    while (tok.kind != lx.TK_RBRACE && tok.kind != lx.TK_EOF) {
        if (tok.kind == lx.TK_STRING) {
            _grow_cmds(s);
            let is *ScriptCmd as cmd = get_script_cmd(s, s.cmd_count);
            cmd.ptr = tok.ptr;
            cmd.len = tok.len;
            s.cmd_count = s.cmd_count + 1;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "env") == 1) {
            s.env = _link_env(s.env, _new_env(0));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "env_default") == 1) {
            s.env = _link_env(s.env, _new_env(1));
        } else if (tok.kind == lx.TK_IDENT) {
            lx.err_head(tok.start);
            c.eprint("unknown script key '");
            io._write_fd(2, tok.ptr, cast(i64, tok.len));
            c.eprint("'");
            lx.err_tail();
        }
        tok = lx.next_token();
    }
    if (tok.kind == lx.TK_EOF) {
        lx.err_head(brace_off);
        c.eprint("unclosed '{' for script '");
        io._write_fd(2, s.name_ptr, cast(i64, s.name_len));
        c.eprint("' — no matching '}' before end of file");
        lx.err_tail();
    }
}

// `profile "release" { flags "-O2" }` — the same build settings a project can
// declare, selectable per invocation with `--profile release`.
fn parse_profile(proj as *Project) as void {
    let is lx.Token as name_tok = lx.expect_string("profile name");
    let is i64 as brace_off = lx.expect_lbrace();

    let is *Profile as p = cast(*Profile, c.galloc(sizeof(Profile)));
    p.name_ptr = name_tok.ptr;
    p.name_len = name_tok.len;
    p.flags_ptr = cast(*u8, 0);
    p.flags_len = 0;
    p.ldflags_ptr = cast(*u8, 0);
    p.ldflags_len = 0;
    p.asflags_ptr = cast(*u8, 0);
    p.asflags_len = 0;
    p.mode_ptr = cast(*u8, 0);
    p.mode_len = 0;
    p.extension_ptr = cast(*u8, 0);
    p.extension_len = 0;
    p.out_dir_ptr = cast(*u8, 0);
    p.out_dir_len = 0;
    p.next = cast(*u8, 0);

    let is lx.Token as tok with mut;
    tok = lx.next_token();
    while (tok.kind != lx.TK_RBRACE && tok.kind != lx.TK_EOF) {
        if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "flags") == 1) {
            let is lx.Token as val = lx.expect_string("flags");
            p.flags_ptr = val.ptr;
            p.flags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "ldflags") == 1) {
            let is lx.Token as val = lx.expect_string("ldflags");
            p.ldflags_ptr = val.ptr;
            p.ldflags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "asflags") == 1) {
            let is lx.Token as val = lx.expect_string("asflags");
            p.asflags_ptr = val.ptr;
            p.asflags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "mode") == 1) {
            let is lx.Token as val = lx.expect_string("mode");
            p.mode_ptr = val.ptr;
            p.mode_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "extension") == 1) {
            let is lx.Token as val = lx.expect_string("extension");
            p.extension_ptr = val.ptr;
            p.extension_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "out_dir") == 1) {
            let is lx.Token as val = lx.expect_string("out_dir");
            let is *u8 as v = _path_of(&val);
            p.out_dir_ptr = v;
            p.out_dir_len = cast(i32, c.strlen(v));
        } else if (tok.kind == lx.TK_IDENT) {
            lx.err_head(tok.start);
            c.eprint("unknown profile key '");
            io._write_fd(2, tok.ptr, cast(i64, tok.len));
            c.eprint("'");
            lx.err_tail();
        }
        tok = lx.next_token();
    }
    if (tok.kind == lx.TK_EOF) {
        lx.err_head(brace_off);
        c.eprint("unclosed '{' for profile '");
        io._write_fd(2, name_tok.ptr, cast(i64, name_tok.len));
        c.eprint("'");
        lx.err_tail();
    }

    // append, preserving declaration order
    if (cast(i64, proj.profiles) == 0) {
        proj.profiles = cast(*u8, p);
    } else {
        let is *Profile as q with mut = cast(*Profile, proj.profiles);
        while (cast(i64, q.next) != 0) { q = cast(*Profile, q.next); }
        q.next = cast(*u8, p);
    }
}

// The profile selected with --profile, or null. Resolved once by main and read
// by the build driver when it composes each target's effective settings.
let is *u8 as _active_profile with mut;

fn select_profile(proj as *Project, name as *u8) as i32 {
    let is *Profile as p with mut = cast(*Profile, proj.profiles);
    while (cast(i64, p) != 0) {
        if (c.streq_n(p.name_ptr, cast(i64, p.name_len), name, cast(i32, c.strlen(name))) == 1) {
            _active_profile = cast(*u8, p);
            return 1;
        }
        p = cast(*Profile, p.next);
    }
    return 0;
}

fn active_profile() as *Profile {
    return cast(*Profile, _active_profile);
}

// === Effective build settings ===
// A setting can be declared at three scopes: the project, the selected profile,
// and the target. Flag lists CONCATENATE in that order (so a target's own flag
// comes last and wins with the compiler's last-one-wins parsing), while
// single-valued settings take the narrowest declaration.
//
// These live here rather than in the build driver because both the driver and
// the output-path logic need the same answers, and because "what does this
// target actually build with" is a question about the parsed project.

fn _append_part(out as *u8, ptr as *u8, len as i32) as *u8 {
    if (len == 0) { return out; }
    let is *u8 as v = c.str_dup(ptr, len);
    if (c.strlen(out) == 0) { return v; }
    return c.str_cat3(out, " ", v);
}

fn eff_flags(t as *Target, proj as *Project) as *u8 {
    let is *u8 as out with mut = c.str_dup("", 0);
    out = _append_part(out, proj.flags_ptr, proj.flags_len);
    let is *Profile as p = active_profile();
    if (cast(i64, p) != 0) { out = _append_part(out, p.flags_ptr, p.flags_len); }
    out = _append_part(out, t.flags_ptr, t.flags_len);
    return out;
}

fn eff_ldflags(t as *Target, proj as *Project) as *u8 {
    let is *u8 as out with mut = c.str_dup("", 0);
    out = _append_part(out, proj.ldflags_ptr, proj.ldflags_len);
    let is *Profile as p = active_profile();
    if (cast(i64, p) != 0) { out = _append_part(out, p.ldflags_ptr, p.ldflags_len); }
    out = _append_part(out, t.ldflags_ptr, t.ldflags_len);
    return out;
}

fn eff_asflags(t as *Target, proj as *Project) as *u8 {
    let is *u8 as out with mut = c.str_dup("", 0);
    out = _append_part(out, proj.asflags_ptr, proj.asflags_len);
    let is *Profile as p = active_profile();
    if (cast(i64, p) != 0) { out = _append_part(out, p.asflags_ptr, p.asflags_len); }
    out = _append_part(out, t.asflags_ptr, t.asflags_len);
    return out;
}

// Narrowest wins: target, else profile, else project, else "".
fn eff_mode(t as *Target, proj as *Project) as *u8 {
    if (t.mode_len > 0) { return c.str_dup(t.mode_ptr, t.mode_len); }
    let is *Profile as p = active_profile();
    if (cast(i64, p) != 0 && p.mode_len > 0) { return c.str_dup(p.mode_ptr, p.mode_len); }
    if (proj.mode_len > 0) { return c.str_dup(proj.mode_ptr, proj.mode_len); }
    return c.str_dup("", 0);
}

fn eff_extension(t as *Target, proj as *Project) as *u8 {
    if (t.extension_len > 0) { return c.str_dup(t.extension_ptr, t.extension_len); }
    let is *Profile as p = active_profile();
    if (cast(i64, p) != 0 && p.extension_len > 0) { return c.str_dup(p.extension_ptr, p.extension_len); }
    if (proj.extension_len > 0) { return c.str_dup(proj.extension_ptr, proj.extension_len); }
    return c.str_dup("", 0);
}

fn eff_allow_unsupported(t as *Target, proj as *Project) as i32 {
    if (t.allow_unsupported == 1) { return 1; }
    if (proj.allow_unsupported == 1) { return 1; }
    return 0;
}

fn eff_out_dir(proj as *Project) as *u8 {
    let is *Profile as p = active_profile();
    if (cast(i64, p) != 0 && p.out_dir_len > 0) { return c.str_dup(p.out_dir_ptr, p.out_dir_len); }
    if (proj.out_dir_len > 0) { return c.str_dup(proj.out_dir_ptr, proj.out_dir_len); }
    return c.str_dup("build", 5);
}

// Files already pulled in by `include`, so a cycle is an error rather than an
// infinite descent. Keyed on the path as written after prefixing.
let is *u8 as _included with mut;      // *Name list

fn _mark_included(path as *u8) as i32 {
    let is *Name as n with mut = cast(*Name, _included);
    while (cast(i64, n) != 0) {
        if (c.streq_lit(n.ptr, path) == 1) { return 0; }
        n = cast(*Name, n.next);
    }
    let is *Name as e = cast(*Name, c.galloc(sizeof(Name)));
    e.ptr = path;
    e.len = cast(i32, c.strlen(path));
    e.next = _included;
    _included = cast(*u8, e);
    return 1;
}

// Parse an included Causticfile into the SAME project. Its own path-valued keys
// are relative to it, so the include's directory becomes the prefix for the
// duration — that is what lets a top-level Causticfile pull in a subdirectory's
// (say a userspace tree of 75 targets) without rewriting a single path.
//
// Not prefixed: paths embedded inside `flags` text (`--path kernel`). Rewriting
// flag strings would mean parsing the compiler's whole option grammar; an
// included file that needs those should spell them relative to the top level.
fn _parse_include(proj as *Project, tok as *lx.Token) as void {
    let is *u8 as path = _path_of(tok);
    if (_mark_included(path) == 0) {
        lx.error_at_tok(tok.start, "include cycle: '", tok.ptr, tok.len, "' is already being parsed");
    }
    let is i64 as size = c.read_file_size(path);
    if (size == 0) {
        lx.error_at_tok(tok.start, "cannot read include '", tok.ptr, tok.len, "'");
    }
    let is *u8 as isrc = c.read_file(path);
    if (cast(i64, isrc) == 0) {
        lx.error_at_tok(tok.start, "cannot read include '", tok.ptr, tok.len, "'");
    }

    let is lx.LexState as saved;
    lx.lexer_save(&saved);
    let is *u8 as saved_prefix = _path_prefix;
    _path_prefix = c.path_dirname(path);
    lx.lexer_init(isrc, size, path);
    _parse_body(proj);
    _path_prefix = saved_prefix;
    lx.lexer_restore(&saved);
}

fn parse(src as *u8, src_len as i64) as Project {
    return parse_file(src, src_len, "Causticfile");
}

fn parse_file(src as *u8, src_len as i64, fname as *u8) as Project {
    lx.lexer_init(src, src_len, fname);
    system_lib_count = 0;
    _path_prefix = cast(*u8, 0);
    _included = cast(*u8, 0);

    let is Project as proj;
    proj.name_ptr = cast(*u8, 0);
    proj.name_len = 0;
    proj.version_ptr = cast(*u8, 0);
    proj.version_len = 0;
    proj.author_ptr = cast(*u8, 0);
    proj.author_len = 0;
    proj.license_ptr = cast(*u8, 0);
    proj.license_len = 0;
    proj.targets = cast(*u8, 0);
    proj.target_count = 0;
    proj.target_cap = 0;
    proj.deps = cast(*u8, 0);
    proj.dep_count = 0;
    proj.dep_cap = 0;
    proj.scripts = cast(*u8, 0);
    proj.script_count = 0;
    proj.script_cap = 0;
    proj.env = cast(*u8, 0);
    proj.flags_ptr = cast(*u8, 0);
    proj.flags_len = 0;
    proj.ldflags_ptr = cast(*u8, 0);
    proj.ldflags_len = 0;
    proj.asflags_ptr = cast(*u8, 0);
    proj.asflags_len = 0;
    proj.mode_ptr = cast(*u8, 0);
    proj.mode_len = 0;
    proj.extension_ptr = cast(*u8, 0);
    proj.extension_len = 0;
    proj.allow_unsupported = 0;
    proj.out_dir_ptr = cast(*u8, 0);
    proj.out_dir_len = 0;
    proj.toolchain_ptr = cast(*u8, 0);
    proj.toolchain_len = 0;
    proj.prefix_ptr = cast(*u8, 0);
    proj.prefix_len = 0;
    proj.profiles = cast(*u8, 0);

    _parse_body(&proj);
    return proj;
}

fn _parse_body(proj as *Project) as void {
    let is lx.Token as tok with mut;
    tok = lx.next_token();
    while (tok.kind != lx.TK_EOF) {
        if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "name") == 1) {
            let is lx.Token as val = lx.expect_string("name");
            proj.name_ptr = val.ptr;
            proj.name_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "version") == 1) {
            let is lx.Token as val = lx.expect_string("version");
            proj.version_ptr = val.ptr;
            proj.version_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "author") == 1) {
            let is lx.Token as val = lx.expect_string("author");
            proj.author_ptr = val.ptr;
            proj.author_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "license") == 1) {
            let is lx.Token as val = lx.expect_string("license");
            proj.license_ptr = val.ptr;
            proj.license_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "flags") == 1) {
            // Project-wide compiler flags; every target inherits them.
            let is lx.Token as val = lx.expect_string("flags");
            proj.flags_ptr = val.ptr;
            proj.flags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "ldflags") == 1) {
            let is lx.Token as val = lx.expect_string("ldflags");
            proj.ldflags_ptr = val.ptr;
            proj.ldflags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "asflags") == 1) {
            let is lx.Token as val = lx.expect_string("asflags");
            proj.asflags_ptr = val.ptr;
            proj.asflags_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "mode") == 1) {
            let is lx.Token as val = lx.expect_string("mode");
            proj.mode_ptr = val.ptr;
            proj.mode_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "extension") == 1) {
            let is lx.Token as val = lx.expect_string("extension");
            proj.extension_ptr = val.ptr;
            proj.extension_len = val.len;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "allow_unsupported") == 1) {
            let is lx.Token as _val = lx.expect_string("allow_unsupported");
            proj.allow_unsupported = 1;
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "out_dir") == 1) {
            // Where a target with no explicit `out` lands (default "build").
            let is lx.Token as val = lx.expect_string("out_dir");
            let is *u8 as v = _path_of(&val);
            proj.out_dir_ptr = v;
            proj.out_dir_len = cast(i32, c.strlen(v));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "toolchain") == 1) {
            // Directory holding caustic / caustic-as / caustic-ld.
            let is lx.Token as val = lx.expect_string("toolchain");
            let is *u8 as v = _path_of(&val);
            proj.toolchain_ptr = v;
            proj.toolchain_len = cast(i32, c.strlen(v));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "prefix") == 1) {
            // Default destination for `caustic-mk install`.
            let is lx.Token as val = lx.expect_string("prefix");
            let is *u8 as v = _path_of(&val);
            proj.prefix_ptr = v;
            proj.prefix_len = cast(i32, c.strlen(v));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "target") == 1) {
            parse_target(proj);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "profile") == 1) {
            parse_profile(proj);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "include") == 1) {
            let is lx.Token as val = lx.expect_string("include");
            _parse_include(proj, &val);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "system") == 1) {
            let is lx.Token as val = lx.expect_string("system lib");
            add_system_lib(c.str_dup(val.ptr, val.len), val.len);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "env") == 1) {
            // Project-wide: applies to every script command AND every build step.
            proj.env = _link_env(proj.env, _new_env(0));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "env_default") == 1) {
            proj.env = _link_env(proj.env, _new_env(1));
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "depend") == 1) {
            // A project-wide git dependency: every target gets its --path. The
            // README documented this shape from the start, but only the
            // in-a-target form parsed — at the top level it was a hard error.
            _parse_project_depend(proj);
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "script") == 1) {
            parse_script(proj);
        } else if (tok.kind == lx.TK_IDENT) {
            lx.error_at_tok(tok.start, "unknown key '", tok.ptr, tok.len, "'");
        } else {
            lx.error_at(tok.start, "expected a key such as name / target / script");
        }
        tok = lx.next_token();
    }
}
