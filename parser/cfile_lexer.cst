use "../../std/io.cst" as io;
use "../core/common.cst" as c;

// Token types
let is i32 as TK_IDENT with imut = 1;
let is i32 as TK_STRING with imut = 2;
let is i32 as TK_LBRACE with imut = 3;
let is i32 as TK_RBRACE with imut = 4;
let is i32 as TK_EOF with imut = 5;
let is i32 as TK_EQEQ with imut = 6;   // `==`, only in a `when` condition

struct Token {
    kind as i32;
    ptr as *u8;
    len as i32;
    start as i64;      // offset in _src where the token began
}

// Lexer state. Kept private to this module; the parser drives it through
// lexer_init / next_token / lexer_pushback so no cross-module global writes
// are needed.
let is *u8 as _src with mut;
let is i64 as _src_len with mut = 0;
let is i64 as _pos with mut = 0;
let is *u8 as _fname with mut;

// A whole lexer state, so `include` can parse another file and come back.
struct LexState {
    src as *u8;
    src_len as i64;
    pos as i64;
    fname as *u8;
}

fn lexer_init(src as *u8, src_len as i64, fname as *u8) as void {
    _src = src;
    _src_len = src_len;
    _pos = 0;
    _fname = fname;
}

fn lexer_save(s as *LexState) as void {
    s.src = _src;
    s.src_len = _src_len;
    s.pos = _pos;
    s.fname = _fname;
}

fn lexer_restore(s as *LexState) as void {
    _src = s.src;
    _src_len = s.src_len;
    _pos = s.pos;
    _fname = s.fname;
}

fn lexer_pos() as i64 { return _pos; }

fn lexer_file() as *u8 {
    if (cast(i64, _fname) == 0) { return "Causticfile"; }
    return _fname;
}

// === Diagnostics ===
// Every error the parser or lexer raises is anchored to a source offset and
// printed as `<file>:<line>:<col>: error: …`. Without it the messages named
// only what was wrong, never where — in a Causticfile with 75 targets that is
// a hunt, and the editor can't jump to it either.

// "line N" for an offset — used when an error refers to a second location
// (a duplicate's original declaration, an unclosed block's '{').
fn line_of(off as i64) as *u8 {
    let is i64 as line with mut = 1;
    let is i64 as i with mut = 0;
    while (i < off && i < _src_len) {
        if (_src[i] == 10) { line = line + 1; }
        i = i + 1;
    }
    return c.str_cat("line ", c.u64_to_str(line));
}

fn err_head(off as i64) as void {
    let is i64 as line with mut = 1;
    let is i64 as col with mut = 1;
    let is i64 as i with mut = 0;
    while (i < off && i < _src_len) {
        if (_src[i] == 10) {
            line = line + 1;
            col = 1;
        } else {
            col = col + 1;
        }
        i = i + 1;
    }
    c.eprint(lexer_file());
    c.eprint(":");
    c.eprint(c.u64_to_str(line));
    c.eprint(":");
    c.eprint(c.u64_to_str(col));
    c.eprint(": error: ");
}

// Close an error message opened with err_head and abort. The maker never tries
// to recover from a malformed Causticfile: a half-understood project would
// build the wrong thing.
fn err_tail() as void {
    c.write_nl(2);
    io.exit(1);
}

fn error_at(off as i64, msg as *u8) as void {
    err_head(off);
    c.eprint(msg);
    err_tail();
}

// error_at plus a (ptr,len) fragment quoted between the two halves — for
// messages that name the offending key or value.
fn error_at_tok(off as i64, pre as *u8, ptr as *u8, len as i32, post as *u8) as void {
    err_head(off);
    c.eprint(pre);
    io._write_fd(2, ptr, cast(i64, len));
    c.eprint(post);
    err_tail();
}

// Rewind so the next next_token() re-reads `tok` (one-token lookahead undo).
// Uses the recorded source offset, not tok.ptr — an escaped string token points
// at a heap copy, so pointer arithmetic against _src would be meaningless.
fn lexer_pushback(tok as *Token) as void {
    if (tok.start >= 0 && tok.start <= _src_len) {
        _pos = tok.start;
    }
}

fn skip_whitespace() as void {
    while (_pos < _src_len) {
        let is u8 as ch = _src[_pos];
        if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
            _pos = _pos + 1;
        } else if (ch == 35 || (ch == 47 && _pos + 1 < _src_len && _src[_pos + 1] == 47)) {
            // skip a `//` or `#` comment. `#` used to fall through to the
            // unknown-character path, which reported TK_EOF — so a Causticfile
            // written with `#` comments parsed only up to the first one and
            // every target below it silently vanished.
            while (_pos < _src_len && _src[_pos] != 10) {
                _pos = _pos + 1;
            }
        } else {
            return;
        }
    }
}

fn is_ident_char(ch as u8) as i32 {
    if (ch >= 97 && ch <= 122) { return 1; }
    if (ch >= 65 && ch <= 90) { return 1; }
    if (ch >= 48 && ch <= 57) { return 1; }
    if (ch == 95) { return 1; }
    if (ch == 45) { return 1; }
    return 0;
}

fn next_token() as Token {
    let is Token as tok;
    skip_whitespace();
    tok.start = _pos;
    if (_pos >= _src_len) {
        tok.kind = TK_EOF;
        tok.ptr = cast(*u8, 0);
        tok.len = 0;
        return tok;
    }
    let is u8 as ch = _src[_pos];
    if (ch == 123) {
        tok.kind = TK_LBRACE;
        tok.ptr = cast(*u8, cast(i64, _src) + _pos);
        tok.len = 1;
        _pos = _pos + 1;
        return tok;
    }
    if (ch == 125) {
        tok.kind = TK_RBRACE;
        tok.ptr = cast(*u8, cast(i64, _src) + _pos);
        tok.len = 1;
        _pos = _pos + 1;
        return tok;
    }
    // `==`, the only operator in the language, and only in `when x == "v"`. A
    // lone `=` is rejected here rather than surfacing later as a mystery token.
    if (ch == 61) {
        if (_pos + 1 < _src_len && _src[_pos + 1] == 61) {
            tok.kind = TK_EQEQ;
            tok.ptr = cast(*u8, cast(i64, _src) + _pos);
            tok.len = 2;
            _pos = _pos + 2;
            return tok;
        }
        error_at(_pos, "stray '=' (did you mean '==', in a `when` condition?)");
    }
    if (ch == 34) {
        // String literal. Backslash escapes \" \\ \n \t are honoured, so a
        // command can contain a double quote — without them, a script command
        // like  "sh -c \"echo hi\""  silently terminated at the first \" and
        // the rest of the line parsed as garbage tokens.
        _pos = _pos + 1;
        let is i64 as start = _pos;
        let is i32 as escaped with mut = 0;
        // A raw newline ends the search: a string is a single line. Letting one
        // run past the line meant a missing closing quote swallowed the next
        // key and its value, and the complaint surfaced far away as a bogus
        // "unknown key" — or at EOF, naming the wrong line entirely.
        while (_pos < _src_len && _src[_pos] != 34 && _src[_pos] != 10) {
            if (_src[_pos] == 92 && _pos + 1 < _src_len) {   // '\'
                escaped = 1;
                _pos = _pos + 1;
            }
            _pos = _pos + 1;
        }
        let is i64 as raw_len = _pos - start;
        if (_pos >= _src_len || _src[_pos] == 10) {
            error_at(start - 1, "unterminated string (a string may not span lines — use \\n)");
        }
        _pos = _pos + 1;
        tok.kind = TK_STRING;
        if (escaped == 0) {
            // Common case: the token aliases the source buffer, no copy.
            tok.ptr = cast(*u8, cast(i64, _src) + start);
            tok.len = cast(i32, raw_len);
            return tok;
        }
        let is *u8 as buf = c.galloc(raw_len + 1);
        let is i64 as i with mut = 0;
        let is i64 as o with mut = 0;
        while (i < raw_len) {
            let is u8 as cur = _src[start + i];
            if (cur == 92 && i + 1 < raw_len) {
                let is u8 as nx = _src[start + i + 1];
                if (nx == 110) { buf[o] = cast(u8, 10); }        // \n
                else if (nx == 116) { buf[o] = cast(u8, 9); }    // \t
                else { buf[o] = nx; }                            // \" \\ \<any>
                o = o + 1;
                i = i + 2;
            } else {
                buf[o] = cur;
                o = o + 1;
                i = i + 1;
            }
        }
        buf[o] = cast(u8, 0);
        tok.ptr = buf;
        tok.len = cast(i32, o);
        return tok;
    }
    if (is_ident_char(ch) == 1) {
        let is i64 as start = _pos;
        while (_pos < _src_len && is_ident_char(_src[_pos]) == 1) {
            _pos = _pos + 1;
        }
        tok.kind = TK_IDENT;
        tok.ptr = cast(*u8, cast(i64, _src) + start);
        tok.len = cast(i32, _pos - start);
        return tok;
    }
    // Anything else is a syntax error. It used to be reported as TK_EOF, which
    // made the parser stop silently and ignore the rest of the file — a stray
    // character truncated the project instead of failing it.
    error_at_tok(_pos, "unexpected character '", cast(*u8, cast(i64, _src) + _pos), 1, "'");
    return tok;
}

fn expect_string(msg as *u8) as Token {
    let is Token as tok = next_token();
    if (tok.kind != TK_STRING) {
        err_head(tok.start);
        c.eprint("expected a quoted string for '");
        io._write_fd(2, msg, c.strlen(msg));
        c.eprint("'");
        err_tail();
    }
    return tok;
}

// Returns the offset of the '{', so the matching-brace check can point back at
// it when the block is never closed.
fn expect_lbrace() as i64 {
    let is Token as tok = next_token();
    if (tok.kind != TK_LBRACE) {
        error_at(tok.start, "expected '{'");
    }
    return tok.start;
}
