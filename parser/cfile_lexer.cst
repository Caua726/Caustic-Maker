use "../../std/io.cst" as io;
use "../core/common.cst" as c;

// Token types
let is i32 as TK_IDENT with imut = 1;
let is i32 as TK_STRING with imut = 2;
let is i32 as TK_LBRACE with imut = 3;
let is i32 as TK_RBRACE with imut = 4;
let is i32 as TK_EOF with imut = 5;

struct Token {
    kind as i32;
    ptr as *u8;
    len as i32;
    start as i64;      // offset in _src where the token began
}

// Lexer state. Kept private to this module; the parser drives it through
// lexer_init / next_token / lexer_pushback so no cross-module global writes
// are needed.
let is *u8 as _src with mut;
let is i64 as _src_len with mut = 0;
let is i64 as _pos with mut = 0;

fn lexer_init(src as *u8, src_len as i64) as void {
    _src = src;
    _src_len = src_len;
    _pos = 0;
}

// Rewind so the next next_token() re-reads `tok` (one-token lookahead undo).
// Uses the recorded source offset, not tok.ptr — an escaped string token points
// at a heap copy, so pointer arithmetic against _src would be meaningless.
fn lexer_pushback(tok as *Token) as void {
    if (tok.start >= 0 && tok.start <= _src_len) {
        _pos = tok.start;
    }
}

fn skip_whitespace() as void {
    while (_pos < _src_len) {
        let is u8 as ch = _src[_pos];
        if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
            _pos = _pos + 1;
        } else if (ch == 35 || (ch == 47 && _pos + 1 < _src_len && _src[_pos + 1] == 47)) {
            // skip a `//` or `#` comment. `#` used to fall through to the
            // unknown-character path, which reported TK_EOF — so a Causticfile
            // written with `#` comments parsed only up to the first one and
            // every target below it silently vanished.
            while (_pos < _src_len && _src[_pos] != 10) {
                _pos = _pos + 1;
            }
        } else {
            return;
        }
    }
}

fn is_ident_char(ch as u8) as i32 {
    if (ch >= 97 && ch <= 122) { return 1; }
    if (ch >= 65 && ch <= 90) { return 1; }
    if (ch >= 48 && ch <= 57) { return 1; }
    if (ch == 95) { return 1; }
    if (ch == 45) { return 1; }
    return 0;
}

fn next_token() as Token {
    let is Token as tok;
    skip_whitespace();
    tok.start = _pos;
    if (_pos >= _src_len) {
        tok.kind = TK_EOF;
        tok.ptr = cast(*u8, 0);
        tok.len = 0;
        return tok;
    }
    let is u8 as ch = _src[_pos];
    if (ch == 123) {
        tok.kind = TK_LBRACE;
        tok.ptr = cast(*u8, cast(i64, _src) + _pos);
        tok.len = 1;
        _pos = _pos + 1;
        return tok;
    }
    if (ch == 125) {
        tok.kind = TK_RBRACE;
        tok.ptr = cast(*u8, cast(i64, _src) + _pos);
        tok.len = 1;
        _pos = _pos + 1;
        return tok;
    }
    if (ch == 34) {
        // String literal. Backslash escapes \" \\ \n \t are honoured, so a
        // command can contain a double quote — without them, a script command
        // like  "sh -c \"echo hi\""  silently terminated at the first \" and
        // the rest of the line parsed as garbage tokens.
        _pos = _pos + 1;
        let is i64 as start = _pos;
        let is i32 as escaped with mut = 0;
        while (_pos < _src_len && _src[_pos] != 34) {
            if (_src[_pos] == 92 && _pos + 1 < _src_len) {   // '\'
                escaped = 1;
                _pos = _pos + 1;
            }
            _pos = _pos + 1;
        }
        let is i64 as raw_len = _pos - start;
        if (_pos >= _src_len) {
            c.eprint("error: unterminated string in Causticfile");
            c.write_nl(2);
            io.exit(1);
        }
        _pos = _pos + 1;
        tok.kind = TK_STRING;
        if (escaped == 0) {
            // Common case: the token aliases the source buffer, no copy.
            tok.ptr = cast(*u8, cast(i64, _src) + start);
            tok.len = cast(i32, raw_len);
            return tok;
        }
        let is *u8 as buf = c.galloc(raw_len + 1);
        let is i64 as i with mut = 0;
        let is i64 as o with mut = 0;
        while (i < raw_len) {
            let is u8 as cur = _src[start + i];
            if (cur == 92 && i + 1 < raw_len) {
                let is u8 as nx = _src[start + i + 1];
                if (nx == 110) { buf[o] = cast(u8, 10); }        // \n
                else if (nx == 116) { buf[o] = cast(u8, 9); }    // \t
                else { buf[o] = nx; }                            // \" \\ \<any>
                o = o + 1;
                i = i + 2;
            } else {
                buf[o] = cur;
                o = o + 1;
                i = i + 1;
            }
        }
        buf[o] = cast(u8, 0);
        tok.ptr = buf;
        tok.len = cast(i32, o);
        return tok;
    }
    if (is_ident_char(ch) == 1) {
        let is i64 as start = _pos;
        while (_pos < _src_len && is_ident_char(_src[_pos]) == 1) {
            _pos = _pos + 1;
        }
        tok.kind = TK_IDENT;
        tok.ptr = cast(*u8, cast(i64, _src) + start);
        tok.len = cast(i32, _pos - start);
        return tok;
    }
    // Anything else is a syntax error. It used to be reported as TK_EOF, which
    // made the parser stop silently and ignore the rest of the file — a stray
    // character truncated the project instead of failing it.
    c.eprint("error: unexpected character '");
    io._write_fd(2, cast(*u8, cast(i64, _src) + _pos), 1);
    c.eprint("' in Causticfile");
    c.write_nl(2);
    io.exit(1);
    return tok;
}

fn expect_string(msg as *u8) as Token {
    let is Token as tok = next_token();
    if (tok.kind != TK_STRING) {
        c.eprint("error: expected string for ");
        io._write_fd(2, msg, c.strlen(msg));
        c.write_nl(2);
        io.exit(1);
    }
    return tok;
}

fn expect_lbrace() as void {
    let is Token as tok = next_token();
    if (tok.kind != TK_LBRACE) {
        c.eprint("error: expected '{'");
        c.write_nl(2);
        io.exit(1);
    }
}
