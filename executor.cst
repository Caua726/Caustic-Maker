use "../std/io.cst" as io;
use "../std/mem.cst" as mem;
use "../std/os.cst" as os;
use "../std/process.cst" as proc;
use "parser.cst" as parser;

let is mem.bins.Bins as _bins with mut;
let is i32 as _bins_ready with mut = 0;

fn galloc_(size as i64) as *u8 {
    if (_bins_ready == 0) { _bins = mem.bins.bins_new(1048576); _bins_ready = 1; }
    return mem.bins.bins_alloc(&_bins, size);
}

fn gfree_(ptr as *u8) as void {
    if (_bins_ready == 1) { mem.bins.bins_free(&_bins, ptr); }
}


fn strlen(s as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (s[i] != 0) {
        i = i + 1;
    }
    return i;
}

fn print(s as *u8) as void {
    io._write_fd(1, s, strlen(s));
}

fn eprint(s as *u8) as void {
    io._write_fd(2, s, strlen(s));
}

fn write_nl(fd as i64) as void {
    let is [1]u8 as b;
    b[0] = 10;
    io._write_fd(fd, &b, 1);
}

fn write_quote(fd as i64) as void {
    let is [1]u8 as b;
    b[0] = 34;
    io._write_fd(fd, &b, 1);
}

fn streq_lit(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] != 0) { return 0; }
    return 1;
}

// copy n bytes from src into a new null-terminated string
fn str_dup(src as *u8, n as i32) as *u8 {
    let is *u8 as buf = galloc_(cast(i64, n) + 1);
    mem.memcpy(buf, src, cast(i64, n));
    buf[n] = 0;
    return buf;
}

// concat two null-terminated strings
fn str_cat(a as *u8, b as *u8) as *u8 {
    let is i64 as a_len = strlen(a);
    let is i64 as b_len = strlen(b);
    let is *u8 as buf = galloc_(a_len + b_len + 1);
    mem.memcpy(buf, a, a_len);
    mem.memcpy(cast(*u8, cast(i64, buf) + a_len), b, b_len);
    buf[a_len + b_len] = 0;
    return buf;
}

fn str_cat3(a as *u8, b as *u8, c as *u8) as *u8 {
    let is i64 as a_len = strlen(a);
    let is i64 as b_len = strlen(b);
    let is i64 as c_len = strlen(c);
    let is i64 as total = a_len + b_len + c_len;
    let is *u8 as buf = galloc_(total + 1);
    mem.memcpy(buf, a, a_len);
    mem.memcpy(cast(*u8, cast(i64, buf) + a_len), b, b_len);
    mem.memcpy(cast(*u8, cast(i64, buf) + a_len + b_len), c, c_len);
    buf[total] = 0;
    return buf;
}

fn ends_with(s as *u8, suffix as *u8) as i32 {
    let is i64 as sl = strlen(s);
    let is i64 as fl = strlen(suffix);
    if (fl > sl) { return 0; }
    let is i64 as i with mut = 0;
    while (i < fl) {
        if (s[sl - fl + i] != suffix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn mkdir_p(path as *u8) as void {
    io.mkdir(path);
}

// create parent directory of a file path
fn mkdir_parent(path as *u8) as void {
    let is i64 as len = strlen(path);
    let is i64 as last_slash with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < len) {
        if (path[i] == 47) {
            last_slash = i;
        }
        i = i + 1;
    }
    if (last_slash >= 0) {
        let is *u8 as dir = str_dup(path, cast(i32, last_slash));
        mkdir_p(dir);
        gfree_(dir);
    }
}

// Run a shell command (Linux: /bin/sh -c "cmd"; Windows: cmd.exe /c "cmd")
// and return its exit code. Uses std/process facade for cross-platform.
fn run_cmd(cmd as *u8) as i32 {
    print("  > ");
    print(cmd);
    write_nl(1);

    if (os.current() == os.OS_LINUX) {
        let is [4]i64 as argv;
        argv[0] = cast(i64, "/bin/sh");
        argv[1] = cast(i64, "-c");
        argv[2] = cast(i64, cmd);
        argv[3] = 0;
        let is i64 as pid = proc.spawn("/bin/sh", cast(*u8, &argv));
        if (pid < 0) { eprint("error: spawn failed\n"); return 1; }
        return proc.wait_pid(pid);
    }
    if (os.current() == os.OS_WINDOWS) {
        // CreateProcessA accepts a single command-line string. We pass the
        // whole "cmd.exe /c <cmd>" as the path (lpApplicationName=NULL).
        let is i64 as cmd_len = strlen(cmd);
        let is *u8 as full = galloc_(cmd_len + 16);
        let is *u8 as prefix = "cmd.exe /c ";
        let is i64 as p_len = strlen(prefix);
        mem.memcpy(full, prefix, p_len);
        mem.memcpy(cast(*u8, cast(i64, full) + p_len), cmd, cmd_len);
        full[p_len + cmd_len] = 0;
        let is i64 as h = proc.spawn(full, cast(*u8, 0));
        gfree_(full);
        if (h == 0 - 1) { eprint("error: spawn failed\n"); return 1; }
        return proc.wait_pid(h);
    }
    return 1;
}

// find a tool in PATH. returns heap-allocated full path or the name itself
fn find_tool(name as *u8) as *u8 {
    let is *u8 as local = str_cat("./", name);
    if (io.exists(local) == 1) {
        return local;
    }
    gfree_(local);
    return name;
}

fn find_target(proj as *parser.Project, name as *u8) as *parser.Target {
    let is i32 as i with mut = 0;
    while (i < proj.target_count) {
        let is *parser.Target as t = parser.get_target(proj, i);
        let is *u8 as tname = str_dup(t.name_ptr, t.name_len);
        if (streq_lit(tname, name) == 1) {
            gfree_(tname);
            return t;
        }
        gfree_(tname);
        i = i + 1;
    }
    return cast(*parser.Target, 0);
}

fn find_script(proj as *parser.Project, name as *u8) as *parser.Script {
    let is i32 as i with mut = 0;
    while (i < proj.script_count) {
        let is *parser.Script as s = parser.get_script(proj, i);
        let is *u8 as sname = str_dup(s.name_ptr, s.name_len);
        if (streq_lit(sname, name) == 1) {
            gfree_(sname);
            return s;
        }
        gfree_(sname);
        i = i + 1;
    }
    return cast(*parser.Script, 0);
}

// extract basename from a path (after last /)
fn basename(path as *u8) as *u8 {
    let is i64 as len = strlen(path);
    let is i64 as last_slash with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < len) {
        if (path[i] == 47) {
            last_slash = i;
        }
        i = i + 1;
    }
    if (last_slash >= 0) {
        return cast(*u8, cast(i64, path) + last_slash + 1);
    }
    return path;
}

// ── Dependency resolution ──────────────────────────────────────

fn dir_exists(path as *u8) as i32 {
    return io.exists(path);
}

fn file_exists(path as *u8) as i32 {
    return io.exists(path);
}

fn read_small_file(path as *u8, out_len as *i64) as *u8 {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { *out_len = 0; return cast(*u8, 0); }
    let is *u8 as buf = galloc_(512);
    let is i64 as n with mut = io._read_fd(fd, buf, 511);
    io._close_fd(fd);
    if (n < 0) { n = 0; }
    buf[n] = 0;
    *out_len = n;
    return buf;
}

fn write_small_file(path as *u8, data as *u8, data_len as i32) as void {
    let is i64 as fd = io._open_write(path);
    if (fd < 0) { return; }
    io._write_fd(fd, data, cast(i64, data_len));
    io._close_fd(fd);
}

fn streq_n(a as *u8, a_len as i64, b as *u8, b_len as i32) as i32 {
    if (a_len != cast(i64, b_len)) { return 0; }
    let is i64 as i with mut = 0;
    while (i < a_len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Collect system libs from a dependency's Causticfile
fn collect_dep_system_libs(dep_dir as *u8) as void {
    let is *u8 as cf_path = str_cat(dep_dir, "/Causticfile");
    if (file_exists(cf_path) == 0) { return; }
    let is i64 as cf_size with mut = 0;
    let is *u8 as cf_src = read_small_file(cf_path, &cf_size);
    if (cast(i64, cf_src) == 0 || cf_size == 0) { return; }
    // mini-parse: look for system "libname" lines
    let is i64 as pos with mut = 0;
    while (pos < cf_size) {
        // skip whitespace
        while (pos < cf_size && (cf_src[pos] == 32 || cf_src[pos] == 10 || cf_src[pos] == 13 || cf_src[pos] == 9)) {
            pos = pos + 1;
        }
        if (pos >= cf_size) { return; }
        // check if "system"
        if (pos + 6 < cf_size && cf_src[pos] == 115 && cf_src[pos + 1] == 121 && cf_src[pos + 2] == 115 && cf_src[pos + 3] == 116 && cf_src[pos + 4] == 101 && cf_src[pos + 5] == 109) {
            pos = pos + 6;
            // skip whitespace
            while (pos < cf_size && (cf_src[pos] == 32 || cf_src[pos] == 9)) { pos = pos + 1; }
            // expect "
            if (pos < cf_size && cf_src[pos] == 34) {
                pos = pos + 1;
                let is i64 as start = pos;
                while (pos < cf_size && cf_src[pos] != 34) { pos = pos + 1; }
                let is i32 as lib_len = cast(i32, pos - start);
                if (parser.system_lib_count < 16) {
                    let is *u8 as lib_copy = str_dup(cast(*u8, cast(i64, cf_src) + start), lib_len);
                    parser.system_lib_ptrs[parser.system_lib_count] = cast(i64, lib_copy);
                    parser.system_lib_lens[parser.system_lib_count] = lib_len;
                    parser.system_lib_count = parser.system_lib_count + 1;
                }
                if (pos < cf_size) { pos = pos + 1; }
            }
        } else {
            // skip to next line
            while (pos < cf_size && cf_src[pos] != 10) { pos = pos + 1; }
            if (pos < cf_size) { pos = pos + 1; }
        }
    }
}

fn check_git() as i32 {
    // Check if git is available (try "git --version")
    let is i32 as rc = run_cmd("git --version > /dev/null 2>&1");
    if (rc != 0) {
        eprint("error: git is required for dependencies");
        write_nl(2);
        return 1;
    }
    return 0;
}

fn resolve_deps(t as *parser.Target) as i32 {
    let is *parser.Dep as dep with mut = cast(*parser.Dep, t.deps);
    if (cast(i64, dep) == 0) { return 0; }

    // Check git availability before trying to clone
    let is i32 as need_clone with mut = 0;
    let is *parser.Dep as check with mut = dep;
    while (cast(i64, check) != 0) {
        let is *u8 as check_name = str_dup(check.name_ptr, check.name_len);
        let is *u8 as check_dir = str_cat(".caustic/deps/", check_name);
        if (dir_exists(check_dir) == 0) { need_clone = 1; }
        check = cast(*parser.Dep, check.next);
    }
    if (need_clone == 1) {
        if (check_git() != 0) { return 1; }
    }

    while (cast(i64, dep) != 0) {
        let is *u8 as dep_name = str_dup(dep.name_ptr, dep.name_len);
        let is *u8 as dep_dir = str_cat(".caustic/deps/", dep_name);

        // Check tag pinning — if tag changed, re-clone
        if (dep.tag_len > 0 && dir_exists(dep_dir) == 1) {
            let is *u8 as tag_file = str_cat(dep_dir, "/.caustic-tag");
            if (file_exists(tag_file) == 1) {
                let is i64 as stored_len with mut = 0;
                let is *u8 as stored_tag = read_small_file(tag_file, &stored_len);
                if (streq_n(stored_tag, stored_len, dep.tag_ptr, dep.tag_len) == 0) {
                    // tag changed — remove and re-clone
                    let is *u8 as rm_cmd = str_cat("rm -rf ", dep_dir);
                    run_cmd(rm_cmd);
                }
            }
        }

        if (dep.url_len == 0) {
            eprint("error: dependency has no url (missing 'in' clause)\n");
            return 1;
        }
        if (dir_exists(dep_dir) == 0) {
            // Clone
            mkdir_p(".caustic");
            mkdir_p(".caustic/deps");
            let is *u8 as cmd with mut = str_cat("git clone --depth 1 ", "");
            if (dep.tag_len > 0) {
                let is *u8 as tag_str = str_dup(dep.tag_ptr, dep.tag_len);
                cmd = str_cat3(cmd, "--branch ", tag_str);
                cmd = str_cat(cmd, " ");
            }
            let is *u8 as url_str = str_dup(dep.url_ptr, dep.url_len);
            cmd = str_cat3(cmd, url_str, " ");
            cmd = str_cat(cmd, dep_dir);

            let is i32 as rc = run_cmd(cmd);
            if (rc != 0) {
                eprint("error: failed to clone dependency '");
                io._write_fd(2, dep.name_ptr, cast(i64, dep.name_len));
                eprint("'");
                write_nl(2);
                return 1;
            }

            // Write tag file
            if (dep.tag_len > 0) {
                let is *u8 as tag_file = str_cat(dep_dir, "/.caustic-tag");
                write_small_file(tag_file, dep.tag_ptr, dep.tag_len);
            }
        }

        // Collect system libs from dependency
        collect_dep_system_libs(dep_dir);

        dep = cast(*parser.Dep, dep.next);
    }
    return 0;
}

// ── Build pipeline ────────────────────────────────────────────

fn _generate_version(proj as *parser.Project, src as *u8) as void {
    if (proj.version_len == 0) { return; }
    // Find src directory: "src/main.cst" → "src/"
    let is i64 as slen = strlen(src);
    let is i64 as si with mut = slen - 1;
    while (si >= 0 && src[si] != 47) { si = si - 1; }
    if (si < 0) { return; }
    // Build path: dir + "/version.cst"
    let is [512]u8 as path;
    let is i64 as pi with mut = 0;
    while (pi <= si) { path[pi] = src[pi]; pi = pi + 1; }
    let is *u8 as suffix = "version.cst";
    let is i64 as sui with mut = 0;
    while (suffix[sui] != 0) { path[pi] = suffix[sui]; pi = pi + 1; sui = sui + 1; }
    path[pi] = 0;
    // Build content: let is *u8 as VERSION with imut = "X.Y.Z";\n
    let is [256]u8 as content;
    let is *u8 as pre = "let is *u8 as VERSION with imut = \"";
    let is i64 as ci with mut = 0;
    let is i64 as ki with mut = 0;
    while (pre[ki] != 0) { content[ci] = pre[ki]; ci = ci + 1; ki = ki + 1; }
    ki = 0;
    while (ki < cast(i64, proj.version_len)) {
        content[ci] = proj.version_ptr[ki]; ci = ci + 1; ki = ki + 1;
    }
    let is *u8 as post = "\";\n";
    ki = 0;
    while (post[ki] != 0) { content[ci] = post[ki]; ci = ci + 1; ki = ki + 1; }
    content[ci] = 0;
    write_small_file(cast(*u8, &path), cast(*u8, &content), cast(i32, ci));
}

fn run_pipeline(t as *parser.Target, proj as *parser.Project) as i32 {
    let is *u8 as src = str_dup(t.src_ptr, t.src_len);
    let is *u8 as target_name = str_dup(t.name_ptr, t.name_len);

    // Generate version.cst from Causticfile version
    _generate_version(proj, src);

    // find caustic (includes assembler+linker via -o)
    let is *u8 as caustic_bin = find_tool("caustic");

    // 1. mkdir .caustic (cache dir)
    mkdir_p(".caustic");

    // 2. determine output path
    let is *u8 as out_path with mut;
    if (t.has_out == 1) {
        out_path = str_dup(t.out_ptr, t.out_len);
    } else {
        mkdir_p("build");
        out_path = str_cat("build/", target_name);
        eprint("warning: no 'out' specified for target '");
        io._write_fd(2, t.name_ptr, cast(i64, t.name_len));
        eprint("', using ");
        eprint(out_path);
        write_nl(2);
    }

    // 2b. CSE auto-extension: pure→.cse, compat/bundle→.exe (PE polyglot),
    //     or the explicit `extension` key. Skipped if out_path already has it.
    if (t.mode_len > 0) {
        let is *u8 as ext with mut = ".exe";
        if (t.extension_len > 0) {
            ext = str_cat(".", str_dup(t.extension_ptr, t.extension_len));
        } else if (streq_n(t.mode_ptr, cast(i64, t.mode_len), "pure", 4) == 1) {
            ext = ".cse";
        }
        if (ends_with(out_path, ext) == 0) {
            out_path = str_cat(out_path, ext);
        }
    }

    // 3. ensure output directory exists
    mkdir_parent(out_path);

    // 4. link to temp first, then rename (avoids overwriting running binary)
    let is *u8 as tmp_out = str_cat(out_path, ".tmp");

    // 5. compile+assemble+link in one step: caustic <src> -o <tmp_out> --cache .caustic [flags] [--path ...] [-l...]
    let is *u8 as cmd with mut = str_cat3(caustic_bin, " ", src);
    cmd = str_cat3(cmd, " -o ", tmp_out);
    cmd = str_cat(cmd, " --cache .caustic");
    if (t.flags_len > 0) {
        let is *u8 as flags = str_dup(t.flags_ptr, t.flags_len);
        cmd = str_cat3(cmd, " ", flags);
    }
    // CSE output mode / extension (only meaningful with --target=caustic-x86_64,
    // which is supplied via `flags`). Inert for ELF/PE targets.
    if (t.mode_len > 0) {
        let is *u8 as mode_v = str_dup(t.mode_ptr, t.mode_len);
        cmd = str_cat3(cmd, " --mode=", mode_v);
    }
    if (t.extension_len > 0) {
        let is *u8 as ext_v = str_dup(t.extension_ptr, t.extension_len);
        cmd = str_cat3(cmd, " --extension=", ext_v);
    }
    if (t.allow_unsupported == 1) {
        cmd = str_cat(cmd, " --allow-unsupported");
    }
    // Embed the project version (Causticfile `version`) into the binary.
    if (proj.version_len > 0) {
        let is *u8 as ver_v = str_dup(proj.version_ptr, proj.version_len);
        cmd = str_cat3(cmd, " --app-version=", ver_v);
    }
    // append --path for each dependency
    let is *parser.Dep as pd with mut = cast(*parser.Dep, t.deps);
    while (cast(i64, pd) != 0) {
        let is *u8 as pd_name = str_dup(pd.name_ptr, pd.name_len);
        let is *u8 as pd_dir = str_cat(".caustic/deps/", pd_name);
        cmd = str_cat3(cmd, " --path ", pd_dir);
        pd = cast(*parser.Dep, pd.next);
    }
    // append -l for each system lib
    let is i32 as sli with mut = 0;
    while (sli < parser.system_lib_count) {
        let is *u8 as lib_name = str_dup(cast(*u8, parser.system_lib_ptrs[sli]), parser.system_lib_lens[sli]);
        cmd = str_cat3(cmd, " -l", lib_name);
        sli = sli + 1;
    }
    let is i32 as rc = run_cmd(cmd);
    if (rc != 0) {
        eprint("error: build failed");
        write_nl(2);
        return rc;
    }

    // 6. rename tmp -> final
    io.unlink(out_path);
    io.rename(tmp_out, out_path);

    print("  built: ");
    print(out_path);
    write_nl(1);
    return 0;
}

fn exec_build(proj as *parser.Project, target_name as *u8, continue_flag as i32) as i32 {
    let is *parser.Target as t = find_target(proj, target_name);
    if (cast(i64, t) == 0) {
        eprint("error: target '");
        eprint(target_name);
        eprint("' not found");
        write_nl(2);
        return 1;
    }

    // resolve target depends (another target)
    if (t.depends_len > 0) {
        let is *u8 as dep_name = str_dup(t.depends_ptr, t.depends_len);
        let is i32 as rc = exec_build(proj, dep_name, continue_flag);
        if (rc != 0 && continue_flag == 0) {
            return rc;
        }
    }

    // resolve external dependencies (git clone + system libs)
    let is i32 as dep_rc = resolve_deps(t);
    if (dep_rc != 0) { return dep_rc; }

    print("building target: ");
    print(target_name);
    write_nl(1);

    return run_pipeline(t, proj);
}

fn run_script(proj as *parser.Project, scr as *parser.Script) as i32 {
    let is i32 as i with mut = 0;
    while (i < scr.cmd_count) {
        let is *parser.ScriptCmd as cmd = parser.get_script_cmd(scr, i);
        let is *u8 as cmd_str = str_dup(cmd.ptr, cmd.len);
        let is i32 as rc = run_cmd(cmd_str);
        if (rc != 0) {
            return rc;
        }
        i = i + 1;
    }
    return 0;
}

fn exec_run(proj as *parser.Project, name as *u8) as i32 {
    // check scripts first
    let is *parser.Script as scr = find_script(proj, name);
    if (cast(i64, scr) != 0) {
        return run_script(proj, scr);
    }

    // check targets - run the built binary
    let is *parser.Target as t = find_target(proj, name);
    if (cast(i64, t) != 0) {
        let is *u8 as out_path with mut;
        if (t.has_out == 1) {
            out_path = str_dup(t.out_ptr, t.out_len);
        } else {
            let is *u8 as tname = str_dup(t.name_ptr, t.name_len);
            out_path = str_cat("build/", tname);
        }
        return run_cmd(out_path);
    }

    eprint("error: '");
    eprint(name);
    eprint("' is not a script or target");
    write_nl(2);
    return 1;
}

fn exec_test(proj as *parser.Project) as i32 {
    return exec_run(proj, "test");
}

// Recursively remove a directory. Both OSes delegate to the platform's
// shell rm: simpler than re-implementing getdents64 + Win FindFirstFileA
// and the directory layout is fully managed by caustic-mk itself.
fn remove_dir(path as *u8) as void {
    if (io.exists(path) == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        let is *u8 as cmd = str_cat("rm -rf ", path);
        run_cmd(cmd);
        gfree_(cmd);
        return;
    }
    if (os.current() == os.OS_WINDOWS) {
        let is *u8 as cmd = str_cat("rmdir /s /q ", path);
        run_cmd(cmd);
        gfree_(cmd);
        return;
    }
}

fn exec_clean() as i32 {
    print("cleaning .caustic/ and build/");
    write_nl(1);
    remove_dir(".caustic");
    remove_dir("build");
    return 0;
}

fn exec_init() as i32 {
    print("project name: ");
    // read from stdin
    let is [256]u8 as name_buf;
    let is i64 as n with mut = 0;
    n = io._read_fd(0, &name_buf, 255);
    if (n <= 0) {
        eprint("error: could not read name");
        write_nl(2);
        return 1;
    }
    // strip newline
    if (n > 0 && name_buf[n - 1] == 10) {
        n = n - 1;
    }
    name_buf[n] = 0;

    // write Causticfile
    let is i64 as fd = io._open_write("Causticfile");
    if (fd < 0) {
        eprint("error: could not create Causticfile");
        write_nl(2);
        return 1;
    }

    io._write_fd(fd, "name ", 5);
    write_quote(fd);
    io._write_fd(fd, &name_buf, n);
    write_quote(fd);
    write_nl(fd);
    io._write_fd(fd, "version ", 8);
    write_quote(fd);
    io._write_fd(fd, "0.1.0", 5);
    write_quote(fd);
    write_nl(fd);
    io._write_fd(fd, "author ", 7);
    write_quote(fd);
    write_quote(fd);
    write_nl(fd);
    write_nl(fd);
    io._write_fd(fd, "target ", 7);
    write_quote(fd);
    io._write_fd(fd, &name_buf, n);
    write_quote(fd);
    io._write_fd(fd, " {", 2);
    write_nl(fd);
    io._write_fd(fd, "    src ", 8);
    write_quote(fd);
    io._write_fd(fd, "src/main.cst", 12);
    write_quote(fd);
    write_nl(fd);
    io._write_fd(fd, "}", 1);
    write_nl(fd);

    io._close_fd(fd);
    print("created Causticfile");
    write_nl(1);
    return 0;
}
