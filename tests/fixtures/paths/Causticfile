name "paths"

# One-shot: the compiler links the single object itself.
target "oneshot" {
    src "main.cst"
    out "build/oneshot"
}

# Staged: an extra `source` forces compile -> assemble -> link as three steps,
# which is a different code path in the maker (and the only one a kernel can
# use, because the one-shot mode links exactly one object).
target "staged" {
    src "main.cst"
    out "build/staged"
    source "extra.cst"
}

# Staged with a linker map: `--map` names the map after the output it was given,
# which is the maker's temp name, so the map has to follow the rename.
target "mapped" {
    src "main.cst"
    out "build/mapped"
    source "extra.cst"
    ldflags "--map"
}
