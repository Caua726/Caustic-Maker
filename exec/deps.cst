use "../../std/io.cst" as io;
use "../core/common.cst" as c;
use "../core/sysutil.cst" as sys;
use "../parser/cfile_lexer.cst" as lx;
use "../parser/parser.cst" as parser;

// ── Dependency resolution ──────────────────────────────────────
//
// The graph is walked transitively: a clone's own `depend` lines are resolved
// in turn, and theirs after that. It used to stop at exactly one level — a
// project could only reach a dependency's dependencies by re-declaring every
// one of them itself, and no library could add one without breaking every
// consumer it had.
//
// Every clone lands flat in `.caustic/deps/<declared name>/`, whatever its
// depth, so the single `--path .caustic/deps` the build already emits is what
// makes the qualified form `use "<dep>/<module>.cst"` resolve from anywhere in
// the graph. A dependency's own modules reach each other by relative path and
// need nothing added.
//
// Three consequences of that flat directory, all handled below:
//   * a name resolved once in this run is not resolved again — the dedup, and
//     also what stops a cycle (A → B → A) from cloning forever;
//   * two declarations of one name pinning different tags are an error, not a
//     race between two `git clone`s into the same directory;
//   * the root manifest outranks anything a dependency asks for — the only
//     lever a consumer has over a graph it does not own.

// How deep the walk may go before it gives up. Cycles are caught by name; this
// is the backstop for a graph that is merely absurd, or for one that renames
// its way around the name check.
let is i32 as MAX_DEP_DEPTH with imut = 32;

// One entry per dependency name resolved in this process: the tag it was
// resolved at, and who asked for that tag. `.caustic/deps/<name>` is a single
// directory, so a name can only ever be at one version.
struct Resolved {
    name_ptr as *u8;
    name_len as i32;
    tag_ptr as *u8;
    tag_len as i32;
    owner as *u8;        // null-terminated: whoever declared this tag
    is_root as i32;      // 1 when declared by this project's own Causticfile
    next as *u8;
}

let is *u8 as _resolved with mut;
let is i32 as _git_checked with mut = 0;

// Scan a dependency's Causticfile: its `system` libs go straight into the
// link, its `depend` clauses come back as a *parser.Dep list for the caller to
// resolve in turn.
//
// Through the real lexer, not a byte matcher over the raw file. `depend` and
// `depends` share their first six bytes and mean unrelated things — `depends
// "x"` orders one target against another inside a project, `depend "x" in "u"`
// names an external repository — so a six-byte match reads every build-order
// line in the manifest as a dependency with no url. The lexer also skips `#`
// and `//` comments and honours quoting, which a matcher scanning for a
// keyword at the head of a line does not.
//
// Errors carry the *dependency's* Causticfile:line:col, because lexer_init is
// given its path.
fn scan_dep_manifest(dep_dir as *u8) as *u8 {
    let is *u8 as cf_path = c.str_cat(dep_dir, "/Causticfile");
    if (sys.file_exists(cf_path) == 0) { return cast(*u8, 0); }
    // read_file, not read_small_file: that one caps at 511 bytes, so a
    // dependency whose `system` lines sat past the first half-kilobyte simply
    // never contributed its -l flags, and the link failed with undefined
    // symbols pointing nowhere near the cause. The same cap would hide any
    // `depend` line deep in a manifest.
    let is i64 as cf_size = c.read_file_size(cf_path);
    if (cf_size == 0) { return cast(*u8, 0); }
    let is *u8 as cf_src = c.read_file(cf_path);
    if (cast(i64, cf_src) == 0) { return cast(*u8, 0); }
    return scan_manifest_buf(cf_src, cf_size, cf_path);
}

// The scan itself, over a manifest already in memory — the seam the unit suite
// drives, since everything above it is a directory and a file read.
fn scan_manifest_buf(cf_src as *u8, cf_size as i64, cf_path as *u8) as *u8 {
    // The lexer is a single global state, and the root manifest has finished
    // parsing by the time anything is resolved — but save/restore anyway, the
    // same way `include` does, so this stays safe wherever it is called from.
    let is lx.LexState as saved;
    lx.lexer_save(&saved);
    lx.lexer_init(cf_src, cf_size, cf_path);

    // Appended, not prepended: the resolution order then matches the order the
    // manifest reads in, which is the order the conflict message names.
    // cf_src is mmap'd for the whole run and never freed, so the tokens'
    // pointers into it stay valid for as long as these records do.
    let is *u8 as head with mut = cast(*u8, 0);
    let is *parser.Dep as tail with mut = cast(*parser.Dep, 0);

    let is lx.Token as tok with mut = lx.next_token();
    while (tok.kind != lx.TK_EOF) {
        if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "system") == 1) {
            let is lx.Token as val = lx.next_token();
            if (val.kind == lx.TK_STRING) {
                parser.add_system_lib(c.str_dup(val.ptr, val.len), val.len);
            } else {
                lx.lexer_pushback(&val);
            }
        } else if (tok.kind == lx.TK_IDENT && c.streq(tok.ptr, tok.len, "depend") == 1) {
            let is *parser.Dep as d = _scan_depend();
            if (cast(i64, d) != 0) {
                if (cast(i64, tail) == 0) { head = cast(*u8, d); }
                else { tail.next = cast(*u8, d); }
                tail = d;
            }
        }
        tok = lx.next_token();
    }

    lx.lexer_restore(&saved);
    return head;
}

// One `depend "name" in "url" [tag "version"]` out of a dependency's manifest.
//
// Nothing here is an error: this is someone else's Causticfile, and a shape
// this doesn't recognise is that project's business to reject when it is built
// itself. A clause with no url still comes back, so the resolver can say which
// manifest it came from instead of leaving a module unresolved much later.
fn _scan_depend() as *parser.Dep {
    let is lx.Token as name = lx.next_token();
    if (name.kind != lx.TK_STRING) {
        lx.lexer_pushback(&name);
        return cast(*parser.Dep, 0);
    }
    let is *parser.Dep as dep = cast(*parser.Dep, c.galloc(sizeof(parser.Dep)));
    dep.name_ptr = name.ptr;
    dep.name_len = name.len;
    dep.url_ptr = cast(*u8, 0);
    dep.url_len = 0;
    dep.tag_ptr = cast(*u8, 0);
    dep.tag_len = 0;
    dep.next = cast(*u8, 0);

    let is lx.Token as peek with mut = lx.next_token();
    if (peek.kind == lx.TK_IDENT && c.streq(peek.ptr, peek.len, "in") == 1) {
        let is lx.Token as url = lx.next_token();
        if (url.kind == lx.TK_STRING) {
            dep.url_ptr = url.ptr;
            dep.url_len = url.len;
        } else {
            lx.lexer_pushback(&url);
        }
        peek = lx.next_token();
    }
    if (peek.kind == lx.TK_IDENT && c.streq(peek.ptr, peek.len, "tag") == 1) {
        let is lx.Token as tag = lx.next_token();
        if (tag.kind == lx.TK_STRING) {
            dep.tag_ptr = tag.ptr;
            dep.tag_len = tag.len;
        } else {
            lx.lexer_pushback(&tag);
        }
    } else {
        lx.lexer_pushback(&peek);
    }
    return dep;
}

fn _find_resolved(ptr as *u8, len as i32) as *Resolved {
    let is *Resolved as r with mut = cast(*Resolved, _resolved);
    while (cast(i64, r) != 0) {
        if (c.streq_n(ptr, cast(i64, len), r.name_ptr, r.name_len) == 1) { return r; }
        r = cast(*Resolved, r.next);
    }
    return cast(*Resolved, 0);
}

fn _register(dep as *parser.Dep, owner as *u8, is_root as i32) as void {
    let is *Resolved as r = cast(*Resolved, c.galloc(sizeof(Resolved)));
    r.name_ptr = dep.name_ptr;
    r.name_len = dep.name_len;
    r.tag_ptr = dep.tag_ptr;
    r.tag_len = dep.tag_len;
    r.owner = owner;
    r.is_root = is_root;
    r.next = _resolved;
    _resolved = cast(*u8, r);
}

fn _eprint_tag(ptr as *u8, len as i32) as void {
    if (len == 0) { c.eprint("no tag"); return; }
    c.eprint("tag \"");
    io._write_fd(2, ptr, cast(i64, len));
    c.eprint("\"");
}

// What to do about a name that has already been resolved in this run:
//   0 — leave the clone alone, this declaration is satisfied by it
//   1 — adopt this declaration's tag: drop the clone and take it again
//   2 — irreconcilable; the message has been printed
//
// The rule, in three lines: unpinned never outranks a pin, because it asks for
// nothing; between two pins the root manifest wins, which is the only lever a
// consumer has over a graph it doesn't own; two pins at the same level is the
// case nobody can silently pick from, and the one that used to be settled by
// whichever `git clone` happened to run last.
fn _reconcile(prev as *Resolved, dep as *parser.Dep, owner as *u8, is_root as i32) as i32 {
    if (dep.tag_len == 0) { return 0; }
    if (c.streq_n(dep.tag_ptr, cast(i64, dep.tag_len), prev.tag_ptr, prev.tag_len) == 1) {
        return 0;
    }
    if (prev.tag_len > 0 && prev.is_root == 1 && is_root == 0) { return 0; }
    if (prev.tag_len == 0 || (is_root == 1 && prev.is_root == 0)) {
        prev.tag_ptr = dep.tag_ptr;
        prev.tag_len = dep.tag_len;
        prev.owner = owner;
        prev.is_root = is_root;
        return 1;
    }
    c.eprint("error: dependency '");
    io._write_fd(2, dep.name_ptr, cast(i64, dep.name_len));
    c.eprint("' is required at two versions");
    c.write_nl(2);
    c.eprint("  ");
    _eprint_tag(prev.tag_ptr, prev.tag_len);
    c.eprint(" by ");
    c.eprint(prev.owner);
    c.write_nl(2);
    c.eprint("  ");
    _eprint_tag(dep.tag_ptr, dep.tag_len);
    c.eprint(" by ");
    c.eprint(owner);
    c.write_nl(2);
    // The way out differs by who disagreed: a contradiction inside one manifest
    // is the author's to remove, and pointing them at the manifest they are
    // already looking at reads as no advice at all.
    if (prev.is_root == 1 && is_root == 1) {
        c.eprint("  both are declared here — one of them has to go");
    } else {
        c.eprint("  declare it in this Causticfile to settle which one is used");
    }
    c.write_nl(2);
    return 2;
}

fn check_git() as i32 {
    // Check if git is available (try "git --version"). The redirection target
    // has to come from sys: `> /dev/null` under cmd.exe tries to create a file
    // in a directory that doesn't exist, the redirect fails, and git looked
    // absent on every Windows machine whether or not it was installed.
    //
    // Asked once per process: a transitive graph reaches this on every level
    // that has something to clone, and the answer cannot change mid-run.
    if (_git_checked == 1) { return 0; }
    let is i32 as rc = sys.run_cmd(c.str_cat("git --version", sys.silent_suffix()));
    if (rc != 0) {
        c.eprint("error: git is required for dependencies");
        c.write_nl(2);
        return 1;
    }
    _git_checked = 1;
    return 0;
}

// A target's own dependencies, then the project-wide ones.
fn resolve_deps(t as *parser.Target) as i32 {
    return _resolve_list(t.deps, "Causticfile", 0);
}

fn resolve_project_deps(proj as *parser.Project) as i32 {
    return _resolve_list(proj.deps, "Causticfile", 0);
}

fn resolve_dep_list(head as *u8) as i32 {
    return _resolve_list(head, "Causticfile", 0);
}

// `owner` names whoever declared this list — the project's own manifest at the
// top, the dependency whose manifest it came out of below that. It is what the
// version-conflict message points at, so it has to be the declarer and not the
// name being declared.
fn _resolve_list(head as *u8, owner as *u8, depth as i32) as i32 {
    let is *parser.Dep as dep with mut = cast(*parser.Dep, head);
    if (cast(i64, dep) == 0) { return 0; }

    if (depth > MAX_DEP_DEPTH) {
        c.eprint("error: dependencies nest more than ");
        c.eprint(c.u64_to_str(cast(i64, MAX_DEP_DEPTH)));
        c.eprint(" deep (reached from ");
        c.eprint(owner);
        c.eprint(")");
        c.write_nl(2);
        return 1;
    }

    let is i32 as is_root with mut = 0;
    if (depth == 0) { is_root = 1; }

    // Check git availability before trying to clone
    let is i32 as need_clone with mut = 0;
    let is *parser.Dep as check with mut = dep;
    while (cast(i64, check) != 0) {
        let is *u8 as check_name = c.str_dup(check.name_ptr, check.name_len);
        let is *u8 as check_dir = c.str_cat3(sys.DEPS_DIR, "/", check_name);
        if (sys.dir_exists(check_dir) == 0) { need_clone = 1; }
        check = cast(*parser.Dep, check.next);
    }
    if (need_clone == 1) {
        if (check_git() != 0) { return 1; }
    }

    while (cast(i64, dep) != 0) {
        let is *u8 as dep_name = c.str_dup(dep.name_ptr, dep.name_len);
        let is *u8 as dep_dir = c.str_cat3(sys.DEPS_DIR, "/", dep_name);

        // Already resolved in this run? Then the clone on disk is the one
        // answer for this name — reuse it, re-pin it, or refuse. This is also
        // the cycle stop: A → B → A finds A registered and goes no further.
        let is i32 as done with mut = 0;
        let is *Resolved as prev = _find_resolved(dep.name_ptr, dep.name_len);
        if (cast(i64, prev) != 0) {
            let is i32 as act = _reconcile(prev, dep, owner, is_root);
            if (act == 2) { return 1; }
            if (act == 0) { done = 1; }
            // act == 1: drop the clone so the adopted tag is taken below.
            if (act == 1) { sys.remove_dir(dep_dir); }
        } else {
            _register(dep, owner, is_root);
        }

        if (done == 0) {
            // Check tag pinning — if tag changed, re-clone
            if (dep.tag_len > 0 && sys.dir_exists(dep_dir) == 1) {
                let is *u8 as tag_file = c.str_cat(dep_dir, sys.TAG_SUFFIX);
                if (sys.file_exists(tag_file) == 1) {
                    let is i64 as stored_len with mut = 0;
                    let is *u8 as stored_tag = c.read_small_file(tag_file, &stored_len);
                    if (c.streq_n(stored_tag, stored_len, dep.tag_ptr, dep.tag_len) == 0) {
                        // tag changed — remove and re-clone. Through remove_dir,
                        // which picks rm/rmdir per OS: the bare `rm -rf` here made
                        // re-pinning a tag a Linux-only operation.
                        sys.remove_dir(dep_dir);
                    }
                }
            }

            if (dep.url_len == 0) {
                c.eprint("error: dependency '");
                io._write_fd(2, dep.name_ptr, cast(i64, dep.name_len));
                c.eprint("' has no url (missing 'in' clause), declared in ");
                c.eprint(owner);
                c.write_nl(2);
                return 1;
            }
            if (sys.dir_exists(dep_dir) == 0) {
                // Clone
                sys.mkdir_p(sys.CACHE_DIR);
                sys.mkdir_p(sys.DEPS_DIR);
                if (check_git() != 0) { return 1; }
                let is *u8 as cmd with mut = c.str_cat("git clone --depth 1 ", "");
                if (dep.tag_len > 0) {
                    let is *u8 as tag_str = c.str_dup(dep.tag_ptr, dep.tag_len);
                    cmd = c.str_cat3(cmd, "--branch ", tag_str);
                    cmd = c.str_cat(cmd, " ");
                }
                let is *u8 as url_str = c.str_dup(dep.url_ptr, dep.url_len);
                cmd = c.str_cat3(cmd, url_str, " ");
                cmd = c.str_cat(cmd, dep_dir);

                let is i32 as rc = sys.run_cmd(cmd);
                if (rc != 0) {
                    c.eprint("error: failed to clone dependency '");
                    io._write_fd(2, dep.name_ptr, cast(i64, dep.name_len));
                    c.eprint("'");
                    c.write_nl(2);
                    return 1;
                }

                // Write tag file
                if (dep.tag_len > 0) {
                    let is *u8 as tag_file = c.str_cat(dep_dir, sys.TAG_SUFFIX);
                    c.write_small_file(tag_file, dep.tag_ptr, dep.tag_len);
                }
            }

            // The clone's own `system` libs, and its own dependencies after
            // them: the whole point of walking past the first level.
            let is *u8 as sub = scan_dep_manifest(dep_dir);
            if (cast(i64, sub) != 0) {
                if (_resolve_list(sub, dep_name, depth + 1) != 0) { return 1; }
            }
        }

        dep = cast(*parser.Dep, dep.next);
    }
    return 0;
}
