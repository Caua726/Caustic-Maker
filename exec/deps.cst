use "../../std/io.cst" as io;
use "../core/common.cst" as c;
use "../core/sysutil.cst" as sys;
use "../parser/parser.cst" as parser;

// ── Dependency resolution ──────────────────────────────────────

// Collect system libs from a dependency's Causticfile
fn collect_dep_system_libs(dep_dir as *u8) as void {
    let is *u8 as cf_path = c.str_cat(dep_dir, "/Causticfile");
    if (sys.file_exists(cf_path) == 0) { return; }
    let is i64 as cf_size with mut = 0;
    let is *u8 as cf_src = c.read_small_file(cf_path, &cf_size);
    if (cast(i64, cf_src) == 0 || cf_size == 0) { return; }
    // mini-parse: look for system "libname" lines
    let is i64 as pos with mut = 0;
    while (pos < cf_size) {
        // skip whitespace
        while (pos < cf_size && (cf_src[pos] == 32 || cf_src[pos] == 10 || cf_src[pos] == 13 || cf_src[pos] == 9)) {
            pos = pos + 1;
        }
        if (pos >= cf_size) { return; }
        // check if "system"
        if (pos + 6 < cf_size && cf_src[pos] == 115 && cf_src[pos + 1] == 121 && cf_src[pos + 2] == 115 && cf_src[pos + 3] == 116 && cf_src[pos + 4] == 101 && cf_src[pos + 5] == 109) {
            pos = pos + 6;
            // skip whitespace
            while (pos < cf_size && (cf_src[pos] == 32 || cf_src[pos] == 9)) { pos = pos + 1; }
            // expect "
            if (pos < cf_size && cf_src[pos] == 34) {
                pos = pos + 1;
                let is i64 as start = pos;
                while (pos < cf_size && cf_src[pos] != 34) { pos = pos + 1; }
                let is i32 as lib_len = cast(i32, pos - start);
                if (parser.system_lib_count < 16) {
                    let is *u8 as lib_copy = c.str_dup(cast(*u8, cast(i64, cf_src) + start), lib_len);
                    parser.system_lib_ptrs[parser.system_lib_count] = cast(i64, lib_copy);
                    parser.system_lib_lens[parser.system_lib_count] = lib_len;
                    parser.system_lib_count = parser.system_lib_count + 1;
                }
                if (pos < cf_size) { pos = pos + 1; }
            }
        } else {
            // skip to next line
            while (pos < cf_size && cf_src[pos] != 10) { pos = pos + 1; }
            if (pos < cf_size) { pos = pos + 1; }
        }
    }
}

fn check_git() as i32 {
    // Check if git is available (try "git --version")
    let is i32 as rc = sys.run_cmd("git --version > /dev/null 2>&1");
    if (rc != 0) {
        c.eprint("error: git is required for dependencies");
        c.write_nl(2);
        return 1;
    }
    return 0;
}

fn resolve_deps(t as *parser.Target) as i32 {
    let is *parser.Dep as dep with mut = cast(*parser.Dep, t.deps);
    if (cast(i64, dep) == 0) { return 0; }

    // Check git availability before trying to clone
    let is i32 as need_clone with mut = 0;
    let is *parser.Dep as check with mut = dep;
    while (cast(i64, check) != 0) {
        let is *u8 as check_name = c.str_dup(check.name_ptr, check.name_len);
        let is *u8 as check_dir = c.str_cat3(sys.DEPS_DIR, "/", check_name);
        if (sys.dir_exists(check_dir) == 0) { need_clone = 1; }
        check = cast(*parser.Dep, check.next);
    }
    if (need_clone == 1) {
        if (check_git() != 0) { return 1; }
    }

    while (cast(i64, dep) != 0) {
        let is *u8 as dep_name = c.str_dup(dep.name_ptr, dep.name_len);
        let is *u8 as dep_dir = c.str_cat3(sys.DEPS_DIR, "/", dep_name);

        // Check tag pinning — if tag changed, re-clone
        if (dep.tag_len > 0 && sys.dir_exists(dep_dir) == 1) {
            let is *u8 as tag_file = c.str_cat(dep_dir, sys.TAG_SUFFIX);
            if (sys.file_exists(tag_file) == 1) {
                let is i64 as stored_len with mut = 0;
                let is *u8 as stored_tag = c.read_small_file(tag_file, &stored_len);
                if (c.streq_n(stored_tag, stored_len, dep.tag_ptr, dep.tag_len) == 0) {
                    // tag changed — remove and re-clone
                    let is *u8 as rm_cmd = c.str_cat("rm -rf ", dep_dir);
                    sys.run_cmd(rm_cmd);
                }
            }
        }

        if (dep.url_len == 0) {
            c.eprint("error: dependency has no url (missing 'in' clause)\n");
            return 1;
        }
        if (sys.dir_exists(dep_dir) == 0) {
            // Clone
            sys.mkdir_p(sys.CACHE_DIR);
            sys.mkdir_p(sys.DEPS_DIR);
            let is *u8 as cmd with mut = c.str_cat("git clone --depth 1 ", "");
            if (dep.tag_len > 0) {
                let is *u8 as tag_str = c.str_dup(dep.tag_ptr, dep.tag_len);
                cmd = c.str_cat3(cmd, "--branch ", tag_str);
                cmd = c.str_cat(cmd, " ");
            }
            let is *u8 as url_str = c.str_dup(dep.url_ptr, dep.url_len);
            cmd = c.str_cat3(cmd, url_str, " ");
            cmd = c.str_cat(cmd, dep_dir);

            let is i32 as rc = sys.run_cmd(cmd);
            if (rc != 0) {
                c.eprint("error: failed to clone dependency '");
                io._write_fd(2, dep.name_ptr, cast(i64, dep.name_len));
                c.eprint("'");
                c.write_nl(2);
                return 1;
            }

            // Write tag file
            if (dep.tag_len > 0) {
                let is *u8 as tag_file = c.str_cat(dep_dir, sys.TAG_SUFFIX);
                c.write_small_file(tag_file, dep.tag_ptr, dep.tag_len);
            }
        }

        // Collect system libs from dependency
        collect_dep_system_libs(dep_dir);

        dep = cast(*parser.Dep, dep.next);
    }
    return 0;
}
