use "../../std/io.cst" as io;
use "../../std/time.cst" as time;
use "../core/common.cst" as c;
use "../core/sysutil.cst" as sys;
use "deps.cst" as deps;
use "scripts.cst" as scripts;
use "../parser/parser.cst" as parser;

// `--time`: per-target and total wall clock.
let is i32 as _show_time with mut = 0;

fn set_show_time(v as i32) as void { _show_time = v; }

// `--no-deps`: build exactly the named target, assuming its `depends` are
// already built. Set for the children of a parallel `build all`, where the
// parent owns the dependency ordering — two children resolving the same
// dependency would otherwise build it twice, concurrently, into one file.
let is i32 as _no_deps with mut = 0;

fn set_no_deps(v as i32) as void { _no_deps = v; }

// ── Build pipeline ────────────────────────────────────────────

// Generate the VERSION module a target asked for with `version_file`.
//
// This used to run for EVERY target, deriving the path from the source's
// directory and writing `version.cst` there unconditionally — clobbering
// whatever was in the way, in the user's own source tree, whether or not
// anything imported it. Across the sibling projects that left twenty generated
// files behind with exactly one consumer between them. Generating source into
// someone's repository is now something a target has to ask for by name.
//
// Two other things changed: the buffers are heap-built instead of fixed [512] /
// [256] stack arrays filled by unchecked loops (a long path or version string
// wrote off the end of the frame), and an unchanged file is left alone so its
// mtime keeps meaning "last time the version actually changed" — which the
// up-to-date check depends on.
fn _write_version_file(t as *parser.Target, proj as *parser.Project) as void {
    if (t.version_file_len == 0) { return; }
    let is *u8 as path = c.str_dup(t.version_file_ptr, t.version_file_len);
    if (proj.version_len == 0) {
        c.eprint("warning: target '");
        io._write_fd(2, t.name_ptr, cast(i64, t.name_len));
        c.eprint("' declares version_file but the project has no 'version'");
        c.write_nl(2);
        return;
    }
    let is *u8 as ver = c.str_dup(proj.version_ptr, proj.version_len);
    let is *u8 as body = c.str_cat3("// generated by caustic-mk from the Causticfile 'version' — do not edit\nlet is *u8 as VERSION with imut = \"",
                                    ver, "\";\n");
    if (sys.dry_run() == 1) {
        c.print("  [dry] write ");
        c.print(path);
        c.write_nl(1);
        return;
    }
    sys.mkdir_parent(path);
    if (c.write_if_changed(path, body, cast(i32, c.strlen(body))) == 1) {
        if (sys.verbosity() >= sys.V_NORMAL) {
            c.print("  version: ");
            c.print(path);
            c.print(" = ");
            c.print(ver);
            c.write_nl(1);
        }
    }
}

// The target's final output path, with its parent directory created.
fn _prepare_output_path(t as *parser.Target, proj as *parser.Project) as *u8 {
    let is *u8 as out_path = sys.target_output_path(proj, t);
    sys.mkdir_parent(out_path);
    return out_path;
}

// " --path <dir>" for each git dependency in a list.
fn _dep_paths(head as *u8) as *u8 {
    let is *u8 as out with mut = c.str_dup("", 0);
    let is *parser.Dep as pd with mut = cast(*parser.Dep, head);
    while (cast(i64, pd) != 0) {
        let is *u8 as pd_name = c.str_dup(pd.name_ptr, pd.name_len);
        let is *u8 as pd_dir = c.str_cat3(sys.DEPS_DIR, "/", pd_name);
        out = c.str_cat3(out, " --path ", pd_dir);
        pd = cast(*parser.Dep, pd.next);
    }
    return out;
}

// Flags every compile step gets, one-shot or staged: the effective `flags`
// (project + profile + target), CSE mode/extension, allow-unsupported,
// app-version, and a --path per dependency.
fn _compile_tail(t as *parser.Target, proj as *parser.Project) as *u8 {
    let is *u8 as cmd with mut = c.str_dup("", 0);
    let is *u8 as flags = parser.eff_flags(t, proj);
    if (c.strlen(flags) > 0) { cmd = c.str_cat3(cmd, " ", flags); }
    // A command-line --target= wins over any in `flags`: it comes last, and the
    // compiler takes the last occurrence.
    if (c.strlen(sys.target_override()) > 0) {
        cmd = c.str_cat3(cmd, " --target=", sys.target_override());
    }
    // CSE output mode / extension (only meaningful with --target=caustic-x86_64).
    // Inert for ELF/PE targets.
    let is *u8 as mode_v = parser.eff_mode(t, proj);
    if (c.strlen(mode_v) > 0) { cmd = c.str_cat3(cmd, " --mode=", mode_v); }
    let is *u8 as ext_v = parser.eff_extension(t, proj);
    if (c.strlen(ext_v) > 0) { cmd = c.str_cat3(cmd, " --extension=", ext_v); }
    if (parser.eff_allow_unsupported(t, proj) == 1) {
        cmd = c.str_cat(cmd, " --allow-unsupported");
    }
    // Embed the project version (Causticfile `version`) into the binary.
    if (proj.version_len > 0) {
        let is *u8 as ver_v = c.str_dup(proj.version_ptr, proj.version_len);
        cmd = c.str_cat3(cmd, " --app-version=", ver_v);
    }
    // Dependencies: the project's shared ones, then the target's own.
    cmd = c.str_cat(cmd, _dep_paths(proj.deps));
    cmd = c.str_cat(cmd, _dep_paths(t.deps));
    return cmd;
}

// -q reaches the compiler too: it writes its progress to stderr, which we must
// not redirect (that is where real errors go), so the only way to keep a quiet
// build quiet is to ask it not to narrate.
//
// Kept OUT of _compile_tail on purpose. The tail is hashed into the object cache
// key, and verbosity does not change a single byte of generated code — with -q in
// there, running one build quiet and the next one loud threw away every cached
// object and recompiled the whole module graph.
fn _q_flag() as *u8 {
    if (sys.verbosity() <= sys.V_QUIET) { return " -q"; }
    return "";
}

// The compile tail as it goes on a `caustic` command line: semantic flags plus
// the verbosity the user asked for.
fn _compile_cmd_tail(t as *parser.Target, proj as *parser.Project) as *u8 {
    return c.str_cat(_compile_tail(t, proj), _q_flag());
}

// " -l<name>" for every `system` lib (the Causticfile's and any pulled in from
// a dependency's Causticfile). Consumed by whichever step does the linking.
fn _sys_libs() as *u8 {
    let is *u8 as out with mut = c.str_dup("", 0);
    let is i32 as sli with mut = 0;
    while (sli < parser.system_lib_count) {
        let is *u8 as lib_name = c.str_dup(parser.system_lib_ptr(sli), parser.system_lib_len(sli));
        out = c.str_cat3(out, " -l", lib_name);
        sli = sli + 1;
    }
    return out;
}

// Assemble the full `caustic <src> -o <tmp_out> ...` invocation for the
// one-shot path (compiler drives its own assembler + linker).
fn _build_compile_cmd(t as *parser.Target, proj as *parser.Project, caustic_bin as *u8, src as *u8, tmp_out as *u8) as *u8 {
    let is *u8 as cmd with mut = c.str_cat3(caustic_bin, " ", src);
    cmd = c.str_cat3(cmd, " -o ", tmp_out);
    cmd = c.str_cat3(cmd, " --cache ", sys.cache_dir());
    cmd = c.str_cat(cmd, _compile_cmd_tail(t, proj));
    cmd = c.str_cat(cmd, _sys_libs());
    return cmd;
}

// Every build step runs with the project's + the target's declared `env`
// applied, so `flags "--path $CAUSTIC_DIR/std"` and friends resolve.
fn _run_step(t as *parser.Target, proj as *parser.Project, cmd as *u8) as i32 {
    let is *u8 as full with mut = cmd;
    // -q means quiet, including the tools we drive: silencing only our own echo
    // still left the compiler's progress lines on stdout. stderr is untouched so
    // errors still surface.
    if (sys.verbosity() <= sys.V_QUIET) { full = c.str_cat(cmd, sys.quiet_suffix()); }
    return sys.run_cmd_env(full, cast(*parser.EnvVar, proj.env), cast(*parser.EnvVar, t.env),
                           cast(*i64, 0), 0);
}

// " -j N" for the compiler's own parallel emission, when the user asked for a
// specific count. Without it the compiler auto-detects, which is what we want.
fn _jobs_flag() as *u8 {
    if (sys.jobs_requested() < 1) { return ""; }
    return c.str_cat(" -j ", c.u64_to_str(cast(i64, sys.jobs_requested())));
}

// ── Up-to-date check ──────────────────────────────────────────
// `--force` (or a target with no output yet) always builds.
let is i32 as _force with mut = 0;

fn set_force(v as i32) as void { _force = v; }

// ── Why a target is (not) up to date ─────────────────────────
// The up-to-date check already knows which input tipped the decision; it just
// used to throw that away and report a bare "up to date" / rebuild. Keeping it
// is what makes `caustic-mk why <target>` possible, and costs one assignment.

let is *u8 as _why_file with mut;
let is *u8 as _why_kind with mut;
let is i64 as _why_mtime with mut = 0;
let is i32 as _why_set with mut = 0;

fn _why_reset() as void {
    _why_set = 0;
    _why_mtime = 0;
    _why_file = "";
    _why_kind = "";
}

fn _why_note(kind as *u8, path as *u8, m as i64) as void {
    _why_kind = kind;
    _why_file = path;
    _why_mtime = m;
    _why_set = 1;
}

fn _mtime_max(cur as i64, path as *u8) as i64 {
    let is i64 as m = io.mtime(path);
    if (m > cur) { return m; }
    return cur;
}

// Same, recording which file produced the new maximum. Called only when it does,
// so after the last call _why_* names the newest input seen.
fn _mtime_max_why(cur as i64, path as *u8, kind as *u8) as i64 {
    let is i64 as m = io.mtime(path);
    if (m > cur) {
        _why_note(kind, path, m);
        return m;
    }
    return cur;
}

// Newest mtime among the things the Causticfile names directly, plus the
// manifest itself and the compiler binary — change any of those and the output
// is stale no matter what the sources say.
fn _declared_newest(t as *parser.Target, proj as *parser.Project, caustic_bin as *u8) as i64 {
    let is i64 as newest with mut = 0;
    if (t.src_len > 0) {
        newest = _mtime_max_why(newest, sys.abs_path(c.str_dup(t.src_ptr, t.src_len)), "src");
    }
    let is *parser.Input as inp with mut = cast(*parser.Input, t.inputs);
    while (cast(i64, inp) != 0) {
        newest = _mtime_max_why(newest, c.str_dup(inp.path_ptr, inp.path_len), "declared input");
        inp = cast(*parser.Input, inp.next);
    }
    newest = _mtime_max_why(newest, sys.manifest_path(), "manifest");
    newest = _mtime_max_why(newest, caustic_bin, "compiler");
    return newest;
}

// Is `out_path` newer than every input that can affect it?
//
// The declared inputs are the cheap part. The hard part is a source's IMPORT
// CLOSURE — editing a module three `use`s deep has to force a rebuild — and the
// compiler only reports that closure via a `--emit-deps` pass, which costs
// about half of a full build. So the list is cached: emitted once when missing,
// then reused as a plain list of paths to stat.
//
// The cached list is dropped after each successful build (see _invalidate_deps)
// and re-emitted lazily on the next query. That keeps it honest: a list emitted
// after the last build can only be wrong about modules added since, and adding
// a `use` means editing a file the list already names — which fails the check
// anyway.
fn _up_to_date(t as *parser.Target, proj as *parser.Project, out_path as *u8,
               caustic_bin as *u8, deps_file as *u8) as i32 {
    _why_reset();
    if (_force == 1) { return 0; }
    if (sys.dry_run() == 1) { return 0; }
    if (t.src_len == 0) {
        _why_note("no src", "", 0);
        return 0;
    }
    if (sys.file_exists(out_path) == 0) {
        _why_note("missing output", out_path, 0);
        return 0;
    }
    let is i64 as out_m = io.mtime(out_path);
    if (out_m == 0) {
        _why_note("missing output", out_path, 0);
        return 0;
    }
    if (_declared_newest(t, proj, caustic_bin) >= out_m) { return 0; }

    if (sys.file_exists(deps_file) == 0) {
        let is *u8 as src = sys.abs_path(c.str_dup(t.src_ptr, t.src_len));
        let is *u8 as ec with mut = c.str_cat3(caustic_bin, " ", src);
        ec = c.str_cat3(ec, " --emit-deps ", deps_file);
        ec = c.str_cat(ec, _compile_cmd_tail(t, proj));
        ec = c.str_cat3(ec, " -q", sys.quiet_suffix());
        let is i32 as saved = sys.verbosity();
        sys.set_verbosity(sys.V_QUIET);      // bookkeeping, not a build step
        let is i32 as rc = _run_step(t, proj, ec);
        sys.set_verbosity(saved);
        if (rc != 0) { return 0; }
    }
    let is *u8 as buf = c.read_file(deps_file);
    if (cast(i64, buf) == 0) { return 0; }
    let is i64 as p with mut = 0;
    while (buf[p] != cast(u8, 0)) {
        let is i64 as start = p;
        while (buf[p] != cast(u8, 0) && buf[p] != cast(u8, 10)) { p = p + 1; }
        let is i32 as len = cast(i32, p - start);
        if (buf[p] == cast(u8, 10)) { p = p + 1; }
        if (len > 0) {
            let is *u8 as mp = c.str_dup(cast(*u8, cast(i64, buf) + start), len);
            let is i64 as mm = io.mtime(mp);
            // A module that vanished counts as changed, not as unchanged.
            if (mm == 0 || mm >= out_m) {
                if (mm == 0) { _why_note("vanished module", mp, 0); }
                else { _why_note("import closure", mp, mm); }
                return 0;
            }
        }
    }
    // Up to date. _why_* still holds the newest declared input, which is the
    // useful thing to report: "nothing is newer than the output, and the closest
    // was this".
    return 1;
}

// `why <target>` — the up-to-date decision, with the file that made it.
//
// Answers the question a bare "up to date" cannot: which input does the build
// think changed. Runs the same check a build runs (including the --emit-deps
// pass when the closure is not cached), so it can never disagree with one.
fn exec_why(proj as *parser.Project, target_name as *u8) as i32 {
    let is *parser.Target as t = sys.find_target(proj, target_name);
    if (cast(i64, t) == 0) {
        c.eprint("error: target '");
        c.eprint(target_name);
        c.eprint("' not found");
        c.write_nl(2);
        sys.suggest_target(proj, target_name);
        return 1;
    }
    if (t.src_len == 0) {
        c.print(target_name);
        c.print(": a group (only `depends`) — nothing of its own to date\n");
        return 0;
    }
    let is *u8 as out_path = sys.target_output_path(proj, t);
    let is *u8 as caustic_bin = sys.find_tool("caustic");
    let is *u8 as src = sys.abs_path(c.str_dup(t.src_ptr, t.src_len));
    let is *u8 as deps_file = _deps_file_for(src);

    // `why` must answer the real question, so --force and --dry-run cannot be
    // allowed to short-circuit the check the way they do for a build.
    let is i32 as saved_force = _force;
    _force = 0;
    let is i32 as utd = _up_to_date(t, proj, out_path, caustic_bin, deps_file);
    _force = saved_force;

    c.print(target_name);
    if (utd == 1) { c.print(": up to date\n"); } else { c.print(": rebuild needed\n"); }
    let is i64 as out_m = io.mtime(out_path);
    _why_line("out", out_path, out_m, "");
    // When the output simply is not there, a second line would repeat the first
    // and add nothing.
    if (out_m > 0 && _why_set == 1) {
        let is *u8 as label with mut = "newer";
        if (utd == 1) { label = "newest input"; }
        _why_line(label, _why_file, _why_mtime, _why_kind);
    }
    if (utd == 1) { return 0; }
    return 1;
}

// ── `graph` — the dependency tree ────────────────────────────
// The shape a build actually walks: `depends`, in declaration order, depth
// first. A cycle is marked in place instead of only surfacing as a build error
// once you try to build it.

fn _graph_tree(proj as *parser.Project, name as *u8, depth as i32) as void {
    let is i32 as pad with mut = 0;
    while (pad < depth) { c.print("  "); pad = pad + 1; }
    if (depth > 0) { c.print("└─ "); }
    c.print(name);
    let is *parser.Target as t = sys.find_target(proj, name);
    if (cast(i64, t) == 0) {
        c.print("   [missing target]");
        c.write_nl(1);
        return;
    }
    if (t.visiting == 1) {
        c.print("   [cycle]");
        c.write_nl(1);
        return;
    }
    if (t.src_len > 0) {
        c.print("   ");
        io._write_fd(io.STDOUT, t.src_ptr, cast(i64, t.src_len));
        c.print(" -> ");
        c.print(sys.target_output_path(proj, t));
    } else {
        c.print("   (group)");
    }
    c.write_nl(1);
    t.visiting = 1;
    let is *parser.Name as dn with mut = cast(*parser.Name, t.depends);
    while (cast(i64, dn) != 0) {
        _graph_tree(proj, c.str_dup(dn.ptr, dn.len), depth + 1);
        dn = cast(*parser.Name, dn.next);
    }
    t.visiting = 0;
}

// Graphviz edges. Emitted for the whole project regardless of the starting
// target, because a partial digraph is misleading in a way a partial tree is not.
fn _graph_dot(proj as *parser.Project) as void {
    c.print("digraph causticfile {\n");
    c.print("  rankdir=LR;\n");
    c.print("  node [shape=box];\n");
    let is i32 as i with mut = 0;
    while (i < proj.target_count) {
        let is *parser.Target as t = parser.get_target(proj, i);
        let is *u8 as tn = c.str_dup(t.name_ptr, t.name_len);
        // A group has no output of its own; drawing it differently is the whole
        // reason someone asks for the graph.
        if (t.src_len == 0) {
            c.print("  \""); c.print(tn); c.print("\" [style=dashed];\n");
        }
        let is *parser.Name as dn with mut = cast(*parser.Name, t.depends);
        while (cast(i64, dn) != 0) {
            c.print("  \""); c.print(tn); c.print("\" -> \"");
            c.print(c.str_dup(dn.ptr, dn.len)); c.print("\";\n");
            dn = cast(*parser.Name, dn.next);
        }
        i = i + 1;
    }
    c.print("}\n");
}

fn exec_graph(proj as *parser.Project, target_name as *u8, dot as i32) as i32 {
    if (dot == 1) {
        _graph_dot(proj);
        return 0;
    }
    if (cast(i64, target_name) != 0) {
        if (cast(i64, sys.find_target(proj, target_name)) == 0) {
            c.eprint("error: target '");
            c.eprint(target_name);
            c.eprint("' not found");
            c.write_nl(2);
            sys.suggest_target(proj, target_name);
            return 1;
        }
        _graph_tree(proj, target_name, 0);
        return 0;
    }
    if (proj.target_count == 0) {
        c.print("(no targets)\n");
        return 0;
    }
    let is i32 as i with mut = 0;
    while (i < proj.target_count) {
        let is *parser.Target as t = parser.get_target(proj, i);
        _graph_tree(proj, c.str_dup(t.name_ptr, t.name_len), 0);
        i = i + 1;
    }
    return 0;
}

fn _why_line(label as *u8, path as *u8, m as i64, kind as *u8) as void {
    c.print("  ");
    c.print(label);
    let is i64 as pad with mut = 14 - c.strlen(label);
    while (pad > 0) { c.print(" "); pad = pad - 1; }
    if (c.strlen(path) == 0) { c.print("(none)"); } else { c.print(path); }
    if (m > 0) {
        c.print("  ");
        c.print(c.fmt_unix_time(m));
    } else {
        c.print("  (does not exist)");
    }
    if (c.strlen(kind) > 0) {
        c.print("  [");
        c.print(kind);
        c.print("]");
    }
    c.write_nl(1);
}

fn _deps_file_for(src as *u8) as *u8 {
    return sys.cache_sub(c.str_cat3("deps", c.mangle_path(src), ".txt"));
}

fn _invalidate_deps(src as *u8) as void {
    io.unlink(_deps_file_for(src));
}

// Swap the temp output into place (avoids overwriting a running binary) and
// report. `rc` is the exit code of the step that produced tmp_out.
// A PE build makes caustic-ld emit CodeView data to a `.pdb` sidecar named after
// the output it was given — which is the TEMP name. So the debug file has to
// follow the rename, or every Windows build leaves a `<out>.tmp.pdb` behind and
// the `<out>.pdb` a debugger actually looks for is never created.
//
// Two candidate locations because the linker names the sidecar from the output's
// BASENAME, in the current directory, rather than beside the output itself:
// building `-o build/win/app.tmp` leaves `./app.tmp.pdb`. Both are checked so
// this keeps working if that changes.
fn _rescue_pdb(out_path as *u8, tmp_out as *u8) as void {
    let is *u8 as want = c.str_cat(out_path, ".pdb");
    let is *u8 as beside = c.str_cat(tmp_out, ".pdb");
    let is *u8 as in_cwd = c.str_cat(sys.basename(tmp_out), ".pdb");
    let is *u8 as found with mut = cast(*u8, 0);
    if (sys.file_exists(beside) == 1) { found = beside; }
    else if (sys.file_exists(in_cwd) == 1) { found = in_cwd; }
    if (cast(i64, found) != 0 && c.streq_lit(found, want) == 0) {
        io.unlink(want);
        io.rename(found, want);
    }
    _sweep_sub_pdbs(tmp_out);
}

// A universal bundle (`--target=caustic --mode=compat`) is orchestrated as
// several single-target links, and each PE sub-build drops its own `.pdb` in the
// current directory named after ITS temp output — leaving
// `<out>.tmp.__cse_pe.tmp.pdb` and `<out>.tmp.__cse_pea64.tmp.pdb` behind. Those
// belong to intermediate files that no longer exist, so nothing will ever read
// them and `clean` does not know their names.
//
// Swept by pattern rather than by listing the compiler's internal temp names,
// which are its business and free to change: anything starting with our own temp
// basename and ending in `.pdb` was produced by this build and by nothing else.
fn _sweep_sub_pdbs(tmp_out as *u8) as void {
    if (sys.dry_run() == 1) { return; }
    let is *u8 as pat = c.str_cat(sys.basename(tmp_out), "*.pdb");
    let is i32 as n = c.glob_expand(pat);
    if (n <= 0) { return; }
    // Copy the matches out before unlinking: the glob table is shared, and any
    // later expansion would overwrite it mid-loop.
    let is *u8 as buf = c.big_alloc(cast(i64, n) * 8);
    let is *i64 as arr = cast(*i64, buf);
    let is i32 as i with mut = 0;
    while (i < n) {
        arr[i] = cast(i64, c.str_cat("", c.glob_get(i)));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        io.unlink(cast(*u8, arr[i]));
        i = i + 1;
    }
    c.big_free(buf, cast(i64, n) * 8);
}

fn _finish_output(rc as i32, out_path as *u8, tmp_out as *u8) as i32 {
    if (rc != 0) {
        // Drop the partial artifact. Left behind, a stale `<out>.tmp` is both
        // litter `clean` didn't know about and a trap for anything globbing the
        // output directory.
        io.unlink(tmp_out);
        io.unlink(c.str_cat(tmp_out, ".pdb"));
        _sweep_sub_pdbs(tmp_out);
        c.eprint("error: build failed");
        c.write_nl(2);
        return rc;
    }
    if (sys.dry_run() == 1) {
        c.print("  [dry] would write ");
        c.print(out_path);
        c.write_nl(1);
        return 0;
    }
    // "built" is a claim about a FILE, so check the file is there before making
    // it. A compiler that died without writing its output used to land exactly
    // here: rc came back 0 (a signal death decodes to 0 through a bare
    // WEXITSTATUS — fixed now in std/process.exit_code_of), rename had nothing
    // to rename and said nothing about it, and the build reported success for a
    // target that did not exist. One missing binary in ninety-nine, and not one
    // line of output admitted it.
    if (io.exists(tmp_out) == 0) {
        c.eprint("error: the compile reported success but produced no ");
        c.eprint(tmp_out);
        c.write_nl(2);
        return cast(i32, 1);
    }
    io.unlink(out_path);
    io.rename(tmp_out, out_path);
    if (io.exists(out_path) == 0) {
        c.eprint("error: could not move the output into place: ");
        c.eprint(out_path);
        c.write_nl(2);
        return cast(i32, 1);
    }
    _rescue_pdb(out_path, tmp_out);
    if (sys.verbosity() >= sys.V_NORMAL) {
        c.print("  built: ");
        c.print(out_path);
        c.write_nl(1);
    }
    return 0;
}

fn run_pipeline(t as *parser.Target, proj as *parser.Project) as i32 {
    // abs_path: `src` is declared relative to the Causticfile, and the compiler
    // only resolves a source's own `../`-style `use` paths correctly when the
    // path it was handed is absolute. See sys.abs_path.
    let is *u8 as src = sys.abs_path(c.str_dup(t.src_ptr, t.src_len));

    _write_version_file(t, proj);

    // find caustic (includes assembler+linker via -o)
    let is *u8 as caustic_bin = sys.find_tool("caustic");

    // cache dir
    sys.mkdir_p(sys.cache_dir());

    let is *u8 as out_path = _prepare_output_path(t, proj);
    // link to temp first, then rename (avoids overwriting running binary)
    let is *u8 as tmp_out = c.str_cat(out_path, ".tmp");
    let is *u8 as cmd = _build_compile_cmd(t, proj, caustic_bin, src, tmp_out);
    return _finish_output(_run_step(t, proj, cmd), out_path, tmp_out);
}

// ── Staged build (multi-object targets) ───────────────────────
// The one-shot `caustic <src> -o <out>` path links exactly one object and only
// accepts flags the COMPILER knows, so it cannot express either half of what a
// kernel-shaped target needs: extra objects (hand-written .s, prebuilt .o, a
// module the main source doesn't `use`) and linker-only flags (--strip, --map,
// …, which `caustic` rejects as unknown options).
//
// A target that declares `source` / `asm` / `obj` / `ldflags` therefore runs
// the pipeline by hand, exactly as the equivalent shell script would:
//
//   caustic -c <src> <flags>          -> <src>.s
//   caustic-as <src>.s                -> <src>.s.o
//   caustic --module-only <source>    -> <source>.s        (per `source`)
//   caustic-as <source>.s             -> <source>.s.o
//   caustic-as <asm>                  -> <asm>.o           (per `asm`)
//   caustic-ld <objs…> <ldflags> -o <out>
//
// Objects reach the linker in declaration order, main source first.
fn is_staged(t as *parser.Target, proj as *parser.Project) as i32 {
    if (t.input_count > 0) { return 1; }
    if (c.strlen(parser.eff_ldflags(t, proj)) > 0) { return 1; }
    if (c.strlen(parser.eff_asflags(t, proj)) > 0) { return 1; }
    return 0;
}

// The target triple lives in `flags` (compiler-facing), but caustic-as and
// caustic-ld need it too — forward it unless the step's own flags set one. A
// command-line --target= override outranks everything.
fn _forward_triple(t as *parser.Target, proj as *parser.Project, own_flags as *u8) as *u8 {
    if (c.strlen(sys.target_override()) > 0) {
        return c.str_cat(" --target=", sys.target_override());
    }
    if (c.contains(own_flags, "--target=") == 1) { return c.str_dup("", 0); }
    let is *u8 as flags = parser.eff_flags(t, proj);
    let is *u8 as triple = c.extract_flag(flags, "--target=");
    if (cast(i64, triple) != 0) { return c.str_cat(" ", triple); }
    return c.str_dup("", 0);
}

// caustic-as <path> <asflags> [--target=…]  ->  <path>.o
// The assemble command for one file, without running it — so the serial and the
// concurrent path cannot drift apart.
fn _assemble_cmd(t as *parser.Target, proj as *parser.Project, as_bin as *u8, path as *u8) as *u8 {
    let is *u8 as asflags = parser.eff_asflags(t, proj);
    let is *u8 as cmd with mut = c.str_cat3(as_bin, " ", path);
    if (c.strlen(asflags) > 0) { cmd = c.str_cat3(cmd, " ", asflags); }
    cmd = c.str_cat(cmd, _forward_triple(t, proj, asflags));
    return cmd;
}

fn _assemble(t as *parser.Target, proj as *parser.Project, as_bin as *u8, path as *u8) as i32 {
    let is i32 as rc = _run_step(t, proj, _assemble_cmd(t, proj, as_bin, path));
    if (rc != 0) {
        c.eprint("error: assemble failed: ");
        c.eprint(path);
        c.write_nl(2);
    }
    return rc;
}

fn run_pipeline_staged(t as *parser.Target, proj as *parser.Project) as i32 {
    let is *u8 as src = sys.abs_path(c.str_dup(t.src_ptr, t.src_len));
    _write_version_file(t, proj);

    let is *u8 as caustic_bin = sys.find_tool("caustic");
    let is *u8 as as_bin = sys.find_tool("caustic-as");
    let is *u8 as ld_bin = sys.find_tool("caustic-ld");
    sys.mkdir_p(sys.cache_dir());

    let is *u8 as objs with mut = c.str_dup("", 0);

    // 1. main source: compile only, then assemble.
    if (t.src_len > 0) {
        let is *u8 as cc with mut = c.str_cat3(caustic_bin, " -c ", src);
        cc = c.str_cat3(cc, " --cache ", sys.cache_dir());
        cc = c.str_cat(cc, _compile_cmd_tail(t, proj));
        if (_run_step(t, proj, cc) != 0) {
            c.eprint("error: compile failed: ");
            c.eprint(src);
            c.write_nl(2);
            return 1;
        }
        let is *u8 as main_s = c.str_cat(src, ".s");
        if (_assemble(t, proj, as_bin, main_s) != 0) { return 1; }
        objs = c.str_cat3(objs, " ", c.str_cat(main_s, ".o"));
    }

    // 2. extra inputs, in declaration order.
    let is *u8 as extra = _extra_objects(t, proj, caustic_bin, as_bin);
    if (cast(i64, extra) == 0) { return 1; }
    objs = c.str_cat(objs, extra);

    // 3. link everything.
    return _link_objects(t, proj, ld_bin, objs, cast(*u8, 0));
}

// Build (or just collect) every extra link input a target declares, in
// declaration order, and return them as a " obj1 obj2 …" fragment. Null on
// failure — the message is already printed.
// ── Concurrent steps within one target ───────────────────────
// `-j N` used to mean "N targets at once" only. Inside a target the steps ran
// strictly one after another, even where they are independent: assembling three
// hand-written `.s` files, or compiling N `source` modules, is N processes that
// never need to see each other's output. A kernel with three `.s` inputs paid
// three serial assembler startups for no reason.
//
// The pool is the same shape as the one `build all` uses: keep up to `workers`
// children alive, reap with wait_any where the platform has it (Linux) and in
// spawn order where it does not. A failure is remembered and reported after the
// batch drains, so one bad file does not leave orphans running.
//
// Only ever handed lists whose members are genuinely independent — a compile and
// the assemble of ITS output are two batches, never one.
fn _run_batch(t as *parser.Target, proj as *parser.Project, cmds as *i64, n as i32) as i32 {
    if (n <= 0) { return 0; }
    if (n == 1) { return _run_step(t, proj, cast(*u8, cmds[0])); }
    // A dry run has nothing to overlap: print in order and stop.
    if (sys.dry_run() == 1) {
        let is i32 as di with mut = 0;
        while (di < n) {
            sys.echo_cmd(cast(*u8, cmds[di]));
            di = di + 1;
        }
        return 0;
    }

    let is i32 as workers with mut = sys.detect_jobs(n);
    if (workers < 1) { workers = 1; }
    let is *u8 as pid_buf = c.big_alloc(cast(i64, workers) * 8);
    let is *i64 as pids = cast(*i64, pid_buf);
    let is i32 as live with mut = 0;
    let is i32 as next with mut = 0;
    let is i32 as failed with mut = 0;

    while (next < n || live > 0) {
        while (live < workers && next < n && failed == 0) {
            let is *u8 as cmd = _step_cmd(cast(*u8, cmds[next]));
            sys.echo_cmd(cmd);
            let is i64 as pid = sys.spawn_cmd_env(cmd, cast(*parser.EnvVar, proj.env),
                                                 cast(*parser.EnvVar, t.env),
                                                 cast(*i64, 0), 0);
            if (pid < 0) {
                c.eprint("error: spawn failed\n");
                failed = 1;
            } else {
                pids[live] = pid;
                live = live + 1;
            }
            next = next + 1;
        }
        if (live == 0) { break; }
        let is i32 as rc with mut = 0;
        let is i64 as done_pid = sys.wait_any(&rc);
        let is i32 as slot with mut = cast(i32, 0 - 1);
        if (done_pid > 0) {
            let is i32 as si with mut = 0;
            while (si < live) {
                if (pids[si] == done_pid) { slot = si; si = live; }
                si = si + 1;
            }
        }
        // No wait-any on this platform (or it reaped a child that is not ours):
        // fall back to reaping the oldest, which is correct but lets a slow first
        // job idle the other slots.
        if (slot < 0) {
            slot = 0;
            rc = sys.wait_pid_of(pids[0]);
        }
        if (rc != 0) { failed = 1; }
        pids[slot] = pids[live - 1];
        live = live - 1;
    }

    c.big_free(pid_buf, cast(i64, workers) * 8);
    return failed;
}

// The quiet-redirect wrapper _run_step applies, factored out so the concurrent
// path builds exactly the same command string as the serial one.
fn _step_cmd(cmd as *u8) as *u8 {
    if (sys.verbosity() <= sys.V_QUIET) { return c.str_cat(cmd, sys.quiet_suffix()); }
    return cmd;
}

// Build every extra input into an object and return the link list.
//
// Two concurrent batches instead of 2N serial steps: all the `source` compiles,
// then all the assembles (of those compiles' output plus every `asm` input). The
// split is a real dependency — a module's .s has to exist before it is assembled
// — and everything within a batch is independent.
//
// The returned list stays in DECLARATION ORDER regardless of what finished first.
// Link order is part of a target's meaning (a kernel cares which object lands
// where), so it can never follow scheduling.
fn _extra_objects(t as *parser.Target, proj as *parser.Project, caustic_bin as *u8, as_bin as *u8) as *u8 {
    if (t.input_count == 0) { return c.str_dup("", 0); }

    let is i64 as slots = cast(i64, t.input_count) * 8;
    let is *u8 as cbuf = c.big_alloc(slots);      // compile commands
    let is *u8 as abuf = c.big_alloc(slots);      // assemble commands
    let is *i64 as ccmds = cast(*i64, cbuf);
    let is *i64 as acmds = cast(*i64, abuf);
    let is i32 as nc with mut = 0;
    let is i32 as na with mut = 0;
    let is *u8 as objs with mut = c.str_dup("", 0);
    let is i32 as bad with mut = 0;

    let is *parser.Input as inp with mut = cast(*parser.Input, t.inputs);
    while (cast(i64, inp) != 0 && bad == 0) {
        // IN_SRC goes to the compiler, so it needs the absolute form for the
        // same reason the main source does. IN_ASM / IN_OBJ go to caustic-as and
        // caustic-ld, which do no module resolution — left as declared.
        let is *u8 as path with mut = c.str_dup(inp.path_ptr, inp.path_len);
        if (inp.kind == parser.IN_SRC) {
            path = sys.abs_path(path);
            // --module-only: emit just this module's own functions (externs for
            // the rest). A module the main source already `use`s is compiled
            // into the main object — listing it here would duplicate symbols.
            let is *u8 as cc with mut = c.str_cat3(caustic_bin, " --module-only ", path);
            cc = c.str_cat(cc, " --cache .caustic");
            cc = c.str_cat(cc, _compile_cmd_tail(t, proj));
            ccmds[nc] = cast(i64, cc);
            nc = nc + 1;
            let is *u8 as mod_s = c.str_cat(path, ".s");
            acmds[na] = cast(i64, _assemble_cmd(t, proj, as_bin, mod_s));
            na = na + 1;
            objs = c.str_cat3(objs, " ", c.str_cat(mod_s, ".o"));
        } else if (inp.kind == parser.IN_ASM) {
            if (sys.file_exists(path) == 0) {
                c.eprint("error: asm input not found: ");
                c.eprint(path);
                c.write_nl(2);
                bad = 1;
            } else {
                acmds[na] = cast(i64, _assemble_cmd(t, proj, as_bin, path));
                na = na + 1;
                objs = c.str_cat3(objs, " ", c.str_cat(path, ".o"));
            }
        } else {
            if (sys.file_exists(path) == 0) {
                c.eprint("error: obj input not found: ");
                c.eprint(path);
                c.write_nl(2);
                bad = 1;
            } else {
                objs = c.str_cat3(objs, " ", path);
            }
        }
        inp = cast(*parser.Input, inp.next);
    }

    if (bad == 0 && _run_batch(t, proj, ccmds, nc) != 0) {
        c.eprint("error: compile failed for an extra `source` input\n");
        bad = 1;
    }
    if (bad == 0 && _run_batch(t, proj, acmds, na) != 0) {
        c.eprint("error: assemble failed for an extra input\n");
        bad = 1;
    }

    c.big_free(cbuf, slots);
    c.big_free(abuf, slots);
    if (bad == 1) { return cast(*u8, 0); }
    return objs;
}

// Link an object list into the target's output. `auto_entry` is the entry
// symbol to use when the target's own ldflags don't name one (the incremental
// path passes the main module's mangled `_main`; the staged path passes null and
// lets caustic-ld default to `main`, which is what a `-c` object exports).
fn _link_objects(t as *parser.Target, proj as *parser.Project, ld_bin as *u8,
                 objs as *u8, auto_entry as *u8) as i32 {
    let is *u8 as out_path = _prepare_output_path(t, proj);
    let is *u8 as tmp_out = c.str_cat(out_path, ".tmp");
    let is *u8 as ldflags = parser.eff_ldflags(t, proj);
    let is *u8 as lc with mut = c.str_cat(ld_bin, objs);
    if (c.strlen(ldflags) > 0) { lc = c.str_cat3(lc, " ", ldflags); }
    lc = c.str_cat(lc, _forward_triple(t, proj, ldflags));
    if (cast(i64, auto_entry) != 0 && c.contains(ldflags, "--entry=") == 0) {
        lc = c.str_cat3(lc, " --entry=", auto_entry);
    }
    // CSE mode/extension decide the linker's output flavour, so they go to the
    // link step too (the compiler only saw them for codegen).
    let is *u8 as mode_v = parser.eff_mode(t, proj);
    if (c.strlen(mode_v) > 0 && c.contains(ldflags, "--mode=") == 0) {
        lc = c.str_cat3(lc, " --mode=", mode_v);
    }
    let is *u8 as ext_v = parser.eff_extension(t, proj);
    if (c.strlen(ext_v) > 0 && c.contains(ldflags, "--extension=") == 0) {
        lc = c.str_cat3(lc, " --extension=", ext_v);
    }
    lc = c.str_cat(lc, _sys_libs());
    lc = c.str_cat3(lc, " -o ", tmp_out);
    return _finish_output(_run_step(t, proj, lc), out_path, tmp_out);
}

// ── Incremental build (separate compilation) ──────────────────
// Compile each module independently with --module-only, caching the resulting
// object by source hash under .caustic/obj/. Only changed modules recompile;
// the rest are reused, then everything is relinked. Big dev-loop win once the
// first (full) build has populated the cache.
//
// The cache key covers everything that can change an object: the module's own
// path (the compiler mangles symbols from it, so identical content at two paths
// does NOT produce interchangeable objects), its content, the compile flags in
// effect, and the compiler binary's own identity. Keying on content alone meant
// two same-content modules shared one object — with the wrong symbol names —
// and that editing `flags` or rebuilding the compiler silently reused objects
// built by the old one.
fn _obj_key(modpath as *u8, tail as *u8, tool_id as i64) as i64 {
    let is i64 as h with mut = c.hash_file(modpath);
    if (h == 0) { return 0; }
    h = c.hash_mix(h, c.hash_str(modpath));
    h = c.hash_mix(h, c.hash_str(tail));
    h = c.hash_mix(h, tool_id);
    return h;
}

// Identity of the compiler binary: mtime folded with size. Cheap, and enough to
// notice "the compiler was rebuilt" without hashing a 1.7 MB file per build.
fn _tool_id(caustic_bin as *u8) as i64 {
    let is i64 as m = io.mtime(caustic_bin);
    let is i64 as s = c.read_file_size(caustic_bin);
    return c.hash_mix(m, s);
}

// ── Object cache GC ──────────────────────────────────────────
// Every edit to a module produces a new cache key, so the object built from the
// PREVIOUS content is orphaned the moment it is superseded. Nothing ever removed
// them: `.caustic/obj/` grew by one file per edit, forever, and the only remedy
// was `clean`, which throws the whole cache away and forces a cold rebuild.
//
// The live set is exactly the keys this build linked, which the module loop
// already computes — so the sweep costs one directory listing and no hashing.

let is *u8 as _live_keys with mut;          // *i64 array
let is i32 as _live_count with mut = 0;
let is i32 as _live_cap with mut = 0;

fn _live_reset() as void { _live_count = 0; }

fn _live_add(h as i64) as void {
    if (_live_count >= _live_cap) {
        let is i32 as newcap with mut = _live_cap * 2;
        if (newcap < 64) { newcap = 64; }
        _live_keys = c.big_grow(_live_keys, cast(i64, _live_cap) * 8, cast(i64, newcap) * 8);
        _live_cap = newcap;
    }
    let is *i64 as arr = cast(*i64, _live_keys);
    arr[_live_count] = h;
    _live_count = _live_count + 1;
}

fn _live_has(h as i64) as i32 {
    let is *i64 as arr = cast(*i64, _live_keys);
    let is i32 as i with mut = 0;
    while (i < _live_count) {
        if (arr[i] == h) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Remove every object in `obj_dir` whose key this build did not use. Returns how
// many went. Only ever called after a SUCCESSFUL link, so a failed build never
// costs you a warm cache.
fn _gc_objects(obj_dir as *u8) as i32 {
    if (sys.dry_run() == 1) { return 0; }
    if (_live_count == 0) { return 0; }        // nothing linked: no ground truth
    let is i32 as n = c.glob_expand(c.path_join(obj_dir, "*.o"));
    if (n <= 0) { return 0; }
    // Copy the paths out of the shared glob table before touching the disk: the
    // table is reused by the next glob_expand anywhere in the process.
    let is *u8 as paths = c.big_alloc(cast(i64, n) * 8);
    let is *i64 as parr = cast(*i64, paths);
    let is i32 as i with mut = 0;
    while (i < n) {
        parr[i] = cast(i64, c.str_cat("", c.glob_get(i)));
        i = i + 1;
    }
    let is i32 as removed with mut = 0;
    i = 0;
    while (i < n) {
        let is *u8 as p = cast(*u8, parr[i]);
        let is *u8 as base = sys.basename(p);
        let is i64 as blen = c.strlen(base);
        // "<key>.o" -> <key>. A name that is not a decimal key is left alone:
        // the directory belongs to us, but guessing is not a reason to delete.
        if (blen > 2) {
            let is i64 as key with mut = 0;
            if (c.parse_int_strict(c.str_dup(base, cast(i32, blen - 2)), &key) == 1) {
                if (_live_has(key) == 0) {
                    if (io.unlink(p) == 0) { removed = removed + 1; }
                }
            }
        }
        i = i + 1;
    }
    c.big_free(paths, cast(i64, n) * 8);
    return removed;
}

fn run_pipeline_incremental(t as *parser.Target, proj as *parser.Project) as i32 {
    let is *u8 as src = sys.abs_path(c.str_dup(t.src_ptr, t.src_len));
    _write_version_file(t, proj);

    let is *u8 as caustic_bin = sys.find_tool("caustic");
    let is *u8 as as_bin = sys.find_tool("caustic-as");
    let is *u8 as ld_bin = sys.find_tool("caustic-ld");
    sys.mkdir_p(sys.cache_dir());
    let is *u8 as obj_dir = sys.cache_sub("obj");
    sys.mkdir_p(obj_dir);
    let is *u8 as tail = _compile_tail(t, proj);
    let is i64 as tool_id = _tool_id(caustic_bin);

    // 1. Module dependency graph + cold-build objects in ONE frontend pass.
    //    The dep list (each module's canonical path) is CACHED — it only changes
    //    when a `use` is added/removed (a missing new import → link error →
    //    `caustic-mk clean`). On a COLD build (no cached list) a single
    //    `--module-objects` process does the whole-program frontend ONCE and
    //    writes BOTH the dep list AND every object, folding the separate
    //    emit-deps frontend pass (~455 ms saved).
    //    Both the list and the batch directory are keyed on the TARGET's source:
    //    a single shared .caustic/deps.txt made a second target reuse the first
    //    one's module list (and then fail to find its entry point, or worse link
    //    the wrong program).
    let is *u8 as key = c.mangle_path(src);
    let is *u8 as deps_file = sys.cache_sub(c.str_cat3("deps", key, ".txt"));
    let is *u8 as batch_dir = sys.cache_sub(c.str_cat("batch", key));
    sys.mkdir_p(batch_dir);
    let is i32 as use_batch with mut = 0;
    if (sys.file_exists(deps_file) == 0) {
        let is *u8 as bc with mut = c.str_cat3(caustic_bin, " --module-objects ", batch_dir);
        bc = c.str_cat3(bc, " ", src);
        // The target's own compile flags apply here too — without them a target
        // that needs `--path` (module search dirs) can't resolve its imports.
        bc = c.str_cat(bc, tail);
        bc = c.str_cat(bc, _jobs_flag());
        bc = c.str_cat3(bc, " -q", sys.quiet_suffix());
        if (_run_step(t, proj, bc) != 0) { c.eprint("incremental: cold batch build failed\n"); return 1; }
        // io.rename, not `mv`: cmd.exe has no mv, so the whole incremental path
        // was silently Linux-only.
        if (io.rename(c.path_join(batch_dir, "deps.txt"), deps_file) != 0) {
            c.eprint("incremental: no deps list from batch build\n");
            return 1;
        }
        use_batch = 1;
    }
    let is *u8 as deps_buf = c.read_file(deps_file);
    if (cast(i64, deps_buf) == 0) { c.eprint("incremental: cannot read deps list\n"); return 1; }

    // Parse the dep list into an indexable array. The list is DFS pre-order
    // (root first, a module's descendants contiguously after it), so iterating it
    // in REVERSE visits dependencies before dependents (≈ topological).
    let is *u8 as csti_dir = sys.cache_sub("csti");
    sys.mkdir_p(csti_dir);
    // Sized from the list itself (one entry per line) rather than a fixed
    // [1024]: a project past the old cap silently lost its trailing modules and
    // then failed at link with undefined symbols.
    let is i64 as dline with mut = 0;
    let is i64 as dscan with mut = 0;
    while (deps_buf[dscan] != cast(u8, 0)) {
        if (deps_buf[dscan] == cast(u8, 10)) { dline = dline + 1; }
        dscan = dscan + 1;
    }
    dline = dline + 2;   // last line may lack a trailing newline
    let is *i64 as mod_off = cast(*i64, c.big_alloc(dline * 8));
    let is *i32 as mod_len = cast(*i32, c.big_alloc(dline * 4));
    let is i32 as nmod with mut = 0;
    let is i64 as p with mut = 0;
    while (deps_buf[p] != cast(u8, 0)) {
        let is i64 as start = p;
        while (deps_buf[p] != cast(u8, 0) && deps_buf[p] != cast(u8, 10)) { p = p + 1; }
        let is i32 as mlen = cast(i32, p - start);
        if (deps_buf[p] == cast(u8, 10)) { p = p + 1; }
        if (mlen > 0) { mod_off[nmod] = start; mod_len[nmod] = mlen; nmod = nmod + 1; }
    }

    // 2. SINGLE pass in dependency (topological) order. `--emit-deps` now lists
    //    modules in POST-order (dependencies before dependents), so iterating
    //    FORWARD compiles every module after its deps. For each non-cached module,
    //    ONE compiler invocation both compiles it `--module-only` (reading its
    //    already-built deps from their `.csti`, skipping their body re-analysis) AND
    //    emits its own `.csti` (`--emit-csti`) — a single analysis per module, with
    //    no source fallbacks, is what makes the first/clean build fast. The `.o` is
    //    cached by source hash; a cached module's `.csti` persists from its build.
    //
    //    STAGE3_CSTI gates the whole `.csti` mechanism. With it off, this is the
    //    plain `--module-only` per-module build (each module re-analyzes its import
    //    closure — slower first build, but no `.csti` machinery).
    //
    //    DO NOT make this loop concurrent. Its order is the point: a module reads
    //    its dependencies' `.csti`, which an EARLIER iteration wrote. Running two
    //    modules at once lets a dependent start before its dependency's interface
    //    exists — a race whose outcome is either a silent fallback to full
    //    re-analysis or a hard failure, depending on timing. The parallelism for
    //    the many-changed case belongs one level down, in the compiler's own
    //    `--module-objects` batch mode below, which knows the dependency order.
    //    (_run_batch is for genuinely independent steps: see _extra_objects.)
    let is i32 as STAGE3_CSTI with imut = 1;

    // Warm build that changed MANY modules (rare): one batch beats many
    // per-module spawns. (Cold builds already batched above; the common
    // dev-loop — a handful changed — falls through to the per-module path.)
    if (use_batch == 0) {
        let is i32 as uncached with mut = 0;
        let is i32 as ui with mut = 0;
        while (ui < nmod) {
            let is *u8 as ump = c.str_dup(cast(*u8, cast(i64, deps_buf) + mod_off[ui]), mod_len[ui]);
            let is *u8 as uob = c.path_join(obj_dir, c.str_cat(c.u64_to_str(_obj_key(ump, tail, tool_id)), ".o"));
            if (sys.file_exists(uob) == 0) { uncached = uncached + 1; }
            ui = ui + 1;
        }
        if (uncached > 8) {
            let is *u8 as bc with mut = c.str_cat3(caustic_bin, " --module-objects ", batch_dir);
            bc = c.str_cat3(bc, " ", src);
            bc = c.str_cat(bc, tail);
            bc = c.str_cat(bc, _jobs_flag());
            bc = c.str_cat3(bc, " -q", sys.quiet_suffix());
            if (_run_step(t, proj, bc) == 0) { use_batch = 1; }
        }
    }

    let is *u8 as objs with mut = c.str_dup("", 0);
    let is i32 as rebuilt with mut = 0;
    let is i32 as reused with mut = 0;
    let is i32 as ci with mut = 0;
    _live_reset();
    while (ci < nmod) {
        let is *u8 as modpath = c.str_dup(cast(*u8, cast(i64, deps_buf) + mod_off[ci]), mod_len[ci]);
        let is i64 as h = _obj_key(modpath, tail, tool_id);
        if (h == 0) {
            c.eprint("incremental: cannot read module ");
            c.eprint(modpath); c.write_nl(2);
            return 1;
        }
        _live_add(h);
        let is *u8 as obj = c.path_join(obj_dir, c.str_cat(c.u64_to_str(h), ".o"));
        if (sys.file_exists(obj) == 0) {
            if (use_batch == 1) {
                // The cold-path batch already emitted this module's object in
                // one process; move it into the key-addressed cache.
                let is *u8 as bobj with mut = c.path_join(batch_dir, c.mangle_path(modpath));
                bobj = c.str_cat(bobj, ".o");
                if (io.rename(bobj, obj) != 0) {
                    c.eprint("incremental: batch object missing: "); c.eprint(bobj); c.write_nl(2);
                    return 1;
                }
            } else {
                let is *u8 as cc with mut = c.str_cat3(caustic_bin, " --module-only ", modpath);
                if (STAGE3_CSTI == 1) { cc = c.str_cat3(cc, " --emit-csti --csti-dir ", csti_dir); }
                cc = c.str_cat(cc, tail);
                cc = c.str_cat3(cc, " -q", sys.quiet_suffix());
                if (_run_step(t, proj, cc) != 0) {
                    c.eprint("incremental: compile failed: "); c.eprint(modpath); c.write_nl(2);
                    return 1;
                }
                let is *u8 as ac with mut = c.str_cat3(as_bin, " ", modpath);
                ac = c.str_cat3(ac, ".s", sys.quiet_suffix());
                if (_run_step(t, proj, ac) != 0) {
                    c.eprint("incremental: assemble failed: "); c.eprint(modpath); c.write_nl(2);
                    return 1;
                }
                if (io.rename(c.str_cat(modpath, ".s.o"), obj) != 0) {
                    c.eprint("incremental: object not produced: "); c.eprint(modpath); c.write_nl(2);
                    return 1;
                }
            }
            rebuilt = rebuilt + 1;
        } else {
            reused = reused + 1;
        }
        objs = c.str_cat3(objs, " ", obj);
        ci = ci + 1;
    }

    // 3. The target's own extra inputs (hand-written .s, prebuilt .o, a module
    //    outside the `use` graph) join the module objects — an incremental build
    //    of a multi-object target links the same set as a staged one.
    let is *u8 as extra = _extra_objects(t, proj, caustic_bin, as_bin);
    if (cast(i64, extra) == 0) { return 1; }
    objs = c.str_cat(objs, extra);

    // 4. Link all objects. Unless `ldflags` names an entry, it's the main
    //    module's mangled `_main` (every module here was compiled --module-only).
    let is *u8 as auto_entry = c.str_cat(c.mangle_path(src), "_main");
    let is i32 as lrc = _link_objects(t, proj, ld_bin, objs, auto_entry);
    if (lrc != 0) { return lrc; }

    // 5. Drop the objects this build superseded. After the link, so a failure
    //    never costs a warm cache.
    let is i32 as swept = _gc_objects(obj_dir);

    if (sys.verbosity() < sys.V_NORMAL) { return 0; }
    c.print("incremental: ");
    c.print(c.u64_to_str(cast(i64, rebuilt)));
    c.print(" rebuilt, ");
    c.print(c.u64_to_str(cast(i64, reused)));
    c.print(" reused");
    if (swept > 0) {
        c.print(", ");
        c.print(c.u64_to_str(cast(i64, swept)));
        c.print(" stale objects removed");
    }
    c.write_nl(1);
    return 0;
}

fn exec_build(proj as *parser.Project, target_name as *u8, continue_flag as i32, incremental as i32) as i32 {
    let is *parser.Target as t = sys.find_target(proj, target_name);
    if (cast(i64, t) == 0) {
        c.eprint("error: target '");
        c.eprint(target_name);
        c.eprint("' not found");
        c.write_nl(2);
        sys.suggest_target(proj, target_name);
        return 1;
    }

    // Built already in this invocation (as another target's dependency, or an
    // earlier step of `build all`)? Nothing to redo.
    if (t.done == 1) { return 0; }

    // resolve target depends (other targets, in declaration order). `visiting`
    // catches a cycle (a depends b depends a), which would otherwise recurse
    // until the stack ran out.
    if (t.visiting == 1) {
        c.eprint("error: dependency cycle at target '");
        c.eprint(target_name);
        c.eprint("'");
        c.write_nl(2);
        return 1;
    }
    t.visiting = 1;
    let is *parser.Name as dn with mut = cast(*parser.Name, t.depends);
    if (_no_deps == 1) { dn = cast(*parser.Name, 0); }
    let is i32 as dep_failed with mut = 0;
    while (cast(i64, dn) != 0) {
        let is *u8 as dep_name = c.str_dup(dn.ptr, dn.len);
        let is i32 as rc = exec_build(proj, dep_name, continue_flag, incremental);
        if (rc != 0) {
            dep_failed = 1;
            if (continue_flag == 0) {
                t.visiting = 0;
                return rc;
            }
        }
        dn = cast(*parser.Name, dn.next);
    }
    t.visiting = 0;
    // --continue means "try the other targets too", never "pretend this one
    // worked". Building on top of a failed dependency would link stale or
    // missing objects, and the old code then returned 0 for the whole
    // invocation — a broken build reporting success.
    if (dep_failed == 1) {
        c.eprint("error: target '");
        c.eprint(target_name);
        c.eprint("' skipped: a dependency failed");
        c.write_nl(2);
        return 1;
    }

    // resolve external dependencies (git clone + system libs): the project's
    // shared ones first, then this target's own.
    if (deps.resolve_project_deps(proj) != 0) { return 1; }
    let is i32 as dep_rc = deps.resolve_deps(t);
    if (dep_rc != 0) { return dep_rc; }

    // A target with only `depends` is an aggregate ("build these"): its deps are
    // already built above, so there is nothing left to compile.
    if (t.src_len == 0 && t.input_count == 0) {
        if (cast(i64, t.depends) != 0) {
            // Mark it done as well: it "built" (its deps did), and without this
            // the `build all` summary undercounted and every later reference
            // re-resolved its dependencies.
            t.done = 1;
            return 0;
        }
        c.eprint("error: target '");
        c.eprint(target_name);
        c.eprint("' has no 'src' and no link inputs");
        c.write_nl(2);
        return 1;
    }

    // A missing source is worth saying plainly, with the target named — the
    // compiler's own "cannot read" message doesn't know which target sent it.
    if (t.src_len > 0) {
        let is *u8 as src_chk = c.str_dup(t.src_ptr, t.src_len);
        if (sys.file_exists(src_chk) == 0 && sys.file_exists(sys.abs_path(src_chk)) == 0) {
            c.eprint("error: target '");
            c.eprint(target_name);
            c.eprint("': src not found: ");
            c.eprint(src_chk);
            c.write_nl(2);
            return 1;
        }
    }

    // Nothing to do? Say so and stop — this is what makes a rebuild loop cheap.
    let is *u8 as caustic_bin = sys.find_tool("caustic");
    let is *u8 as out_now = sys.target_output_path(proj, t);
    if (t.src_len > 0) {
        let is *u8 as dfile = _deps_file_for(sys.abs_path(c.str_dup(t.src_ptr, t.src_len)));
        if (_up_to_date(t, proj, out_now, caustic_bin, dfile) == 1) {
            if (sys.verbosity() >= sys.V_NORMAL) {
                c.print("up to date: ");
                c.print(out_now);
                c.write_nl(1);
            }
            t.done = 1;
            return 0;
        }
    }

    if (sys.verbosity() >= sys.V_NORMAL) {
        c.print("building target: ");
        c.print(target_name);
        c.write_nl(1);
    }

    // `before` hooks run ahead of the compile; a failing one aborts the target.
    if (_run_hooks(proj, t.before, target_name, "before") != 0) { return 1; }

    // now_ns, not now_ms: elapsed_ms subtracts a NANOsecond stamp, so feeding it
    // milliseconds reported the epoch instead of a duration.
    let is i64 as t_start = time.now_ns();
    let is i32 as rc with mut = 0;
    if (incremental == 1) {
        rc = run_pipeline_incremental(t, proj);
    } else if (is_staged(t, proj) == 1) {
        // Extra objects or linker-only flags ⇒ drive compile/assemble/link by hand.
        rc = run_pipeline_staged(t, proj);
    } else {
        rc = run_pipeline(t, proj);
    }
    if (rc == 0) {
        t.done = 1;
        if (t.src_len > 0) {
            _invalidate_deps(sys.abs_path(c.str_dup(t.src_ptr, t.src_len)));
        }
        if (_show_time == 1) {
            c.print("  time: ");
            c.print(c.u64_to_str(time.elapsed_ms(t_start)));
            c.print(" ms");
            c.write_nl(1);
        }
        // `after` hooks run only on success — that is the point of the split.
        if (_run_hooks(proj, t.after, target_name, "after") != 0) { return 1; }
    }
    return rc;
}

// Run each script named by a `before` / `after` list, in declaration order.
fn _run_hooks(proj as *parser.Project, head as *u8, target_name as *u8, kind as *u8) as i32 {
    let is *parser.Name as n with mut = cast(*parser.Name, head);
    while (cast(i64, n) != 0) {
        let is *u8 as sname = c.str_dup(n.ptr, n.len);
        let is *parser.Script as scr = sys.find_script(proj, sname);
        if (cast(i64, scr) == 0) {
            c.eprint("error: target '");
            c.eprint(target_name);
            c.eprint("': ");
            c.eprint(kind);
            c.eprint(" names no such script: '");
            c.eprint(sname);
            c.eprint("'");
            c.write_nl(2);
            return 1;
        }
        if (sys.verbosity() >= sys.V_NORMAL) {
            c.print("  ");
            c.print(kind);
            c.print(": ");
            c.print(sname);
            c.write_nl(1);
        }
        let is i32 as rc = scripts.run_script(proj, scr, cast(*i64, 0), 0);
        if (rc != 0) {
            c.eprint("error: ");
            c.eprint(kind);
            c.eprint(" script '");
            c.eprint(sname);
            c.eprint("' failed");
            c.write_nl(2);
            return rc;
        }
        n = cast(*parser.Name, n.next);
    }
    return 0;
}

// `build all`: every target in the Causticfile, in declaration order. A target
// reached as someone else's dependency is built once (see `done`), so shared
// dependencies don't get rebuilt per consumer. Without --continue this stops at
// the first failure; with it, everything is attempted and the summary reports
// how many failed.
//
// A Causticfile that defines its own target named "all" keeps it — main.cst
// only routes here when no such target exists — so an explicit
// `target "all" { depends … }` (i.e. a group) still wins.
fn exec_build_all(proj as *parser.Project, continue_flag as i32, incremental as i32) as i32 {
    if (proj.target_count == 0) {
        c.eprint("error: no targets in Causticfile");
        c.write_nl(2);
        return 1;
    }
    let is i64 as all_start = time.now_ns();
    let is i32 as workers = sys.detect_jobs(proj.target_count);
    if (sys.verbosity() >= sys.V_NORMAL) {
        c.print("building all targets (");
        c.print(c.u64_to_str(cast(i64, proj.target_count)));
        if (workers > 1) {
            c.print(", ");
            c.print(c.u64_to_str(cast(i64, workers)));
            c.print(" jobs");
        }
        c.print(")");
        c.write_nl(1);
    }

    let is i32 as failed with mut = 0;
    if (workers > 1 && sys.dry_run() == 0) {
        failed = _build_all_parallel(proj, continue_flag, incremental, workers);
        if (failed < 0) { return 1; }
    } else {
        let is i32 as i with mut = 0;
        while (i < proj.target_count) {
            let is *parser.Target as t = parser.get_target(proj, i);
            let is *u8 as name = c.str_dup(t.name_ptr, t.name_len);
            let is i32 as rc = exec_build(proj, name, continue_flag, incremental);
            if (rc != 0) {
                failed = failed + 1;
                if (continue_flag == 0) { return rc; }
                c.eprint("  (continuing after '");
                c.eprint(name);
                c.eprint("')");
                c.write_nl(2);
            }
            i = i + 1;
        }
    }

    let is i32 as ok with mut = 0;
    let is i32 as j with mut = 0;
    while (j < proj.target_count) {
        if (parser.get_target(proj, j).done == 1) { ok = ok + 1; }
        j = j + 1;
    }
    c.print("all: ");
    c.print(c.u64_to_str(cast(i64, ok)));
    c.print(" built");
    if (failed > 0) {
        c.print(", ");
        c.print(c.u64_to_str(cast(i64, failed)));
        c.print(" failed");
    }
    if (_show_time == 1) {
        c.print(", ");
        c.print(c.u64_to_str(time.elapsed_ms(all_start)));
        c.print(" ms");
    }
    c.write_nl(1);
    if (failed > 0) { return 1; }
    return 0;
}

// ── watch ─────────────────────────────────────────────────────
// Rebuild whenever an input changes. Polls mtimes rather than using inotify:
// one code path for Linux and Windows, no fd budget, and at a 400 ms tick the
// cost is a few dozen stat calls — nothing next to a compile.
//
// The watched set is exactly the up-to-date check's input set: the manifest, the
// declared inputs, and the module import closure from the cached dep list.
fn _watch_signature(proj as *parser.Project, t as *parser.Target, caustic_bin as *u8) as i64 {
    let is i64 as sig with mut = c.hash_mix(io.mtime(sys.manifest_path()), 1);
    sig = c.hash_mix(sig, _declared_newest(t, proj, caustic_bin));
    if (t.src_len == 0) { return sig; }
    let is *u8 as dfile = _deps_file_for(sys.abs_path(c.str_dup(t.src_ptr, t.src_len)));
    if (sys.file_exists(dfile) == 0) { return sig; }
    let is *u8 as buf = c.read_file(dfile);
    if (cast(i64, buf) == 0) { return sig; }
    let is i64 as p with mut = 0;
    while (buf[p] != cast(u8, 0)) {
        let is i64 as start = p;
        while (buf[p] != cast(u8, 0) && buf[p] != cast(u8, 10)) { p = p + 1; }
        let is i32 as len = cast(i32, p - start);
        if (buf[p] == cast(u8, 10)) { p = p + 1; }
        if (len > 0) {
            let is *u8 as mp = c.str_dup(cast(*u8, cast(i64, buf) + start), len);
            sig = c.hash_mix(sig, io.mtime(mp));
        }
    }
    return sig;
}

fn exec_watch(proj as *parser.Project, target_name as *u8, continue_flag as i32,
              incremental as i32, interval_ms as i64) as i32 {
    let is *parser.Target as t = sys.find_target(proj, target_name);
    if (cast(i64, t) == 0) {
        c.eprint("error: target '");
        c.eprint(target_name);
        c.eprint("' not found");
        c.write_nl(2);
        return 1;
    }
    let is *u8 as caustic_bin = sys.find_tool("caustic");
    c.print("watching ");
    c.print(target_name);
    c.print(" (every ");
    c.print(c.u64_to_str(interval_ms));
    c.print(" ms; Ctrl-C to stop)");
    c.write_nl(1);

    exec_build(proj, target_name, continue_flag, incremental);
    let is i64 as sig with mut = _watch_signature(proj, t, caustic_bin);
    while (1 == 1) {
        time.sleep_ms(interval_ms);
        let is i64 as now = _watch_signature(proj, t, caustic_bin);
        if (now != sig) {
            sig = now;
            // A rebuild in the same process has to forget that the target was
            // already built, or `done` short-circuits every iteration.
            let is i32 as i with mut = 0;
            while (i < proj.target_count) {
                parser.get_target(proj, i).done = 0;
                i = i + 1;
            }
            c.print("---");
            c.write_nl(1);
            exec_build(proj, target_name, continue_flag, incremental);
            sig = _watch_signature(proj, t, caustic_bin);
        }
    }
    return 0;
}

// ── Parallel `build all` ──────────────────────────────────────
// Targets are built by re-invoking caustic-mk itself, one child per target,
// `workers` at a time. Re-exec rather than threads because a build step is
// already a subprocess: the child inherits nothing that needs locking, its
// output arrives as whole lines, and a crash in one target can't take the run
// with it.
//
// `depends` is honoured by building in waves: a target is only dispatched once
// every target it depends on has succeeded. The child is passed --no-deps, so it
// builds exactly the one target and never re-walks the graph (which would let
// two children build a shared dependency at the same time, into the same
// output file).
//
// Returns the number of failures, or -1 if the graph could not be drained
// (a dependency cycle).
fn _build_all_parallel(proj as *parser.Project, continue_flag as i32,
                       incremental as i32, workers as i32) as i32 {
    let is i32 as n = proj.target_count;
    // Per-target state: 0 = pending, 1 = running, 2 = done, 3 = failed/skipped.
    let is *i32 as state = cast(*i32, c.big_alloc(cast(i64, n) * 4));
    let is *i64 as pids = cast(*i64, c.big_alloc(cast(i64, n) * 8));
    let is i32 as i with mut = 0;
    while (i < n) { state[i] = 0; pids[i] = 0; i = i + 1; }

    let is i32 as failed with mut = 0;
    let is i32 as running with mut = 0;
    let is i32 as remaining with mut = n;

    while (remaining > 0) {
        // Dispatch every ready target we have room for.
        let is i32 as dispatched with mut = 0;
        i = 0;
        while (i < n && running < workers) {
            if (state[i] == 0) {
                let is i32 as dep = _dep_state(proj, parser.get_target(proj, i), state);
                if (dep == 3) {
                    // A dependency failed: this target can never run.
                    state[i] = 3;
                    failed = failed + 1;
                    remaining = remaining - 1;
                    c.eprint("error: target '");
                    io._write_fd(2, parser.get_target(proj, i).name_ptr,
                                 cast(i64, parser.get_target(proj, i).name_len));
                    c.eprint("' skipped: a dependency failed");
                    c.write_nl(2);
                } else if (dep == 2) {
                    let is i64 as pid = _spawn_target(proj, parser.get_target(proj, i), incremental);
                    if (pid < 0) { return cast(i32, 0 - 1); }
                    state[i] = 1;
                    pids[i] = pid;
                    running = running + 1;
                    dispatched = dispatched + 1;
                }
            }
            i = i + 1;
        }

        if (running == 0) {
            if (dispatched == 0) {
                c.eprint("error: dependency cycle among targets — nothing left to build");
                c.write_nl(2);
                return cast(i32, 0 - 1);
            }
        }

        // Reap one child.
        if (running > 0) {
            let is i32 as rc with mut = 0;
            let is i64 as pid = sys.wait_any(&rc);
            let is i32 as slot with mut = cast(i32, 0 - 1);
            if (pid > 0) {
                let is i32 as k with mut = 0;
                while (k < n) {
                    if (state[k] == 1 && pids[k] == pid) { slot = k; }
                    k = k + 1;
                }
            }
            if (slot < 0) {
                // No wait-any on this platform (or an unknown child): fall back
                // to reaping the first running slot in order.
                let is i32 as k2 with mut = 0;
                while (k2 < n && slot < 0) {
                    if (state[k2] == 1) { slot = k2; }
                    k2 = k2 + 1;
                }
                if (slot >= 0 && pid <= 0) { rc = sys.wait_pid_of(pids[slot]); }
            }
            if (slot >= 0) {
                running = running - 1;
                remaining = remaining - 1;
                let is *parser.Target as ft = parser.get_target(proj, slot);
                if (rc == 0) {
                    state[slot] = 2;
                    ft.done = 1;
                } else {
                    state[slot] = 3;
                    failed = failed + 1;
                    c.eprint("error: target '");
                    io._write_fd(2, ft.name_ptr, cast(i64, ft.name_len));
                    c.eprint("' failed");
                    c.write_nl(2);
                    if (continue_flag == 0) {
                        _drain(pids, state, n);
                        return failed;
                    }
                }
            }
        }
    }
    return failed;
}

// 2 = every dependency succeeded (ready), 3 = one failed, 0 = still waiting.
fn _dep_state(proj as *parser.Project, t as *parser.Target, state as *i32) as i32 {
    let is *parser.Name as dn with mut = cast(*parser.Name, t.depends);
    let is i32 as ready with mut = 2;
    while (cast(i64, dn) != 0) {
        let is *u8 as name = c.str_dup(dn.ptr, dn.len);
        let is i32 as idx = _target_index(proj, name);
        if (idx < 0) {
            c.eprint("error: target '");
            io._write_fd(2, t.name_ptr, cast(i64, t.name_len));
            c.eprint("' depends on unknown target '");
            c.eprint(name);
            c.eprint("'");
            c.write_nl(2);
            return 3;
        }
        if (state[idx] == 3) { return 3; }
        if (state[idx] != 2) { ready = 0; }
        dn = cast(*parser.Name, dn.next);
    }
    return ready;
}

fn _target_index(proj as *parser.Project, name as *u8) as i32 {
    let is i32 as i with mut = 0;
    while (i < proj.target_count) {
        let is *parser.Target as t = parser.get_target(proj, i);
        if (c.streq_n(t.name_ptr, cast(i64, t.name_len), name, cast(i32, c.strlen(name))) == 1) {
            return i;
        }
        i = i + 1;
    }
    return cast(i32, 0 - 1);
}

// One child: `caustic-mk build <name> --no-deps …`, carrying through the flags
// that change what gets built so the child agrees with the parent.
fn _spawn_target(proj as *parser.Project, t as *parser.Target, incremental as i32) as i64 {
    let is *u8 as name = c.str_dup(t.name_ptr, t.name_len);
    let is *u8 as cmd with mut = c.str_cat3(sys.quote_arg(sys.self_path()), " build ", name);
    cmd = c.str_cat(cmd, " --no-deps");
    if (incremental == 1) { cmd = c.str_cat(cmd, " --incremental"); }
    if (_force == 1) { cmd = c.str_cat(cmd, " --force"); }
    if (c.strlen(sys.target_override()) > 0) {
        cmd = c.str_cat3(cmd, " --target=", sys.target_override());
    }
    let is *parser.Profile as p = parser.active_profile();
    if (cast(i64, p) != 0) {
        cmd = c.str_cat3(cmd, " --profile ", c.str_dup(p.name_ptr, p.name_len));
    }
    // Children never nest their own parallelism.
    cmd = c.str_cat(cmd, " -j 1");
    return sys.spawn_cmd_env(cmd, cast(*parser.EnvVar, proj.env),
                             cast(*parser.EnvVar, t.env), cast(*i64, 0), 0);
}

// Wait for whatever is still running (after a failure with no --continue) so no
// child outlives the maker.
fn _drain(pids as *i64, state as *i32, n as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) {
        if (state[i] == 1) { sys.wait_pid_of(pids[i]); }
        i = i + 1;
    }
}
