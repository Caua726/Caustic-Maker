    c.print("        ')\n");
    c.print("    fi\n");
    c.print("    [ -n \"$out\" ] || out=$(_caustic_mk_from_file \"$1\")\n");
    c.print("    printf '%s\\n' \"$out\"\n");
    c.print("}\n");
    c.print("\n");
    c.print("# `set NAME \"...\"` keys from the manifest, each with the '=' already on it —\n");
    c.print("# --define wants NAME=VALUE.\n");
    c.print("_caustic_mk_vars() {\n");
    c.print("    local f\n");
    c.print("    f=$(_caustic_mk_file) || return 1\n");
    c.print("    sed -n 's/^[[:space:]]*set[[:space:]]\\{1,\\}\\([A-Za-z_][A-Za-z0-9_]*\\).*/\\1=/p' \"$f\"\n");
    c.print("}\n");
    c.print("\n");
    c.print("# What that key is set to today, offered as the starting point for an override.\n");
    c.print("_caustic_mk_var_value() {\n");
    c.print("    local f\n");
    c.print("    f=$(_caustic_mk_file) || return 1\n");
    c.print("    sed -n \"s/^[[:space:]]*set[[:space:]]\\{1,\\}$1[[:space:]]\\{1,\\}\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" \"$f\"\n");
    c.print("}\n");
    c.print("\n");
    c.print("# \"-D NAME=<value>\" and \"--define=NAME=<value>\" both arrive shredded by the '='\n");
    c.print("# in COMP_WORDBREAKS. Work out which NAME's value is being typed, if any.\n");
    c.print("_caustic_mk_define_name() {\n");
    c.print("    local i n\n");
    c.print("    if [ \"$cur\" = \"=\" ]; then\n");
    c.print("        n=$prev; i=$((COMP_CWORD-2))\n");
    c.print("    elif [ \"$prev\" = \"=\" ]; then\n");
    c.print("        n=${COMP_WORDS[COMP_CWORD-2]}; i=$((COMP_CWORD-3))\n");
    c.print("    else\n");
    c.print("        return 1\n");
    c.print("    fi\n");
    c.print("    [ \"$i\" -ge 0 ] || return 1\n");
    c.print("    [ \"${COMP_WORDS[i]}\" = \"=\" ] && i=$((i-1))\n");
    c.print("    [ \"$i\" -ge 0 ] || return 1\n");
    c.print("    case \"${COMP_WORDS[i]}\" in\n");
    c.print("        -D|--define) printf '%s\\n' \"$n\"; return 0 ;;\n");
    c.print("    esac\n");
    c.print("    return 1\n");
    c.print("}\n");
    c.print("\n");
    c.print("# How many positionals precede the cursor. Flags that swallow the next word\n");
    c.print("# have to be skipped, or `caustic-mk run --profile release <TAB>` reads\n");
    c.print("# \"release\" as the name of the script to run. Answer lands in $REPLY.\n");
    c.print("_caustic_mk_positionals() {\n");
    c.print("    local i w skip=0\n");
    c.print("    REPLY=0\n");
    c.print("    for (( i = 2; i < COMP_CWORD; i++ )); do\n");
    c.print("        w=${COMP_WORDS[i]}\n");
    c.print("        if [ \"$skip\" = 1 ]; then skip=0; continue; fi\n");
    c.print("        case \"$w\" in\n");
    c.print("            -j|--parallel|--profile|--prefix|--interval|--define|-D) skip=1 ;;\n");
    c.print("            =) ;;                       # the '=' of an --opt=value bash split\n");
    c.print("            -*) ;;\n");
    c.print("            *)  # the value half of \"--opt = value\" is not a positional either\n");
    c.print("                [ \"${COMP_WORDS[i-1]}\" = \"=\" ] || REPLY=$((REPLY+1)) ;;\n");
    c.print("        esac\n");
    c.print("    done\n");
    c.print("}\n");
    c.print("\n");
    c.print("_caustic_mk() {\n");
    c.print("    local cur prev copt cpfx cmd i dn REPLY\n");
    c.print("    local _caustic_mk_bin=$1\n");
    c.print("    __caustic_comp_init\n");
    c.print("\n");
    c.print("    local commands=\"build run test list info why graph watch install clean init doctor completions help version\"\n");
    c.print("    # main.cst reads argv[1] for these; as a later word _parse_opts rejects them.\n");
    c.print("    local global_flags=\"-h --help -V --version\"\n");
    c.print("    local flags=\"-j --parallel --incremental --continue --force --no-deps\n");
    c.print("-n --dry-run -q --quiet -v --verbose --time\n");
    c.print("--profile --prefix --define -D --target=\"\n");
    c.print("\n");
    c.print("    if [ \"$COMP_CWORD\" -eq 1 ]; then\n");
    c.print("        case \"$cur\" in\n");
    c.print("            -*) __caustic_comp_words \"$global_flags\" ;;\n");
    c.print("            *)  __caustic_comp_words \"$commands\" ;;\n");
    c.print("        esac\n");
    c.print("        return\n");
    c.print("    fi\n");
    c.print("\n");
    c.print("    cmd=${COMP_WORDS[1]}\n");
    c.print("    # Flags that belong to one command each.\n");
    c.print("    case \"$cmd\" in\n");
    c.print("        clean) flags=\"$flags --cache\" ;;\n");
    c.print("        graph) flags=\"$flags --dot\" ;;\n");
    c.print("        watch) flags=\"$flags --interval\" ;;\n");
    c.print("    esac\n");
    c.print("\n");
    c.print("    # An explicit `--` hands the rest to the child process.\n");
    c.print("    for (( i = 2; i < COMP_CWORD; i++ )); do\n");
    c.print("        if [ \"${COMP_WORDS[i]}\" = \"--\" ]; then __caustic_comp_files; return; fi\n");
    c.print("    done\n");
    c.print("\n");
    c.print("    # ...and for run/test so does each word after the name: those arguments are\n");
    c.print("    # the script's $1..$n, or the target binary's own argv, and no flag of ours\n");
    c.print("    # is parsed past that point.\n");
    c.print("    _caustic_mk_positionals\n");
    c.print("    if [ \"$REPLY\" -ge 1 ] && { [ \"$cmd\" = run ] || [ \"$cmd\" = test ]; }; then\n");
    c.print("        __caustic_comp_files\n");
    c.print("        return\n");
    c.print("    fi\n");
    c.print("\n");
    c.print("    if dn=$(_caustic_mk_define_name); then\n");
    c.print("        # On \"NAME=\" the word under the cursor is the '=' itself; readline will\n");
    c.print("        # replace what comes after it, which is nothing yet.\n");
    c.print("        [ \"$cur\" = \"=\" ] && cur=\"\"\n");
    c.print("        __caustic_comp_words \"$(_caustic_mk_var_value \"$dn\")\"\n");
    c.print("        return\n");
    c.print("    fi\n");
    c.print("\n");
    c.print("    case \"$copt\" in\n");
    c.print("        --target)\n");
    c.print("            __caustic_comp_words \"$__caustic_comp_triples\"; return ;;\n");
    c.print("        --define)\n");
    c.print("            __caustic_comp_words \"$(_caustic_mk_vars)\"\n");
    c.print("            compopt -o nospace 2>/dev/null\n");
    c.print("            return ;;\n");
    c.print("        -?*) return ;;\n");
    c.print("    esac\n");
    c.print("\n");
    c.print("    case \"$prev\" in\n");
    c.print("        --profile) __caustic_comp_words \"$(_caustic_mk_names profiles)\"; return ;;\n");
    c.print("        --prefix)  __caustic_comp_dirs; return ;;\n");
    c.print("        -j|--parallel) __caustic_comp_words \"1 2 4 8 16 32\"; return ;;\n");
    c.print("        --interval)    __caustic_comp_words \"50 100 200 400 1000 2000\"; return ;;\n");
    c.print("        --define|-D)\n");
    c.print("            # NAME= with no trailing space: the value still has to be typed.\n");
    c.print("            __caustic_comp_words \"$(_caustic_mk_vars)\"\n");
    c.print("            compopt -o nospace 2>/dev/null\n");
    c.print("            return ;;\n");
    c.print("    esac\n");
    c.print("\n");
    c.print("    case \"$cur\" in\n");
    c.print("        -*) __caustic_comp_words \"$flags\"; return ;;\n");
    c.print("    esac\n");
    c.print("\n");
    c.print("    # Every one of these takes a single name, so once it is typed there is\n");
    c.print("    # nothing left to offer (a second positional is an error).\n");
    c.print("    case \"$cmd\" in\n");
    c.print("        build|run|info|why|graph|watch|install|completions)\n");
    c.print("            [ \"$REPLY\" -eq 0 ] || { COMPREPLY=(); return; } ;;\n");
    c.print("    esac\n");
    c.print("    case \"$cmd\" in\n");
    c.print("        build)\n");
    c.print("            # `all` builds every target; a target named all would win over it.\n");
    c.print("            __caustic_comp_words \"all $(_caustic_mk_names targets)\" ;;\n");
    c.print("        run)\n");
    c.print("            __caustic_comp_words \"$(_caustic_mk_names targets) $(_caustic_mk_names scripts)\" ;;\n");
    c.print("        test)\n");
    c.print("            __caustic_comp_files ;;\n");
    c.print("        info|why|graph|watch|install)\n");
    c.print("            __caustic_comp_words \"$(_caustic_mk_names targets)\" ;;\n");
    c.print("        completions)\n");
    c.print("            __caustic_comp_words \"bash zsh\" ;;\n");
    c.print("        *)\n");
    c.print("            # list, clean, init, doctor, help and version take no positional.\n");
    c.print("            COMPREPLY=() ;;\n");
    c.print("    esac\n");
    c.print("}\n");
    c.print("\n");
    c.print("# The toolchain ships under several names: a plain ELF, a Windows .exe, and\n");
    c.print("# the CSE flavours (.cse / .cse.exe) that carry every OS and architecture in\n");
    c.print("# one file. All of them are the same program and take the same arguments.\n");
    c.print("complete -F _caustic_mk caustic-mk\n");
    c.print("complete -F _caustic_mk caustic-mk.exe\n");
    c.print("complete -F _caustic_mk caustic-mk.cse\n");
    c.print("complete -F _caustic_mk caustic-mk.cse.exe\n");
    c.print("complete -F _caustic_mk caustic-mk-universal.cse\n");
    c.print("complete -F _caustic_mk caustic-mk-universal.cse.exe\n");
}

fn emit_zsh() as void {
    c.print("#compdef caustic-mk caustic-mk.exe caustic-mk.cse caustic-mk.cse.exe caustic-mk-universal.cse caustic-mk-universal.cse.exe\n");
    c.print("# caustic-mk — zsh completion.  Commands/flags mirror caustic-maker/main.cst.\n");
    c.print("#\n");
    c.print("# Target, script and profile names come LIVE from `caustic-mk list` — and, when\n");
    c.print("# no usable binary is around, straight out of the nearest Causticfile — so\n");
    c.print("# completion always describes the project you are standing in, never a snapshot\n");
    c.print("# baked in when the script was written.\n");
    c.print("#\n");
    c.print("# install:  <prefix>/share/zsh/site-functions/_caustic-mk\n");
    c.print("#     or:   ln -s .../tools/completions/_caustic-mk  <a dir on your $fpath>\n");
    c.print("\n");
    c.print("# The nearest Causticfile, searched upward the way caustic-mk looks for it.\n");
    c.print("(( $+functions[_caustic_mk_file] )) || _caustic_mk_file() {\n");
    c.print("    local d=$PWD\n");
    c.print("    repeat 32; do\n");
    c.print("        [[ -f $d/Causticfile ]] && { print -r -- $d/Causticfile; return 0 }\n");
    c.print("        [[ $d == / ]] && return 1\n");
    c.print("        d=${d:h}\n");
    c.print("    done\n");
    c.print("    return 1\n");
    c.print("}\n");
    c.print("\n");
    c.print("# The binary being completed, if it can actually be run: `./caustic-mk build\n");
    c.print("# <TAB>` inside a checkout must describe that checkout, not whichever caustic-mk\n");
    c.print("# happens to be first on PATH.\n");
    c.print("(( $+functions[_caustic_mk_bin] )) || _caustic_mk_bin() {\n");
    c.print("    local b=${words[1]}\n");
    c.print("    if [[ $b == */* ]]; then\n");
    c.print("        [[ -x $b ]] && { print -r -- $b; return 0 }\n");
    c.print("    else\n");
    c.print("        (( $+commands[$b] )) && { print -r -- $commands[$b]; return 0 }\n");
    c.print("    fi\n");
    c.print("    return 1\n");
    c.print("}\n");
    c.print("\n");
    c.print("# `caustic-mk list`, run at most once per completion attempt.\n");
    c.print("(( $+functions[_caustic_mk_raw] )) || _caustic_mk_raw() {\n");
    c.print("    if [[ -z ${_caustic_mk_raw_out-} ]]; then\n");
    c.print("        local bin out=\"\"\n");
    c.print("        if bin=$(_caustic_mk_bin); then\n");
    c.print("            out=\"$(_call_program caustic-mk-list ${(q)bin} list 2>/dev/null)\"\n");
    c.print("        fi\n");
    c.print("        typeset -g _caustic_mk_raw_out=${out:- }\n");
    c.print("    fi\n");
    c.print("    print -r -- $_caustic_mk_raw_out\n");
    c.print("}\n");
    c.print("\n");
    c.print("# $1 = target | script | profile, straight out of the manifest. This is the\n");
    c.print("# answer for a fresh checkout with nothing built yet, or any time the binary\n");
    c.print("# cannot run.\n");
    c.print("(( $+functions[_caustic_mk_from_file] )) || _caustic_mk_from_file() {\n");
    c.print("    local f\n");
    c.print("    f=$(_caustic_mk_file) || return 1\n");
    c.print("    sed -n \"s/^[[:space:]]*$1[[:space:]]\\{1,\\}\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" $f\n");
    c.print("}\n");
    c.print("\n");
    c.print("(( $+functions[_caustic_mk_targets] )) || _caustic_mk_targets() {\n");
    c.print("    # `  name  src -> out` becomes `name:src -> out`, so the list shows what\n");
    c.print("    # each target actually builds.\n");
    c.print("    local -a t\n");
    c.print("    t=( ${(f)\"$(_caustic_mk_raw | awk '\n");
    c.print("        /^targets \\(/           { intargets = 1; next }\n");
    c.print("        intargets && /^  +[^ ]/ { name = $1; $1 = \"\"; sub(/^ +/, \"\", $0); print name \":\" $0; next }\n");
    c.print("        /^[^ ]/                 { intargets = 0 }\n");
    c.print("    ')\"} )\n");
    c.print("    t=( ${t:#} )\n");
    c.print("    (( $#t )) || t=( ${(f)\"$(_caustic_mk_from_file target)\"} )\n");
    c.print("    t=( ${t:#} )\n");
    c.print("    (( $#t )) || return 1\n");
    c.print("    _describe -t targets 'target' t\n");
    c.print("}\n");
    c.print("\n");
    c.print("(( $+functions[_caustic_mk_build_targets] )) || _caustic_mk_build_targets() {\n");
    c.print("    _alternative \\\n");
    c.print("        'all:pseudo-target:((all\\:\"build every target in the manifest\"))' \\\n");
    c.print("        'targets:target:_caustic_mk_targets'\n");
    c.print("}\n");
    c.print("\n");
    c.print("(( $+functions[_caustic_mk_scripts] )) || _caustic_mk_scripts() {\n");
    c.print("    local -a s\n");
    c.print("    s=( ${(f)\"$(_caustic_mk_raw | awk '/^scripts:/ { for (i = 2; i <= NF; i++) print $i }')\"} )\n");
    c.print("    s=( ${s:#} )\n");
    c.print("    (( $#s )) || s=( ${(f)\"$(_caustic_mk_from_file script)\"} )\n");
    c.print("    s=( ${s:#} )\n");
    c.print("    (( $#s )) || return 1\n");
    c.print("    _describe -t scripts 'script' s\n");
    c.print("}\n");
    c.print("\n");
    c.print("(( $+functions[_caustic_mk_profiles] )) || _caustic_mk_profiles() {\n");
    c.print("    local -a p\n");
    c.print("    p=( ${(f)\"$(_caustic_mk_raw | awk '/^profiles:/ { for (i = 2; i <= NF; i++) print $i }')\"} )\n");
    c.print("    p=( ${p:#} )\n");
    c.print("    (( $#p )) || p=( ${(f)\"$(_caustic_mk_from_file profile)\"} )\n");
    c.print("    p=( ${p:#} )\n");
    c.print("    (( $#p )) || return 1\n");
    c.print("    _describe -t profiles 'profile' p\n");
    c.print("}\n");
    c.print("\n");
    c.print("# `run` takes either a script's name or a target's.\n");
    c.print("(( $+functions[_caustic_mk_runnable] )) || _caustic_mk_runnable() {\n");
    c.print("    _alternative \\\n");
    c.print("        'scripts:script:_caustic_mk_scripts' \\\n");
    c.print("        'targets:target:_caustic_mk_targets'\n");
    c.print("}\n");
    c.print("\n");
    c.print("# `set NAME \"...\"` keys, offered as NAME= — and, once the '=' is typed, the\n");
    c.print("# value the manifest gives that key today.\n");
    c.print("(( $+functions[_caustic_mk_defines] )) || _caustic_mk_defines() {\n");
    c.print("    local f\n");
    c.print("    f=$(_caustic_mk_file) || return 1\n");
    c.print("    if [[ $PREFIX == *=* ]]; then\n");
    c.print("        local name=${PREFIX%%=*} val\n");
    c.print("        val=$(sed -n \"s/^[[:space:]]*set[[:space:]]\\{1,\\}$name[[:space:]]\\{1,\\}\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" $f)\n");
    c.print("        [[ -n $val ]] && _wanted values expl 'value in the manifest' compadd -- \"$name=$val\"\n");
    c.print("        return\n");
    c.print("    fi\n");
    c.print("    local -a names\n");
    c.print("    names=( ${(f)\"$(sed -n 's/^[[:space:]]*set[[:space:]]\\{1,\\}\\([A-Za-z_][A-Za-z0-9_]*\\).*/\\1/p' $f)\"} )\n");
    c.print("    names=( ${names:#} )\n");
    c.print("    (( $#names )) || return 1\n");
    c.print("    _wanted defines expl 'manifest variable' compadd -S '=' -- $names\n");
    c.print("}\n");
    c.print("\n");
    c.print("_caustic_mk() {\n");
    c.print("    typeset -g _caustic_mk_raw_out=\"\"      # one `caustic-mk list` per attempt\n");
    c.print("    local cmd=\"\" ret=1\n");
    c.print("    local curcontext=$curcontext state line\n");
    c.print("    integer i\n");
    c.print("\n");
    c.print("    # The subcommand is the first word that is neither a flag nor a flag's\n");
    c.print("    # value. Skipping the values matters: without it, `caustic-mk --profile\n");
    c.print("    # release build <TAB>` would take \"release\" for the command.\n");
    c.print("    for (( i = 2; i < CURRENT; i++ )); do\n");
    c.print("        case $words[i] in\n");
    c.print("            -j|--parallel|--profile|--prefix|--interval|--define|-D) (( i++ )) ;;\n");
    c.print("            -*) ;;\n");
    c.print("            *) cmd=$words[i]; break ;;\n");
    c.print("        esac\n");
    c.print("    done\n");
    c.print("\n");
    c.print("    local -a commands=(\n");
    c.print("        'build:build a target (all = every target)'\n");
    c.print("        'run:run a script or a target, forwarding the rest'\n");
    c.print("        'test:run the `test` script'\n");
    c.print("        'list:show targets, scripts and profiles'\n");
    c.print("        'info:print the commands a build would run'\n");
    c.print("        'why:explain the up-to-date decision'\n");
    c.print("        'graph:dependency tree (--dot for graphviz)'\n");
    c.print("        'watch:rebuild whenever an input changes'\n");
    c.print("        'install:copy the outputs to their install path'\n");
    c.print("        'clean:remove build artifacts'\n");
    c.print("        'init:write a new Causticfile here'\n");
    c.print("        'doctor:check the toolchain, the manifest and its inputs'\n");
    c.print("        'completions:emit a bash or zsh completion script'\n");
    c.print("        'help:show usage'\n");
    c.print("        'version:show the version'\n");
    c.print("    )\n");
    c.print("    local cmdnames='(build run test list info why graph watch install clean init doctor completions help version)'\n");
    c.print("\n");
    c.print("    # Flags every command parses. The three that belong to one command each are\n");
    c.print("    # added in that command's branch.\n");
    c.print("    local -a common=(\n");
    c.print("        '(-j --parallel)'{-j,--parallel}'[build N targets at once]:jobs:(1 2 4 8 16 32)'\n");
    c.print("        '--incremental[separate compilation, reuse unchanged objects]'\n");
    c.print("        '--continue[keep going when a target fails]'\n");
    c.print("        '--force[rebuild even if the outputs look up to date]'\n");
    c.print("        '--no-deps[skip git dependency resolution]'\n");
    c.print("        '(-n --dry-run)'{-n,--dry-run}'[print the commands without running them]'\n");
    c.print("        '--time[report per-target and total time]'\n");
    c.print("        '(-q --quiet -v --verbose)'{-q,--quiet}'[only errors]'\n");
    c.print("        '(-q --quiet -v --verbose)'{-v,--verbose}'[show the environment and full commands]'\n");
    c.print("        '--profile[apply a profile block from the Causticfile]:profile:_caustic_mk_profiles'\n");
    c.print("        '--prefix[install destination]:directory:_files -/'\n");
    c.print("        '*'{--define,-D}'[override a Causticfile `set`]:NAME=VALUE:_caustic_mk_defines'\n");
    c.print("        '--target=[override the target triple]:triple:((linux-x86_64\\:\"static ELF, no libc\" linux-aarch64\\:\"static ARM64 ELF\" windows-x86_64\\:\"PE/COFF .exe\" windows-aarch64\\:\"ARM64 PE — not implemented yet\" caustic\\:\"CSE container, both architectures\" caustic-x86_64\\:\"CSE image, x86_64\" caustic-aarch64\\:\"CSE image, ARM64\" caustic-x86_64-aarch64\\:\"CSE container, both architectures\" wasm32-wasi\\:\"WebAssembly, 32-bit memory\" wasm32\\:\"alias of wasm32-wasi\" wasm64-wasi\\:\"WebAssembly with memory64\" wasm64\\:\"alias of wasm64-wasi\"))'\n");
    c.print("    )\n");
    c.print("\n");
    c.print("    if [[ -z $cmd ]]; then\n");
    c.print("        # -h/--help/-V/--version are read off argv[1]; anywhere later,\n");
    c.print("        # _parse_opts rejects them as unknown flags.\n");
    c.print("        _arguments -C -S \\\n");
    c.print("            '(- *)'{-h,--help}'[show usage and exit]' \\\n");
    c.print("            '(- *)'{-V,--version}'[show the version and exit]' \\\n");
    c.print("            '1:command:->cmds' && ret=0\n");
    c.print("        if [[ $state == cmds ]]; then\n");
    c.print("            _describe -t commands 'caustic-mk command' commands && ret=0\n");
    c.print("        fi\n");
    c.print("        return ret\n");
    c.print("    fi\n");
    c.print("\n");
    c.print("    case $cmd in\n");
    c.print("        build)\n");
    c.print("            _arguments -S $common \"1:command:$cmdnames\" \\\n");
    c.print("                '2:target:_caustic_mk_build_targets' && ret=0 ;;\n");
    c.print("        run)\n");
    c.print("            _arguments -S $common \"1:command:$cmdnames\" \\\n");
    c.print("                '2:name:_caustic_mk_runnable' \\\n");
    c.print("                '*::argument:_files' && ret=0 ;;\n");
    c.print("        test)\n");
    c.print("            _arguments -S $common \"1:command:$cmdnames\" '*::argument:_files' && ret=0 ;;\n");
    c.print("        info|why|install)\n");
    c.print("            _arguments -S $common \"1:command:$cmdnames\" \\\n");
    c.print("                '2:target:_caustic_mk_targets' && ret=0 ;;\n");
    c.print("        graph)\n");
    c.print("            _arguments -S $common '--dot[emit graphviz instead of a tree]' \\\n");
    c.print("                \"1:command:$cmdnames\" '2:target:_caustic_mk_targets' && ret=0 ;;\n");
    c.print("        watch)\n");
    c.print("            _arguments -S $common '--interval[poll interval in ms]:ms:(50 100 200 400 1000 2000)' \\\n");
    c.print("                \"1:command:$cmdnames\" '2:target:_caustic_mk_targets' && ret=0 ;;\n");
    c.print("        clean)\n");
    c.print("            _arguments -S $common '--cache[remove only the cache]' \\\n");
    c.print("                \"1:command:$cmdnames\" && ret=0 ;;\n");
    c.print("        completions)\n");
    c.print("            _arguments -S \"1:command:$cmdnames\" \\\n");
    c.print("                '2:shell:((bash\\:\"a bash completion script\" zsh\\:\"a zsh completion script\"))' && ret=0 ;;\n");
    c.print("        *)\n");
    c.print("            # list, init, doctor, help and version take no positional.\n");
    c.print("            _arguments -S $common \"1:command:$cmdnames\" && ret=0 ;;\n");
    c.print("    esac\n");
    c.print("    return ret\n");
    c.print("}\n");
    c.print("\n");
    c.print("_caustic_mk \"$@\"\n");
}
