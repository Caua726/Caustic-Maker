    c.print("    esac\n");
    c.print("    [ -n \"$p\" ] || return 1\n");
    c.print("    printf '%s\\n' \"${p%/*}\"\n");
    c.print("}\n");
    c.print("\n");
    c.print("# Every triple load_target (src/codegen/target.cst) accepts, canonical + aliases.\n");
    c.print("# caustic / caustic-x86_64 / caustic-aarch64 / caustic-x86_64-aarch64 are the\n");
