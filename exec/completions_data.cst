    c.print("# The nearest Causticfile, searched upward the way caustic-mk looks for it.\n");
    c.print("_caustic_mk_file() {\n");
    c.print("    local d=\"$PWD\" i\n");
    c.print("    for (( i = 0; i < 32; i++ )); do\n");
    c.print("        [ -f \"$d/Causticfile\" ] && { printf '%s\\n' \"$d/Causticfile\"; return 0; }\n");
    c.print("        [ \"$d\" = \"/\" ] && return 1\n");
    c.print("        d=\"${d%/*}\"; [ -z \"$d\" ] && d=/\n");
    c.print("    done\n");
    c.print("    return 1\n");
    c.print("}\n");
    c.print("\n");
    c.print("# $1 = targets | scripts | profiles, read out of the manifest itself. This is\n");
    c.print("# the fallback for a checkout with no built binary yet, and the answer whenever\n");
    c.print("# `caustic-mk list` cannot run.\n");
    c.print("_caustic_mk_from_file() {\n");
