    c.print("        copt=${COMP_WORDS[COMP_CWORD-2]}\n");
    c.print("    elif [[ $cur == -?*=* ]]; then\n");
    c.print("        copt=${cur%%=*}; cpfx=\"$copt=\"; cur=${cur#*=}\n");
